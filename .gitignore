# Lighthouse reports (build artifacts)
lh-*.json
lighthouse-*.json
lighthouse-a11y.json

# CURATED-SA-GEODATA-IMPORT-1 — large GeoNames source dumps
# (re-download anytime via Stage 1: node scripts/geodata/import_sa_geonames.mjs)
db/places/sources/*.zip
db/places/sources/*.txt

# CURATED-GEODATA-EUROPE-1A — large intermediate candidate JSONs that
# exceed GitHub's 100 MB hard limit (FR/GB only). These are regeneratable
# from the GeoNames source dumps via Stages 1-3. The persistent audit
# trail lives in `reports/{cc}-geodata-*.md` and the consolidated
# `db/places/candidates/europe-1a-arabic-quality.json` (high-tier summary,
# kept small).
db/places/candidates/fr-geonames-raw.json
db/places/candidates/fr-geonames-normalized.json
db/places/candidates/fr-geonames-candidates.json
db/places/candidates/gb-geonames-raw.json
db/places/candidates/gb-geonames-normalized.json
db/places/candidates/gb-geonames-candidates.json

# CURATED-GEODATA-EUROPE-2 — DE candidates is 120 MB (over GitHub 100 MB
# hard limit). IT candidates is 95 MB (over the 50 MB warn threshold).
# Both regeneratable from Stages 1-3. Persistent audit in reports/.
db/places/candidates/de-geonames-raw.json
db/places/candidates/de-geonames-normalized.json
db/places/candidates/de-geonames-candidates.json
db/places/candidates/it-geonames-raw.json
db/places/candidates/it-geonames-normalized.json
db/places/candidates/it-geonames-candidates.json

# CURATED-GEODATA-EUROPE-3 — PL candidates 72 MB + normalized 43 MB
# (over GitHub 50 MB warn threshold). Regeneratable from Stages 1-3.
db/places/candidates/pl-geonames-raw.json
db/places/candidates/pl-geonames-normalized.json
db/places/candidates/pl-geonames-candidates.json

# CURATED-GEODATA-AMERICAS-1A — US candidates 277 MB + normalized 170 MB
# + raw 100 MB. MX candidates 410 MB + normalized 250 MB + raw 156 MB.
# All vastly over GitHub 100 MB hard limit. Regeneratable from Stages 1-3.
db/places/candidates/us-geonames-raw.json
db/places/candidates/us-geonames-normalized.json
db/places/candidates/us-geonames-candidates.json
db/places/candidates/mx-geonames-raw.json
db/places/candidates/mx-geonames-normalized.json
db/places/candidates/mx-geonames-candidates.json
