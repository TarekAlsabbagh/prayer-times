        {
          "ayah": 1,
          "page": 531,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "ٱلرَّحۡمَٰنُ ﰀ",
          "textUthmaniBody": "ٱلرَّحۡمَٰنُ",
          "textImlaei": "الرحمن",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 531,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "عَلَّمَ ٱلۡقُرۡءَانَ ﰁ",
          "textUthmaniBody": "عَلَّمَ ٱلۡقُرۡءَانَ",
          "textImlaei": "علم القرآن",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 531,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "خَلَقَ ٱلۡإِنسَٰنَ ﰂ",
          "textUthmaniBody": "خَلَقَ ٱلۡإِنسَٰنَ",
          "textImlaei": "خلق الإنسان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 531,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "عَلَّمَهُ ٱلۡبَيَانَ ﰃ",
          "textUthmaniBody": "عَلَّمَهُ ٱلۡبَيَانَ",
          "textImlaei": "علمه البيان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 531,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانٖ ﰄ",
          "textUthmaniBody": "ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانٖ",
          "textImlaei": "الشمس والقمر بحسبان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 531,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ ﰅ",
          "textUthmaniBody": "وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ",
          "textImlaei": "والنجم والشجر يسجدان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 531,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ ﰆ",
          "textUthmaniBody": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ",
          "textImlaei": "والسماء رفعها ووضع الميزان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 531,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ ﰇ",
          "textUthmaniBody": "أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ",
          "textImlaei": "ألا تطغوا في الميزان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 531,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ ﰈ",
          "textUthmaniBody": "وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ",
          "textImlaei": "وأقيموا الوزن بالقسط ولا تخسروا الميزان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 531,
          "lineStart": 10,
          "lineEnd": 11,
          "textUthmaniRaw": "وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ ﰉ",
          "textUthmaniBody": "وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ",
          "textImlaei": "والأرض وضعها للأنام",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 531,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "فِيهَا فَٰكِهَةٞ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ ﰊ",
          "textUthmaniBody": "فِيهَا فَٰكِهَةٞ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ",
          "textImlaei": "فيها فاكهة والنخل ذات الأكمام",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 531,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ ﰋ",
          "textUthmaniBody": "وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ",
          "textImlaei": "والحب ذو العصف والريحان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 531,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰌ",
          "textUthmaniBody": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
          "textImlaei": "فبأي آلاء ربكما تكذبان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 531,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَٱلۡفَخَّارِ ﰍ",
          "textUthmaniBody": "خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلٖ كَٱلۡفَخَّارِ",
          "textImlaei": "خلق الإنسان من صلصال كالفخار",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 531,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجٖ مِّن نَّارٖ ﰎ",
          "textUthmaniBody": "وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجٖ مِّن نَّارٖ",
          "textImlaei": "وخلق الجان من مارج من نار",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 531,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰏ",
          "textUthmaniBody": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
          "textImlaei": "فبأي آلاء ربكما تكذبان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        },
        {
          "ayah": 17,
          "page": 531,
          "lineStart": 14,
          "lineEnd": 15,
          "textUthmaniRaw": "رَبُّ ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ ﰐ",
          "textUthmaniBody": "رَبُّ ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ",
          "textImlaei": "رب المشرقين ورب المغربين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        },
        {
          "ayah": 18,
          "page": 531,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰑ",
          "textUthmaniBody": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
          "textImlaei": "فبأي آلاء ربكما تكذبان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC11"
        }
      ]
    },
    {
      "page": 532,
      "juz": 27,
      "ayahs": [
        {
          "ayah": 19,
          "page": 532,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "مَرَجَ ٱلۡبَحۡرَيۡنِ يَلۡتَقِيَانِ ﰒ",
          "textUthmaniBody": "مَرَجَ ٱلۡبَحۡرَيۡنِ يَلۡتَقِيَانِ",
          "textImlaei": "مرج البحرين يلتقيان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC12"
        },
        {
          "ayah": 20,
          "page": 532,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "بَيۡنَهُمَا بَرۡزَخٞ لَّا يَبۡغِيَانِ ﰓ",
          "textUthmaniBody": "بَيۡنَهُمَا بَرۡزَخٞ لَّا يَبۡغِيَانِ",
          "textImlaei": "بينهما برزخ لا يبغيان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC13"
        },
        {
          "ayah": 21,
          "page": 532,
          "lineStart": 1,
          "lineEnd": 2,
          "textUthmaniRaw": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰔ",
          "textUthmaniBody": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
          "textImlaei": "فبأي آلاء ربكما تكذبان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC14"
        },
        {
          "ayah": 22,
          "page": 532,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "يَخۡرُجُ مِنۡهُمَا ٱللُّؤۡلُؤُ وَٱلۡمَرۡجَانُ ﰕ",
          "textUthmaniBody": "يَخۡرُجُ مِنۡهُمَا ٱللُّؤۡلُؤُ وَٱلۡمَرۡجَانُ",
          "textImlaei": "يخرج منهما اللؤلؤ والمرجان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC15"
        },
        {
          "ayah": 23,
          "page": 532,
          "lineStart": 2,
          "lineEnd": 3,
          "textUthmaniRaw": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰖ",
          "textUthmaniBody": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
          "textImlaei": "فبأي آلاء ربكما تكذبان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC16"
        },
        {
          "ayah": 24,
          "page": 532,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "وَلَهُ ٱلۡجَوَارِ ٱلۡمُنشَـَٔاتُ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ ﰗ",
          "textUthmaniBody": "وَلَهُ ٱلۡجَوَارِ ٱلۡمُنشَـَٔاتُ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ",
          "textImlaei": "وله الجوار المنشآت في البحر كالأعلام",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC17"
        },
        {
          "ayah": 25,
          "page": 532,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰘ",
          "textUthmaniBody": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
          "textImlaei": "فبأي آلاء ربكما تكذبان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC18"
        },
        {
          "ayah": 26,
          "page": 532,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "كُلُّ مَنۡ عَلَيۡهَا فَانٖ ﰙ",
          "textUthmaniBody": "كُلُّ مَنۡ عَلَيۡهَا فَانٖ",
          "textImlaei": "كل من عليها فان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC19"
        },
        {
          "ayah": 27,
          "page": 532,
          "lineStart": 4,
          "lineEnd": 5,
          "textUthmaniRaw": "وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ ﰚ",
          "textUthmaniBody": "وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ",
          "textImlaei": "ويبقى وجه ربك ذو الجلال والإكرام",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1A"
        },
        {
          "ayah": 28,
          "page": 532,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰛ",
          "textUthmaniBody": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
          "textImlaei": "فبأي آلاء ربكما تكذبان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1B"
        },
        {
          "ayah": 29,
          "page": 532,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "يَسۡـَٔلُهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنٖ ﰜ",
          "textUthmaniBody": "يَسۡـَٔلُهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنٖ",
          "textImlaei": "يسأله من في السموات والأرض كل يوم هو في شأن",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1C"
        },
        {
          "ayah": 30,
          "page": 532,
          "lineStart": 6,
          "lineEnd": 7,
          "textUthmaniRaw": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰝ",
          "textUthmaniBody": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
          "textImlaei": "فبأي آلاء ربكما تكذبان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1D"
        },
        {
          "ayah": 31,
          "page": 532,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "سَنَفۡرُغُ لَكُمۡ أَيُّهَ ٱلثَّقَلَانِ ﰞ",
          "textUthmaniBody": "سَنَفۡرُغُ لَكُمۡ أَيُّهَ ٱلثَّقَلَانِ",
          "textImlaei": "سنفرغ لكم أيها الثقلان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1E"
        },
        {
          "ayah": 32,
          "page": 532,
          "lineStart": 7,
          "lineEnd": 8,
          "textUthmaniRaw": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ﰟ",
          "textUthmaniBody": "فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
          "textImlaei": "فبأي آلاء ربكما تكذبان",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1F"
        },
        {
          "ayah": 33,
          "page": 532,
          "lineStart": 8,
          "lineEnd": 10,
          "textUthmaniRaw": "يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡطَارِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ فَٱنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنٖ ﰠ",
          "textUthmaniBody": "يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡطَارِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ فَٱنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنٖ",
          "textImlaei": "يامعشر الجن والإنس إن استطعتم أن تنفذوا من أقطار السموات والأرض فانفذوا لا تنفذون إلا بسلطان",
