  "pages": [
    {
      "page": 534,
      "juz": 27,
      "ayahs": [
        {
          "ayah": 1,
          "page": 534,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ ﰀ",
          "textUthmaniBody": "إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ",
          "textImlaei": "إذا وقعت الواقعة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 534,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ ﰁ",
          "textUthmaniBody": "لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ",
          "textImlaei": "ليس لوقعتها كاذبة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 534,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "خَافِضَةٞ رَّافِعَةٌ ﰂ",
          "textUthmaniBody": "خَافِضَةٞ رَّافِعَةٌ",
          "textImlaei": "خافضة رافعة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 534,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجّٗا ﰃ",
          "textUthmaniBody": "إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجّٗا",
          "textImlaei": "إذا رجت الأرض رجا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 534,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "وَبُسَّتِ ٱلۡجِبَالُ بَسّٗا ﰄ",
          "textUthmaniBody": "وَبُسَّتِ ٱلۡجِبَالُ بَسّٗا",
          "textImlaei": "وبست الجبال بسا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 534,
          "lineStart": 10,
          "lineEnd": 11,
          "textUthmaniRaw": "فَكَانَتۡ هَبَآءٗ مُّنۢبَثّٗا ﰅ",
          "textUthmaniBody": "فَكَانَتۡ هَبَآءٗ مُّنۢبَثّٗا",
          "textImlaei": "فكانت هباء منبثا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 534,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "وَكُنتُمۡ أَزۡوَٰجٗا ثَلَٰثَةٗ ﰆ",
          "textUthmaniBody": "وَكُنتُمۡ أَزۡوَٰجٗا ثَلَٰثَةٗ",
          "textImlaei": "وكنتم أزواجا ثلاثة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 534,
          "lineStart": 11,
          "lineEnd": 12,
          "textUthmaniRaw": "فَأَصۡحَٰبُ ٱلۡمَيۡمَنَةِ مَآ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ ﰇ",
          "textUthmaniBody": "فَأَصۡحَٰبُ ٱلۡمَيۡمَنَةِ مَآ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ",
          "textImlaei": "فأصحاب الميمنة ما أصحاب الميمنة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 534,
          "lineStart": 12,
          "lineEnd": 13,
          "textUthmaniRaw": "وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ مَآ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ ﰈ",
          "textUthmaniBody": "وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ مَآ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ",
          "textImlaei": "وأصحاب المشأمة ما أصحاب المشأمة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 534,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ ﰉ",
          "textUthmaniBody": "وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ",
          "textImlaei": "والسابقون السابقون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 534,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "أُوْلَٰٓئِكَ ٱلۡمُقَرَّبُونَ ﰊ",
          "textUthmaniBody": "أُوْلَٰٓئِكَ ٱلۡمُقَرَّبُونَ",
          "textImlaei": "أولئك المقربون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 534,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "فِي جَنَّٰتِ ٱلنَّعِيمِ ﰋ",
          "textUthmaniBody": "فِي جَنَّٰتِ ٱلنَّعِيمِ",
          "textImlaei": "في جنات النعيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 534,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ ﰌ",
          "textUthmaniBody": "ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ",
          "textImlaei": "ثلة من الأولين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 534,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "وَقَلِيلٞ مِّنَ ٱلۡأٓخِرِينَ ﰍ",
          "textUthmaniBody": "وَقَلِيلٞ مِّنَ ٱلۡأٓخِرِينَ",
          "textImlaei": "وقليل من الآخرين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 534,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "عَلَىٰ سُرُرٖ مَّوۡضُونَةٖ ﰎ",
          "textUthmaniBody": "عَلَىٰ سُرُرٖ مَّوۡضُونَةٖ",
          "textImlaei": "على سرر موضونة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 534,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ ﰏ",
          "textUthmaniBody": "مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ",
          "textImlaei": "متكئين عليها متقابلين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        }
      ]
    },
    {
      "page": 535,
      "juz": 27,
      "ayahs": [
        {
          "ayah": 17,
          "page": 535,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "يَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنٞ مُّخَلَّدُونَ ﰐ",
          "textUthmaniBody": "يَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنٞ مُّخَلَّدُونَ",
          "textImlaei": "يطوف عليهم ولدان مخلدون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        },
        {
          "ayah": 18,
          "page": 535,
          "lineStart": 1,
          "lineEnd": 2,
          "textUthmaniRaw": "بِأَكۡوَابٖ وَأَبَارِيقَ وَكَأۡسٖ مِّن مَّعِينٖ ﰑ",
          "textUthmaniBody": "بِأَكۡوَابٖ وَأَبَارِيقَ وَكَأۡسٖ مِّن مَّعِينٖ",
          "textImlaei": "بأكواب وأباريق وكأس من معين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC11"
        },
        {
          "ayah": 19,
          "page": 535,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزِفُونَ ﰒ",
          "textUthmaniBody": "لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزِفُونَ",
          "textImlaei": "لا يصدعون عنها ولا ينزفون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC12"
        },
        {
          "ayah": 20,
          "page": 535,
          "lineStart": 2,
          "lineEnd": 3,
          "textUthmaniRaw": "وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ ﰓ",
          "textUthmaniBody": "وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ",
          "textImlaei": "وفاكهة مما يتخيرون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC13"
        },
        {
          "ayah": 21,
          "page": 535,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "وَلَحۡمِ طَيۡرٖ مِّمَّا يَشۡتَهُونَ ﰔ",
          "textUthmaniBody": "وَلَحۡمِ طَيۡرٖ مِّمَّا يَشۡتَهُونَ",
          "textImlaei": "ولحم طير مما يشتهون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC14"
        },
        {
          "ayah": 22,
          "page": 535,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "وَحُورٌ عِينٞ ﰕ",
          "textUthmaniBody": "وَحُورٌ عِينٞ",
          "textImlaei": "وحور عين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC15"
        },
        {
          "ayah": 23,
          "page": 535,
          "lineStart": 3,
          "lineEnd": 4,
          "textUthmaniRaw": "كَأَمۡثَٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ ﰖ",
          "textUthmaniBody": "كَأَمۡثَٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ",
          "textImlaei": "كأمثال اللؤلؤ المكنون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC16"
        },
        {
          "ayah": 24,
          "page": 535,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ ﰗ",
          "textUthmaniBody": "جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ",
          "textImlaei": "جزاء بما كانوا يعملون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC17"
        },
        {
          "ayah": 25,
          "page": 535,
          "lineStart": 4,
          "lineEnd": 5,
          "textUthmaniRaw": "لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا تَأۡثِيمًا ﰘ",
          "textUthmaniBody": "لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا تَأۡثِيمًا",
          "textImlaei": "لا يسمعون فيها لغوا ولا تأثيما",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC18"
        },
        {
          "ayah": 26,
          "page": 535,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "إِلَّا قِيلٗا سَلَٰمٗا سَلَٰمٗا ﰙ",
          "textUthmaniBody": "إِلَّا قِيلٗا سَلَٰمٗا سَلَٰمٗا",
          "textImlaei": "إلا قيلا سلاما سلاما",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC19"
        },
        {
          "ayah": 27,
          "page": 535,
          "lineStart": 5,
          "lineEnd": 6,
          "textUthmaniRaw": "وَأَصۡحَٰبُ ٱلۡيَمِينِ مَآ أَصۡحَٰبُ ٱلۡيَمِينِ ﰚ",
          "textUthmaniBody": "وَأَصۡحَٰبُ ٱلۡيَمِينِ مَآ أَصۡحَٰبُ ٱلۡيَمِينِ",
          "textImlaei": "وأصحاب اليمين ما أصحاب اليمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1A"
        },
        {
          "ayah": 28,
          "page": 535,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "فِي سِدۡرٖ مَّخۡضُودٖ ﰛ",
          "textUthmaniBody": "فِي سِدۡرٖ مَّخۡضُودٖ",
          "textImlaei": "في سدر مخضود",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1B"
        },
        {
          "ayah": 29,
          "page": 535,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "وَطَلۡحٖ مَّنضُودٖ ﰜ",
          "textUthmaniBody": "وَطَلۡحٖ مَّنضُودٖ",
          "textImlaei": "وطلح منضود",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1C"
        },
        {
          "ayah": 30,
          "page": 535,
          "lineStart": 6,
          "lineEnd": 7,
          "textUthmaniRaw": "وَظِلّٖ مَّمۡدُودٖ ﰝ",
          "textUthmaniBody": "وَظِلّٖ مَّمۡدُودٖ",
          "textImlaei": "وظل ممدود",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1D"
        },
        {
          "ayah": 31,
          "page": 535,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "وَمَآءٖ مَّسۡكُوبٖ ﰞ",
          "textUthmaniBody": "وَمَآءٖ مَّسۡكُوبٖ",
          "textImlaei": "وماء مسكوب",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1E"
        },
        {
          "ayah": 32,
          "page": 535,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "وَفَٰكِهَةٖ كَثِيرَةٖ ﰟ",
          "textUthmaniBody": "وَفَٰكِهَةٖ كَثِيرَةٖ",
          "textImlaei": "وفاكهة كثيرة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1F"
        },
        {
          "ayah": 33,
          "page": 535,
          "lineStart": 7,
          "lineEnd": 8,
          "textUthmaniRaw": "لَّا مَقۡطُوعَةٖ وَلَا مَمۡنُوعَةٖ ﰠ",
          "textUthmaniBody": "لَّا مَقۡطُوعَةٖ وَلَا مَمۡنُوعَةٖ",
          "textImlaei": "لا مقطوعة ولا ممنوعة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC20"
        },
        {
          "ayah": 34,
          "page": 535,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "وَفُرُشٖ مَّرۡفُوعَةٍ ﰡ",
          "textUthmaniBody": "وَفُرُشٖ مَّرۡفُوعَةٍ",
          "textImlaei": "وفرش مرفوعة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC21"
        },
        {
          "ayah": 35,
          "page": 535,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "إِنَّآ أَنشَأۡنَٰهُنَّ إِنشَآءٗ ﰢ",
          "textUthmaniBody": "إِنَّآ أَنشَأۡنَٰهُنَّ إِنشَآءٗ",
          "textImlaei": "إنا أنشأناهن إنشاء",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC22"
        },
        {
          "ayah": 36,
          "page": 535,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "فَجَعَلۡنَٰهُنَّ أَبۡكَارًا ﰣ",
          "textUthmaniBody": "فَجَعَلۡنَٰهُنَّ أَبۡكَارًا",
          "textImlaei": "فجعلناهن أبكارا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC23"
        },
        {
          "ayah": 37,
          "page": 535,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "عُرُبًا أَتۡرَابٗا ﰤ",
          "textUthmaniBody": "عُرُبًا أَتۡرَابٗا",
          "textImlaei": "عربا أترابا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC24"
        },
        {
          "ayah": 38,
          "page": 535,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "لِّأَصۡحَٰبِ ٱلۡيَمِينِ ﰥ",
          "textUthmaniBody": "لِّأَصۡحَٰبِ ٱلۡيَمِينِ",
          "textImlaei": "لأصحاب اليمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC25"
        },
        {
          "ayah": 39,
          "page": 535,
          "lineStart": 9,
          "lineEnd": 10,
          "textUthmaniRaw": "ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ ﰦ",
          "textUthmaniBody": "ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ",
          "textImlaei": "ثلة من الأولين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC26"
        },
        {
          "ayah": 40,
          "page": 535,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "وَثُلَّةٞ مِّنَ ٱلۡأٓخِرِينَ ﰧ",
          "textUthmaniBody": "وَثُلَّةٞ مِّنَ ٱلۡأٓخِرِينَ",
          "textImlaei": "وثلة من الآخرين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC27"
        },
        {
          "ayah": 41,
          "page": 535,
          "lineStart": 10,
          "lineEnd": 11,
          "textUthmaniRaw": "وَأَصۡحَٰبُ ٱلشِّمَالِ مَآ أَصۡحَٰبُ ٱلشِّمَالِ ﰨ",
          "textUthmaniBody": "وَأَصۡحَٰبُ ٱلشِّمَالِ مَآ أَصۡحَٰبُ ٱلشِّمَالِ",
          "textImlaei": "وأصحاب الشمال ما أصحاب الشمال",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC28"
        },
        {
          "ayah": 42,
          "page": 535,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "فِي سَمُومٖ وَحَمِيمٖ ﰩ",
          "textUthmaniBody": "فِي سَمُومٖ وَحَمِيمٖ",
          "textImlaei": "في سموم وحميم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC29"
        },
        {
          "ayah": 43,
          "page": 535,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "وَظِلّٖ مِّن يَحۡمُومٖ ﰪ",
          "textUthmaniBody": "وَظِلّٖ مِّن يَحۡمُومٖ",
          "textImlaei": "وظل من يحموم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2A"
        },
        {
          "ayah": 44,
          "page": 535,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "لَّا بَارِدٖ وَلَا كَرِيمٍ ﰫ",
          "textUthmaniBody": "لَّا بَارِدٖ وَلَا كَرِيمٍ",
          "textImlaei": "لا بارد ولا كريم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2B"
        },
        {
          "ayah": 45,
          "page": 535,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "إِنَّهُمۡ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ ﰬ",
          "textUthmaniBody": "إِنَّهُمۡ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ",
          "textImlaei": "إنهم كانوا قبل ذلك مترفين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2C"
        },
        {
          "ayah": 46,
          "page": 535,
          "lineStart": 12,
          "lineEnd": 13,
          "textUthmaniRaw": "وَكَانُواْ يُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِيمِ ﰭ",
          "textUthmaniBody": "وَكَانُواْ يُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِيمِ",
          "textImlaei": "وكانوا يصرون على الحنث العظيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2D"
        },
        {
          "ayah": 47,
          "page": 535,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "وَكَانُواْ يَقُولُونَ أَئِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ ﰮ",
          "textUthmaniBody": "وَكَانُواْ يَقُولُونَ أَئِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ",
          "textImlaei": "وكانوا يقولون أئذا متنا وكنا ترابا وعظاما أئنا لمبعوثون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2E"
        },
        {
          "ayah": 48,
          "page": 535,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ ﰯ",
          "textUthmaniBody": "أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ",
          "textImlaei": "أو آباؤنا الأولون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2F"
        },
        {
          "ayah": 49,
          "page": 535,
          "lineStart": 14,
          "lineEnd": 15,
          "textUthmaniRaw": "قُلۡ إِنَّ ٱلۡأَوَّلِينَ وَٱلۡأٓخِرِينَ ﰰ",
          "textUthmaniBody": "قُلۡ إِنَّ ٱلۡأَوَّلِينَ وَٱلۡأٓخِرِينَ",
          "textImlaei": "قل إن الأولين والآخرين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC30"
        },
        {
          "ayah": 50,
          "page": 535,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ ﰱ",
          "textUthmaniBody": "لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ",
          "textImlaei": "لمجموعون إلى ميقات يوم معلوم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC31"
        }
      ]
    },
    {
      "page": 536,
      "juz": 27,
      "ayahs": [
        {
          "ayah": 51,
          "page": 536,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ ﰲ",
          "textUthmaniBody": "ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ",
          "textImlaei": "ثم إنكم أيها الضالون المكذبون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC32"
        },
        {
          "ayah": 52,
          "page": 536,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ ﰳ",
          "textUthmaniBody": "لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ",
          "textImlaei": "لآكلون من شجر من زقوم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC33"
        },
        {
          "ayah": 53,
          "page": 536,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ ﰴ",
          "textUthmaniBody": "فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ",
          "textImlaei": "فمالئون منها البطون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC34"
        },
        {
          "ayah": 54,
          "page": 536,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "فَشَٰرِبُونَ عَلَيۡهِ مِنَ ٱلۡحَمِيمِ ﰵ",
          "textUthmaniBody": "فَشَٰرِبُونَ عَلَيۡهِ مِنَ ٱلۡحَمِيمِ",
          "textImlaei": "فشاربون عليه من الحميم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC35"
        },
        {
          "ayah": 55,
          "page": 536,
          "lineStart": 2,
          "lineEnd": 3,
          "textUthmaniRaw": "فَشَٰرِبُونَ شُرۡبَ ٱلۡهِيمِ ﰶ",
          "textUthmaniBody": "فَشَٰرِبُونَ شُرۡبَ ٱلۡهِيمِ",
          "textImlaei": "فشاربون شرب الهيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC36"
        },
        {
          "ayah": 56,
          "page": 536,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "هَٰذَا نُزُلُهُمۡ يَوۡمَ ٱلدِّينِ ﰷ",
          "textUthmaniBody": "هَٰذَا نُزُلُهُمۡ يَوۡمَ ٱلدِّينِ",
          "textImlaei": "هذا نزلهم يوم الدين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC37"
        },
        {
          "ayah": 57,
          "page": 536,
          "lineStart": 3,
          "lineEnd": 4,
          "textUthmaniRaw": "نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ ﰸ",
          "textUthmaniBody": "نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ",
          "textImlaei": "نحن خلقناكم فلولا تصدقون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC38"
        },
        {
          "ayah": 58,
          "page": 536,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "أَفَرَءَيۡتُم مَّا تُمۡنُونَ ﰹ",
          "textUthmaniBody": "أَفَرَءَيۡتُم مَّا تُمۡنُونَ",
          "textImlaei": "أفرأيتم ما تمنون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC39"
        },
        {
          "ayah": 59,
          "page": 536,
          "lineStart": 4,
          "lineEnd": 5,
          "textUthmaniRaw": "ءَأَنتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ ﰺ",
          "textUthmaniBody": "ءَأَنتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ",
          "textImlaei": "أأنتم تخلقونه أم نحن الخالقون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC3A"
        },
        {
          "ayah": 60,
          "page": 536,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ ﰻ",
          "textUthmaniBody": "نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ",
          "textImlaei": "نحن قدرنا بينكم الموت وما نحن بمسبوقين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC3B"
        },
        {
          "ayah": 61,
          "page": 536,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ ﰼ",
          "textUthmaniBody": "عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ",
          "textImlaei": "على أن نبدل أمثالكم وننشئكم في ما لا تعلمون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC3C"
        },
        {
          "ayah": 62,
          "page": 536,
          "lineStart": 6,
          "lineEnd": 7,
          "textUthmaniRaw": "وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ ﰽ",
          "textUthmaniBody": "وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ",
          "textImlaei": "ولقد علمتم النشأة الأولى فلولا تذكرون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC3D"
        },
        {
          "ayah": 63,
          "page": 536,
          "lineStart": 7,
          "lineEnd": 8,
          "textUthmaniRaw": "أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ ﰾ",
          "textUthmaniBody": "أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ",
          "textImlaei": "أفرأيتم ما تحرثون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC3E"
        },
        {
          "ayah": 64,
          "page": 536,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "ءَأَنتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ ٱلزَّٰرِعُونَ ﰿ",
          "textUthmaniBody": "ءَأَنتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ ٱلزَّٰرِعُونَ",
          "textImlaei": "أأنتم تزرعونه أم نحن الزارعون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC3F"
        },
        {
          "ayah": 65,
          "page": 536,
          "lineStart": 8,
          "lineEnd": 9,
          "textUthmaniRaw": "لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمٗا فَظَلۡتُمۡ تَفَكَّهُونَ ﱀ",
          "textUthmaniBody": "لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمٗا فَظَلۡتُمۡ تَفَكَّهُونَ",
          "textImlaei": "لو نشاء لجعلناه حطاما فظلتم تفكهون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC40"
        },
        {
          "ayah": 66,
          "page": 536,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "إِنَّا لَمُغۡرَمُونَ ﱁ",
          "textUthmaniBody": "إِنَّا لَمُغۡرَمُونَ",
          "textImlaei": "إنا لمغرمون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC41"
        },
        {
          "ayah": 67,
          "page": 536,
          "lineStart": 9,
          "lineEnd": 10,
          "textUthmaniRaw": "بَلۡ نَحۡنُ مَحۡرُومُونَ ﱂ",
          "textUthmaniBody": "بَلۡ نَحۡنُ مَحۡرُومُونَ",
          "textImlaei": "بل نحن محرومون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC42"
        },
        {
          "ayah": 68,
          "page": 536,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ ﱃ",
          "textUthmaniBody": "أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ",
          "textImlaei": "أفرأيتم الماء الذي تشربون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC43"
        },
        {
          "ayah": 69,
          "page": 536,
          "lineStart": 10,
          "lineEnd": 11,
          "textUthmaniRaw": "ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ ﱄ",
          "textUthmaniBody": "ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ",
          "textImlaei": "أأنتم أنزلتموه من المزن أم نحن المنزلون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC44"
        },
        {
          "ayah": 70,
          "page": 536,
          "lineStart": 11,
          "lineEnd": 12,
          "textUthmaniRaw": "لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ ﱅ",
          "textUthmaniBody": "لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ",
          "textImlaei": "لو نشاء جعلناه أجاجا فلولا تشكرون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC45"
        },
        {
          "ayah": 71,
          "page": 536,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ ﱆ",
          "textUthmaniBody": "أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ",
          "textImlaei": "أفرأيتم النار التي تورون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC46"
        },
        {
          "ayah": 72,
          "page": 536,
          "lineStart": 12,
          "lineEnd": 13,
          "textUthmaniRaw": "ءَأَنتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ ﱇ",
          "textUthmaniBody": "ءَأَنتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ",
          "textImlaei": "أأنتم أنشأتم شجرتها أم نحن المنشئون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC47"
        },
        {
          "ayah": 73,
          "page": 536,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ ﱈ",
          "textUthmaniBody": "نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ",
          "textImlaei": "نحن جعلناها تذكرة ومتاعا للمقوين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC48"
        },
        {
          "ayah": 74,
          "page": 536,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ﱉ",
          "textUthmaniBody": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ",
          "textImlaei": "فسبح باسم ربك العظيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC49"
        },
        {
          "ayah": 75,
          "page": 536,
          "lineStart": 14,
          "lineEnd": 15,
          "textUthmaniRaw": "۞ فَلَآ أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ ﱊ",
          "textUthmaniBody": "۞ فَلَآ أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ",
          "textImlaei": "فلا أقسم بمواقع النجوم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC4A"
        },
        {
          "ayah": 76,
          "page": 536,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ ﱋ",
          "textUthmaniBody": "وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ",
          "textImlaei": "وإنه لقسم لو تعلمون عظيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC4B"
        }
      ]
    },
    {
      "page": 537,
      "juz": 27,
      "ayahs": [
        {
          "ayah": 77,
          "page": 537,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "إِنَّهُۥ لَقُرۡءَانٞ كَرِيمٞ ﱌ",
          "textUthmaniBody": "إِنَّهُۥ لَقُرۡءَانٞ كَرِيمٞ",
          "textImlaei": "إنه لقرآن كريم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC4C"
        },
        {
          "ayah": 78,
          "page": 537,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "فِي كِتَٰبٖ مَّكۡنُونٖ ﱍ",
          "textUthmaniBody": "فِي كِتَٰبٖ مَّكۡنُونٖ",
          "textImlaei": "في كتاب مكنون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC4D"
        },
        {
          "ayah": 79,
          "page": 537,
          "lineStart": 1,
          "lineEnd": 2,
          "textUthmaniRaw": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلۡمُطَهَّرُونَ ﱎ",
          "textUthmaniBody": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلۡمُطَهَّرُونَ",
          "textImlaei": "لا يمسه إلا المطهرون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC4E"
        },
        {
          "ayah": 80,
          "page": 537,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ ﱏ",
          "textUthmaniBody": "تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ",
          "textImlaei": "تنزيل من رب العالمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC4F"
        },
        {
          "ayah": 81,
          "page": 537,
          "lineStart": 2,
          "lineEnd": 3,
          "textUthmaniRaw": "أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُم مُّدۡهِنُونَ ﱐ",
          "textUthmaniBody": "أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُم مُّدۡهِنُونَ",
          "textImlaei": "أفبهذا الحديث أنتم مدهنون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC50"
        },
        {
          "ayah": 82,
          "page": 537,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ ﱑ",
          "textUthmaniBody": "وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ",
          "textImlaei": "وتجعلون رزقكم أنكم تكذبون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC51"
        },
        {
          "ayah": 83,
          "page": 537,
          "lineStart": 3,
          "lineEnd": 4,
          "textUthmaniRaw": "فَلَوۡلَآ إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ ﱒ",
          "textUthmaniBody": "فَلَوۡلَآ إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ",
          "textImlaei": "فلولا إذا بلغت الحلقوم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC52"
        },
        {
          "ayah": 84,
          "page": 537,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "وَأَنتُمۡ حِينَئِذٖ تَنظُرُونَ ﱓ",
          "textUthmaniBody": "وَأَنتُمۡ حِينَئِذٖ تَنظُرُونَ",
          "textImlaei": "وأنتم حينئذ تنظرون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC53"
        },
        {
          "ayah": 85,
          "page": 537,
          "lineStart": 4,
          "lineEnd": 5,
          "textUthmaniRaw": "وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ وَلَٰكِن لَّا تُبۡصِرُونَ ﱔ",
          "textUthmaniBody": "وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ وَلَٰكِن لَّا تُبۡصِرُونَ",
          "textImlaei": "ونحن أقرب إليه منكم ولكن لا تبصرون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC54"
        },
        {
          "ayah": 86,
          "page": 537,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "فَلَوۡلَآ إِن كُنتُمۡ غَيۡرَ مَدِينِينَ ﱕ",
          "textUthmaniBody": "فَلَوۡلَآ إِن كُنتُمۡ غَيۡرَ مَدِينِينَ",
          "textImlaei": "فلولا إن كنتم غير مدينين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC55"
        },
        {
          "ayah": 87,
          "page": 537,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "تَرۡجِعُونَهَآ إِن كُنتُمۡ صَٰدِقِينَ ﱖ",
          "textUthmaniBody": "تَرۡجِعُونَهَآ إِن كُنتُمۡ صَٰدِقِينَ",
          "textImlaei": "ترجعونها إن كنتم صادقين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC56"
        },
        {
          "ayah": 88,
          "page": 537,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "فَأَمَّآ إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ ﱗ",
          "textUthmaniBody": "فَأَمَّآ إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ",
          "textImlaei": "فأما إن كان من المقربين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC57"
        },
        {
          "ayah": 89,
          "page": 537,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "فَرَوۡحٞ وَرَيۡحَانٞ وَجَنَّتُ نَعِيمٖ ﱘ",
          "textUthmaniBody": "فَرَوۡحٞ وَرَيۡحَانٞ وَجَنَّتُ نَعِيمٖ",
          "textImlaei": "فروح وريحان وجنة نعيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC58"
        },
        {
          "ayah": 90,
          "page": 537,
          "lineStart": 7,
          "lineEnd": 8,
          "textUthmaniRaw": "وَأَمَّآ إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ ﱙ",
          "textUthmaniBody": "وَأَمَّآ إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ",
          "textImlaei": "وأما إن كان من أصحاب اليمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC59"
        },
        {
          "ayah": 91,
          "page": 537,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "فَسَلَٰمٞ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ ﱚ",
          "textUthmaniBody": "فَسَلَٰمٞ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ",
          "textImlaei": "فسلام لك من أصحاب اليمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC5A"
        },
        {
          "ayah": 92,
          "page": 537,
          "lineStart": 8,
          "lineEnd": 9,
          "textUthmaniRaw": "وَأَمَّآ إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ ﱛ",
          "textUthmaniBody": "وَأَمَّآ إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ",
          "textImlaei": "وأما إن كان من المكذبين الضالين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC5B"
        },
        {
          "ayah": 93,
          "page": 537,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "فَنُزُلٞ مِّنۡ حَمِيمٖ ﱜ",
          "textUthmaniBody": "فَنُزُلٞ مِّنۡ حَمِيمٖ",
          "textImlaei": "فنزل من حميم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC5C"
        },
        {
          "ayah": 94,
          "page": 537,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "وَتَصۡلِيَةُ جَحِيمٍ ﱝ",
          "textUthmaniBody": "وَتَصۡلِيَةُ جَحِيمٍ",
          "textImlaei": "وتصلية جحيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC5D"
        },
        {
          "ayah": 95,
          "page": 537,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ ﱞ",
          "textUthmaniBody": "إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ",
          "textImlaei": "إن هذا لهو حق اليقين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC5E"
        },
        {
          "ayah": 96,
          "page": 537,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ﱟ",
          "textUthmaniBody": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ",
          "textImlaei": "فسبح باسم ربك العظيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC5F"
        }
      ]
    }
  ]
}
