  "basmalaMode": "separate",
  "pages": [
    {
      "page": 564,
      "juz": 29,
      "ayahs": [
        {
          "ayah": 1,
          "page": 564,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "نٓۚ وَٱلۡقَلَمِ وَمَا يَسۡطُرُونَ ﰀ",
          "textUthmaniBody": "نٓۚ وَٱلۡقَلَمِ وَمَا يَسۡطُرُونَ",
          "textImlaei": "ن والقلم وما يسطرون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 564,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "مَآ أَنتَ بِنِعۡمَةِ رَبِّكَ بِمَجۡنُونٖ ﰁ",
          "textUthmaniBody": "مَآ أَنتَ بِنِعۡمَةِ رَبِّكَ بِمَجۡنُونٖ",
          "textImlaei": "ما أنت بنعمة ربك بمجنون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 564,
          "lineStart": 8,
          "lineEnd": 9,
          "textUthmaniRaw": "وَإِنَّ لَكَ لَأَجۡرًا غَيۡرَ مَمۡنُونٖ ﰂ",
          "textUthmaniBody": "وَإِنَّ لَكَ لَأَجۡرًا غَيۡرَ مَمۡنُونٖ",
          "textImlaei": "وإن لك لأجرا غير ممنون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 564,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٖ ﰃ",
          "textUthmaniBody": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٖ",
          "textImlaei": "وإنك لعلى خلق عظيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 564,
          "lineStart": 9,
          "lineEnd": 10,
          "textUthmaniRaw": "فَسَتُبۡصِرُ وَيُبۡصِرُونَ ﰄ",
          "textUthmaniBody": "فَسَتُبۡصِرُ وَيُبۡصِرُونَ",
          "textImlaei": "فستبصر ويبصرون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 564,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "بِأَييِّكُمُ ٱلۡمَفۡتُونُ ﰅ",
          "textUthmaniBody": "بِأَييِّكُمُ ٱلۡمَفۡتُونُ",
          "textImlaei": "بأيكم المفتون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 564,
          "lineStart": 10,
          "lineEnd": 11,
          "textUthmaniRaw": "إِنَّ رَبَّكَ هُوَ أَعۡلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعۡلَمُ بِٱلۡمُهۡتَدِينَ ﰆ",
          "textUthmaniBody": "إِنَّ رَبَّكَ هُوَ أَعۡلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعۡلَمُ بِٱلۡمُهۡتَدِينَ",
          "textImlaei": "إن ربك هو أعلم بمن ضل عن سبيله وهو أعلم بالمهتدين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 564,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "فَلَا تُطِعِ ٱلۡمُكَذِّبِينَ ﰇ",
          "textUthmaniBody": "فَلَا تُطِعِ ٱلۡمُكَذِّبِينَ",
          "textImlaei": "فلا تطع المكذبين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 564,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَدُّواْ لَوۡ تُدۡهِنُ فَيُدۡهِنُونَ ﰈ",
          "textUthmaniBody": "وَدُّواْ لَوۡ تُدۡهِنُ فَيُدۡهِنُونَ",
          "textImlaei": "ودوا لو تدهن فيدهنون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 564,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَلَا تُطِعۡ كُلَّ حَلَّافٖ مَّهِينٍ ﰉ",
          "textUthmaniBody": "وَلَا تُطِعۡ كُلَّ حَلَّافٖ مَّهِينٍ",
          "textImlaei": "ولا تطع كل حلاف مهين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 564,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "هَمَّازٖ مَّشَّآءِۭ بِنَمِيمٖ ﰊ",
          "textUthmaniBody": "هَمَّازٖ مَّشَّآءِۭ بِنَمِيمٖ",
          "textImlaei": "هماز مشاء بنميم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 564,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "مَّنَّاعٖ لِّلۡخَيۡرِ مُعۡتَدٍ أَثِيمٍ ﰋ",
          "textUthmaniBody": "مَّنَّاعٖ لِّلۡخَيۡرِ مُعۡتَدٍ أَثِيمٍ",
          "textImlaei": "مناع للخير معتد أثيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 564,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "عُتُلِّۭ بَعۡدَ ذَٰلِكَ زَنِيمٍ ﰌ",
          "textUthmaniBody": "عُتُلِّۭ بَعۡدَ ذَٰلِكَ زَنِيمٍ",
          "textImlaei": "عتل بعد ذلك زنيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 564,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "أَن كَانَ ذَا مَالٖ وَبَنِينَ ﰍ",
          "textUthmaniBody": "أَن كَانَ ذَا مَالٖ وَبَنِينَ",
          "textImlaei": "أن كان ذا مال وبنين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 564,
          "lineStart": 14,
          "lineEnd": 15,
          "textUthmaniRaw": "إِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلۡأَوَّلِينَ ﰎ",
          "textUthmaniBody": "إِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلۡأَوَّلِينَ",
          "textImlaei": "إذا تتلى عليه آياتنا قال أساطير الأولين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 564,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "سَنَسِمُهُۥ عَلَى ٱلۡخُرۡطُومِ ﰏ",
          "textUthmaniBody": "سَنَسِمُهُۥ عَلَى ٱلۡخُرۡطُومِ",
          "textImlaei": "سنسمه على الخرطوم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        }
      ]
    },
    {
      "page": 565,
      "juz": 29,
      "ayahs": [
        {
          "ayah": 17,
          "page": 565,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "إِنَّا بَلَوۡنَٰهُمۡ كَمَا بَلَوۡنَآ أَصۡحَٰبَ ٱلۡجَنَّةِ إِذۡ أَقۡسَمُواْ لَيَصۡرِمُنَّهَا مُصۡبِحِينَ ﰐ",
          "textUthmaniBody": "إِنَّا بَلَوۡنَٰهُمۡ كَمَا بَلَوۡنَآ أَصۡحَٰبَ ٱلۡجَنَّةِ إِذۡ أَقۡسَمُواْ لَيَصۡرِمُنَّهَا مُصۡبِحِينَ",
          "textImlaei": "إنا بلوناهم كما بلونا أصحاب الجنة إذ أقسموا ليصرمنها مصبحين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        },
        {
          "ayah": 18,
          "page": 565,
          "lineStart": 1,
          "lineEnd": 2,
          "textUthmaniRaw": "وَلَا يَسۡتَثۡنُونَ ﰑ",
          "textUthmaniBody": "وَلَا يَسۡتَثۡنُونَ",
          "textImlaei": "ولا يستثنون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC11"
        },
        {
          "ayah": 19,
          "page": 565,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "فَطَافَ عَلَيۡهَا طَآئِفٞ مِّن رَّبِّكَ وَهُمۡ نَآئِمُونَ ﰒ",
          "textUthmaniBody": "فَطَافَ عَلَيۡهَا طَآئِفٞ مِّن رَّبِّكَ وَهُمۡ نَآئِمُونَ",
          "textImlaei": "فطاف عليها طائف من ربك وهم نائمون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC12"
        },
        {
          "ayah": 20,
          "page": 565,
          "lineStart": 2,
          "lineEnd": 3,
          "textUthmaniRaw": "فَأَصۡبَحَتۡ كَٱلصَّرِيمِ ﰓ",
          "textUthmaniBody": "فَأَصۡبَحَتۡ كَٱلصَّرِيمِ",
          "textImlaei": "فأصبحت كالصريم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC13"
        },
        {
          "ayah": 21,
          "page": 565,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "فَتَنَادَوۡاْ مُصۡبِحِينَ ﰔ",
          "textUthmaniBody": "فَتَنَادَوۡاْ مُصۡبِحِينَ",
          "textImlaei": "فتنادوا مصبحين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC14"
        },
        {
          "ayah": 22,
          "page": 565,
          "lineStart": 3,
          "lineEnd": 4,
          "textUthmaniRaw": "أَنِ ٱغۡدُواْ عَلَىٰ حَرۡثِكُمۡ إِن كُنتُمۡ صَٰرِمِينَ ﰕ",
          "textUthmaniBody": "أَنِ ٱغۡدُواْ عَلَىٰ حَرۡثِكُمۡ إِن كُنتُمۡ صَٰرِمِينَ",
          "textImlaei": "أن اغدوا على حرثكم إن كنتم صارمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC15"
        },
        {
          "ayah": 23,
          "page": 565,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "فَٱنطَلَقُواْ وَهُمۡ يَتَخَٰفَتُونَ ﰖ",
          "textUthmaniBody": "فَٱنطَلَقُواْ وَهُمۡ يَتَخَٰفَتُونَ",
          "textImlaei": "فانطلقوا وهم يتخافتون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC16"
        },
        {
          "ayah": 24,
          "page": 565,
          "lineStart": 4,
          "lineEnd": 5,
          "textUthmaniRaw": "أَن لَّا يَدۡخُلَنَّهَا ٱلۡيَوۡمَ عَلَيۡكُم مِّسۡكِينٞ ﰗ",
          "textUthmaniBody": "أَن لَّا يَدۡخُلَنَّهَا ٱلۡيَوۡمَ عَلَيۡكُم مِّسۡكِينٞ",
          "textImlaei": "أن لا يدخلنها اليوم عليكم مسكين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC17"
        },
        {
          "ayah": 25,
          "page": 565,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَغَدَوۡاْ عَلَىٰ حَرۡدٖ قَٰدِرِينَ ﰘ",
          "textUthmaniBody": "وَغَدَوۡاْ عَلَىٰ حَرۡدٖ قَٰدِرِينَ",
          "textImlaei": "وغدوا على حرد قادرين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC18"
        },
        {
          "ayah": 26,
          "page": 565,
          "lineStart": 5,
          "lineEnd": 6,
          "textUthmaniRaw": "فَلَمَّا رَأَوۡهَا قَالُوٓاْ إِنَّا لَضَآلُّونَ ﰙ",
          "textUthmaniBody": "فَلَمَّا رَأَوۡهَا قَالُوٓاْ إِنَّا لَضَآلُّونَ",
          "textImlaei": "فلما رأوها قالوا إنا لضالون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC19"
        },
        {
          "ayah": 27,
          "page": 565,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "بَلۡ نَحۡنُ مَحۡرُومُونَ ﰚ",
          "textUthmaniBody": "بَلۡ نَحۡنُ مَحۡرُومُونَ",
          "textImlaei": "بل نحن محرومون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1A"
        },
        {
          "ayah": 28,
          "page": 565,
          "lineStart": 6,
          "lineEnd": 7,
          "textUthmaniRaw": "قَالَ أَوۡسَطُهُمۡ أَلَمۡ أَقُل لَّكُمۡ لَوۡلَا تُسَبِّحُونَ ﰛ",
          "textUthmaniBody": "قَالَ أَوۡسَطُهُمۡ أَلَمۡ أَقُل لَّكُمۡ لَوۡلَا تُسَبِّحُونَ",
          "textImlaei": "قال أوسطهم ألم أقل لكم لولا تسبحون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1B"
        },
        {
          "ayah": 29,
          "page": 565,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "قَالُواْ سُبۡحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ ﰜ",
          "textUthmaniBody": "قَالُواْ سُبۡحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ",
          "textImlaei": "قالوا سبحان ربنا إنا كنا ظالمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1C"
        },
        {
          "ayah": 30,
          "page": 565,
          "lineStart": 7,
          "lineEnd": 8,
          "textUthmaniRaw": "فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَلَٰوَمُونَ ﰝ",
          "textUthmaniBody": "فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَلَٰوَمُونَ",
          "textImlaei": "فأقبل بعضهم على بعض يتلاومون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1D"
        },
        {
          "ayah": 31,
          "page": 565,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "قَالُواْ يَٰوَيۡلَنَآ إِنَّا كُنَّا طَٰغِينَ ﰞ",
          "textUthmaniBody": "قَالُواْ يَٰوَيۡلَنَآ إِنَّا كُنَّا طَٰغِينَ",
          "textImlaei": "قالوا ياويلنا إنا كنا طاغين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1E"
        },
        {
          "ayah": 32,
          "page": 565,
          "lineStart": 8,
          "lineEnd": 9,
          "textUthmaniRaw": "عَسَىٰ رَبُّنَآ أَن يُبۡدِلَنَا خَيۡرٗا مِّنۡهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ ﰟ",
          "textUthmaniBody": "عَسَىٰ رَبُّنَآ أَن يُبۡدِلَنَا خَيۡرٗا مِّنۡهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ",
          "textImlaei": "عسى ربنا أن يبدلنا خيرا منها إنا إلى ربنا راغبون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1F"
        },
        {
          "ayah": 33,
          "page": 565,
          "lineStart": 9,
          "lineEnd": 10,
          "textUthmaniRaw": "كَذَٰلِكَ ٱلۡعَذَابُۖ وَلَعَذَابُ ٱلۡأٓخِرَةِ أَكۡبَرُۚ لَوۡ كَانُواْ يَعۡلَمُونَ ﰠ",
          "textUthmaniBody": "كَذَٰلِكَ ٱلۡعَذَابُۖ وَلَعَذَابُ ٱلۡأٓخِرَةِ أَكۡبَرُۚ لَوۡ كَانُواْ يَعۡلَمُونَ",
          "textImlaei": "كذلك العذاب ولعذاب الآخرة أكبر لو كانوا يعلمون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC20"
        },
        {
          "ayah": 34,
          "page": 565,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "إِنَّ لِلۡمُتَّقِينَ عِندَ رَبِّهِمۡ جَنَّٰتِ ٱلنَّعِيمِ ﰡ",
          "textUthmaniBody": "إِنَّ لِلۡمُتَّقِينَ عِندَ رَبِّهِمۡ جَنَّٰتِ ٱلنَّعِيمِ",
          "textImlaei": "إن للمتقين عند ربهم جنات النعيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC21"
        },
        {
          "ayah": 35,
          "page": 565,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "أَفَنَجۡعَلُ ٱلۡمُسۡلِمِينَ كَٱلۡمُجۡرِمِينَ ﰢ",
          "textUthmaniBody": "أَفَنَجۡعَلُ ٱلۡمُسۡلِمِينَ كَٱلۡمُجۡرِمِينَ",
          "textImlaei": "أفنجعل المسلمين كالمجرمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC22"
        },
        {
          "ayah": 36,
          "page": 565,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "مَا لَكُمۡ كَيۡفَ تَحۡكُمُونَ ﰣ",
          "textUthmaniBody": "مَا لَكُمۡ كَيۡفَ تَحۡكُمُونَ",
          "textImlaei": "ما لكم كيف تحكمون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC23"
        },
        {
          "ayah": 37,
          "page": 565,
          "lineStart": 11,
          "lineEnd": 12,
          "textUthmaniRaw": "أَمۡ لَكُمۡ كِتَٰبٞ فِيهِ تَدۡرُسُونَ ﰤ",
          "textUthmaniBody": "أَمۡ لَكُمۡ كِتَٰبٞ فِيهِ تَدۡرُسُونَ",
          "textImlaei": "أم لكم كتاب فيه تدرسون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC24"
        },
        {
          "ayah": 38,
          "page": 565,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "إِنَّ لَكُمۡ فِيهِ لَمَا تَخَيَّرُونَ ﰥ",
          "textUthmaniBody": "إِنَّ لَكُمۡ فِيهِ لَمَا تَخَيَّرُونَ",
          "textImlaei": "إن لكم فيه لما تخيرون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC25"
        },
        {
          "ayah": 39,
          "page": 565,
          "lineStart": 12,
          "lineEnd": 13,
          "textUthmaniRaw": "أَمۡ لَكُمۡ أَيۡمَٰنٌ عَلَيۡنَا بَٰلِغَةٌ إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِ إِنَّ لَكُمۡ لَمَا تَحۡكُمُونَ ﰦ",
          "textUthmaniBody": "أَمۡ لَكُمۡ أَيۡمَٰنٌ عَلَيۡنَا بَٰلِغَةٌ إِلَىٰ يَوۡمِ ٱلۡقِيَٰمَةِ إِنَّ لَكُمۡ لَمَا تَحۡكُمُونَ",
          "textImlaei": "أم لكم أيمان علينا بالغة إلى يوم القيامة إن لكم لما تحكمون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC26"
        },
        {
          "ayah": 40,
          "page": 565,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "سَلۡهُمۡ أَيُّهُم بِذَٰلِكَ زَعِيمٌ ﰧ",
          "textUthmaniBody": "سَلۡهُمۡ أَيُّهُم بِذَٰلِكَ زَعِيمٌ",
          "textImlaei": "سلهم أيهم بذلك زعيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC27"
        },
        {
          "ayah": 41,
          "page": 565,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "أَمۡ لَهُمۡ شُرَكَآءُ فَلۡيَأۡتُواْ بِشُرَكَآئِهِمۡ إِن كَانُواْ صَٰدِقِينَ ﰨ",
          "textUthmaniBody": "أَمۡ لَهُمۡ شُرَكَآءُ فَلۡيَأۡتُواْ بِشُرَكَآئِهِمۡ إِن كَانُواْ صَٰدِقِينَ",
          "textImlaei": "أم لهم شركاء فليأتوا بشركائهم إن كانوا صادقين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC28"
        },
        {
          "ayah": 42,
          "page": 565,
          "lineStart": 14,
          "lineEnd": 15,
          "textUthmaniRaw": "يَوۡمَ يُكۡشَفُ عَن سَاقٖ وَيُدۡعَوۡنَ إِلَى ٱلسُّجُودِ فَلَا يَسۡتَطِيعُونَ ﰩ",
          "textUthmaniBody": "يَوۡمَ يُكۡشَفُ عَن سَاقٖ وَيُدۡعَوۡنَ إِلَى ٱلسُّجُودِ فَلَا يَسۡتَطِيعُونَ",
          "textImlaei": "يوم يكشف عن ساق ويدعون إلى السجود فلا يستطيعون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC29"
        }
      ]
    },
    {
      "page": 566,
      "juz": 29,
      "ayahs": [
        {
          "ayah": 43,
          "page": 566,
          "lineStart": 1,
          "lineEnd": 2,
          "textUthmaniRaw": "خَٰشِعَةً أَبۡصَٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةٞۖ وَقَدۡ كَانُواْ يُدۡعَوۡنَ إِلَى ٱلسُّجُودِ وَهُمۡ سَٰلِمُونَ ﰪ",
          "textUthmaniBody": "خَٰشِعَةً أَبۡصَٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةٞۖ وَقَدۡ كَانُواْ يُدۡعَوۡنَ إِلَى ٱلسُّجُودِ وَهُمۡ سَٰلِمُونَ",
          "textImlaei": "خاشعة أبصارهم ترهقهم ذلة وقد كانوا يدعون إلى السجود وهم سالمون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2A"
        },
        {
          "ayah": 44,
          "page": 566,
          "lineStart": 2,
          "lineEnd": 3,
          "textUthmaniRaw": "فَذَرۡنِي وَمَن يُكَذِّبُ بِهَٰذَا ٱلۡحَدِيثِۖ سَنَسۡتَدۡرِجُهُم مِّنۡ حَيۡثُ لَا يَعۡلَمُونَ ﰫ",
          "textUthmaniBody": "فَذَرۡنِي وَمَن يُكَذِّبُ بِهَٰذَا ٱلۡحَدِيثِۖ سَنَسۡتَدۡرِجُهُم مِّنۡ حَيۡثُ لَا يَعۡلَمُونَ",
          "textImlaei": "فذرني ومن يكذب بهذا الحديث سنستدرجهم من حيث لا يعلمون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2B"
        },
        {
          "ayah": 45,
          "page": 566,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "وَأُمۡلِي لَهُمۡۚ إِنَّ كَيۡدِي مَتِينٌ ﰬ",
          "textUthmaniBody": "وَأُمۡلِي لَهُمۡۚ إِنَّ كَيۡدِي مَتِينٌ",
          "textImlaei": "وأملي لهم إن كيدي متين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2C"
        },
        {
          "ayah": 46,
          "page": 566,
          "lineStart": 3,
          "lineEnd": 4,
          "textUthmaniRaw": "أَمۡ تَسۡـَٔلُهُمۡ أَجۡرٗا فَهُم مِّن مَّغۡرَمٖ مُّثۡقَلُونَ ﰭ",
          "textUthmaniBody": "أَمۡ تَسۡـَٔلُهُمۡ أَجۡرٗا فَهُم مِّن مَّغۡرَمٖ مُّثۡقَلُونَ",
          "textImlaei": "أم تسألهم أجرا فهم من مغرم مثقلون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2D"
        },
        {
          "ayah": 47,
          "page": 566,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "أَمۡ عِندَهُمُ ٱلۡغَيۡبُ فَهُمۡ يَكۡتُبُونَ ﰮ",
          "textUthmaniBody": "أَمۡ عِندَهُمُ ٱلۡغَيۡبُ فَهُمۡ يَكۡتُبُونَ",
          "textImlaei": "أم عندهم الغيب فهم يكتبون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2E"
        },
        {
          "ayah": 48,
          "page": 566,
          "lineStart": 5,
          "lineEnd": 6,
          "textUthmaniRaw": "فَٱصۡبِرۡ لِحُكۡمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلۡحُوتِ إِذۡ نَادَىٰ وَهُوَ مَكۡظُومٞ ﰯ",
          "textUthmaniBody": "فَٱصۡبِرۡ لِحُكۡمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلۡحُوتِ إِذۡ نَادَىٰ وَهُوَ مَكۡظُومٞ",
          "textImlaei": "فاصبر لحكم ربك ولا تكن كصاحب الحوت إذ نادى وهو مكظوم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2F"
        },
        {
          "ayah": 49,
          "page": 566,
          "lineStart": 6,
          "lineEnd": 7,
          "textUthmaniRaw": "لَّوۡلَآ أَن تَدَٰرَكَهُۥ نِعۡمَةٞ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلۡعَرَآءِ وَهُوَ مَذۡمُومٞ ﰰ",
          "textUthmaniBody": "لَّوۡلَآ أَن تَدَٰرَكَهُۥ نِعۡمَةٞ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلۡعَرَآءِ وَهُوَ مَذۡمُومٞ",
          "textImlaei": "لولا أن تداركه نعمة من ربه لنبذ بالعراء وهو مذموم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC30"
        },
        {
          "ayah": 50,
          "page": 566,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "فَٱجۡتَبَٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّٰلِحِينَ ﰱ",
          "textUthmaniBody": "فَٱجۡتَبَٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّٰلِحِينَ",
          "textImlaei": "فاجتباه ربه فجعله من الصالحين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC31"
        },
        {
          "ayah": 51,
          "page": 566,
          "lineStart": 8,
          "lineEnd": 9,
          "textUthmaniRaw": "وَإِن يَكَادُ ٱلَّذِينَ كَفَرُواْ لَيُزۡلِقُونَكَ بِأَبۡصَٰرِهِمۡ لَمَّا سَمِعُواْ ٱلذِّكۡرَ وَيَقُولُونَ إِنَّهُۥ لَمَجۡنُونٞ ﰲ",
          "textUthmaniBody": "وَإِن يَكَادُ ٱلَّذِينَ كَفَرُواْ لَيُزۡلِقُونَكَ بِأَبۡصَٰرِهِمۡ لَمَّا سَمِعُواْ ٱلذِّكۡرَ وَيَقُولُونَ إِنَّهُۥ لَمَجۡنُونٞ",
          "textImlaei": "وإن يكاد الذين كفروا ليزلقونك بأبصارهم لما سمعوا الذكر ويقولون إنه لمجنون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC32"
        },
        {
          "ayah": 52,
          "page": 566,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "وَمَا هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ ﰳ",
          "textUthmaniBody": "وَمَا هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ",
          "textImlaei": "وما هو إلا ذكر للعالمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC33"
        }
      ]
    }
  ]
}
