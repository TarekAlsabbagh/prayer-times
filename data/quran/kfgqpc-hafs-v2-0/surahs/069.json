      "ayahs": [
        {
          "ayah": 1,
          "page": 566,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "ٱلۡحَآقَّةُ ﰀ",
          "textUthmaniBody": "ٱلۡحَآقَّةُ",
          "textImlaei": "الحاقة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 566,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "مَا ٱلۡحَآقَّةُ ﰁ",
          "textUthmaniBody": "مَا ٱلۡحَآقَّةُ",
          "textImlaei": "ما الحاقة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 566,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡحَآقَّةُ ﰂ",
          "textUthmaniBody": "وَمَآ أَدۡرَىٰكَ مَا ٱلۡحَآقَّةُ",
          "textImlaei": "وما أدراك ما الحاقة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 566,
          "lineStart": 12,
          "lineEnd": 13,
          "textUthmaniRaw": "كَذَّبَتۡ ثَمُودُ وَعَادُۢ بِٱلۡقَارِعَةِ ﰃ",
          "textUthmaniBody": "كَذَّبَتۡ ثَمُودُ وَعَادُۢ بِٱلۡقَارِعَةِ",
          "textImlaei": "كذبت ثمود وعاد بالقارعة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 566,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "فَأَمَّا ثَمُودُ فَأُهۡلِكُواْ بِٱلطَّاغِيَةِ ﰄ",
          "textUthmaniBody": "فَأَمَّا ثَمُودُ فَأُهۡلِكُواْ بِٱلطَّاغِيَةِ",
          "textImlaei": "فأما ثمود فأهلكوا بالطاغية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 566,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "وَأَمَّا عَادٞ فَأُهۡلِكُواْ بِرِيحٖ صَرۡصَرٍ عَاتِيَةٖ ﰅ",
          "textUthmaniBody": "وَأَمَّا عَادٞ فَأُهۡلِكُواْ بِرِيحٖ صَرۡصَرٍ عَاتِيَةٖ",
          "textImlaei": "وأما عاد فأهلكوا بريح صرصر عاتية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 566,
          "lineStart": 14,
          "lineEnd": 15,
          "textUthmaniRaw": "سَخَّرَهَا عَلَيۡهِمۡ سَبۡعَ لَيَالٖ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومٗاۖ فَتَرَى ٱلۡقَوۡمَ فِيهَا صَرۡعَىٰ كَأَنَّهُمۡ أَعۡجَازُ نَخۡلٍ خَاوِيَةٖ ﰆ",
          "textUthmaniBody": "سَخَّرَهَا عَلَيۡهِمۡ سَبۡعَ لَيَالٖ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومٗاۖ فَتَرَى ٱلۡقَوۡمَ فِيهَا صَرۡعَىٰ كَأَنَّهُمۡ أَعۡجَازُ نَخۡلٍ خَاوِيَةٖ",
          "textImlaei": "سخرها عليهم سبع ليال وثمانية أيام حسوما فترى القوم فيها صرعى كأنهم أعجاز نخل خاوية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 566,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "فَهَلۡ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٖ ﰇ",
          "textUthmaniBody": "فَهَلۡ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٖ",
          "textImlaei": "فهل ترى لهم من باقية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        }
      ]
    },
    {
      "page": 567,
      "juz": 29,
      "ayahs": [
        {
          "ayah": 9,
          "page": 567,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "وَجَآءَ فِرۡعَوۡنُ وَمَن قَبۡلَهُۥ وَٱلۡمُؤۡتَفِكَٰتُ بِٱلۡخَاطِئَةِ ﰈ",
          "textUthmaniBody": "وَجَآءَ فِرۡعَوۡنُ وَمَن قَبۡلَهُۥ وَٱلۡمُؤۡتَفِكَٰتُ بِٱلۡخَاطِئَةِ",
          "textImlaei": "وجاء فرعون ومن قبله والمؤتفكات بالخاطئة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 567,
          "lineStart": 1,
          "lineEnd": 2,
          "textUthmaniRaw": "فَعَصَوۡاْ رَسُولَ رَبِّهِمۡ فَأَخَذَهُمۡ أَخۡذَةٗ رَّابِيَةً ﰉ",
          "textUthmaniBody": "فَعَصَوۡاْ رَسُولَ رَبِّهِمۡ فَأَخَذَهُمۡ أَخۡذَةٗ رَّابِيَةً",
          "textImlaei": "فعصوا رسول ربهم فأخذهم أخذة رابية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 567,
          "lineStart": 2,
          "lineEnd": 3,
          "textUthmaniRaw": "إِنَّا لَمَّا طَغَا ٱلۡمَآءُ حَمَلۡنَٰكُمۡ فِي ٱلۡجَارِيَةِ ﰊ",
          "textUthmaniBody": "إِنَّا لَمَّا طَغَا ٱلۡمَآءُ حَمَلۡنَٰكُمۡ فِي ٱلۡجَارِيَةِ",
          "textImlaei": "إنا لما طغى الماء حملناكم في الجارية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 567,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "لِنَجۡعَلَهَا لَكُمۡ تَذۡكِرَةٗ وَتَعِيَهَآ أُذُنٞ وَٰعِيَةٞ ﰋ",
          "textUthmaniBody": "لِنَجۡعَلَهَا لَكُمۡ تَذۡكِرَةٗ وَتَعِيَهَآ أُذُنٞ وَٰعِيَةٞ",
          "textImlaei": "لنجعلها لكم تذكرة وتعيها أذن واعية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 567,
          "lineStart": 3,
          "lineEnd": 4,
          "textUthmaniRaw": "فَإِذَا نُفِخَ فِي ٱلصُّورِ نَفۡخَةٞ وَٰحِدَةٞ ﰌ",
          "textUthmaniBody": "فَإِذَا نُفِخَ فِي ٱلصُّورِ نَفۡخَةٞ وَٰحِدَةٞ",
          "textImlaei": "فإذا نفخ في الصور نفخة واحدة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 567,
          "lineStart": 4,
          "lineEnd": 5,
          "textUthmaniRaw": "وَحُمِلَتِ ٱلۡأَرۡضُ وَٱلۡجِبَالُ فَدُكَّتَا دَكَّةٗ وَٰحِدَةٗ ﰍ",
          "textUthmaniBody": "وَحُمِلَتِ ٱلۡأَرۡضُ وَٱلۡجِبَالُ فَدُكَّتَا دَكَّةٗ وَٰحِدَةٗ",
          "textImlaei": "وحملت الأرض والجبال فدكتا دكة واحدة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 567,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "فَيَوۡمَئِذٖ وَقَعَتِ ٱلۡوَاقِعَةُ ﰎ",
          "textUthmaniBody": "فَيَوۡمَئِذٖ وَقَعَتِ ٱلۡوَاقِعَةُ",
          "textImlaei": "فيومئذ وقعت الواقعة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 567,
          "lineStart": 5,
          "lineEnd": 6,
          "textUthmaniRaw": "وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِيَ يَوۡمَئِذٖ وَاهِيَةٞ ﰏ",
          "textUthmaniBody": "وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِيَ يَوۡمَئِذٖ وَاهِيَةٞ",
          "textImlaei": "وانشقت السماء فهي يومئذ واهية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        },
        {
          "ayah": 17,
          "page": 567,
          "lineStart": 6,
          "lineEnd": 7,
          "textUthmaniRaw": "وَٱلۡمَلَكُ عَلَىٰٓ أَرۡجَآئِهَاۚ وَيَحۡمِلُ عَرۡشَ رَبِّكَ فَوۡقَهُمۡ يَوۡمَئِذٖ ثَمَٰنِيَةٞ ﰐ",
          "textUthmaniBody": "وَٱلۡمَلَكُ عَلَىٰٓ أَرۡجَآئِهَاۚ وَيَحۡمِلُ عَرۡشَ رَبِّكَ فَوۡقَهُمۡ يَوۡمَئِذٖ ثَمَٰنِيَةٞ",
          "textImlaei": "والملك على أرجائها ويحمل عرش ربك فوقهم يومئذ ثمانية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        },
        {
          "ayah": 18,
          "page": 567,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "يَوۡمَئِذٖ تُعۡرَضُونَ لَا تَخۡفَىٰ مِنكُمۡ خَافِيَةٞ ﰑ",
          "textUthmaniBody": "يَوۡمَئِذٖ تُعۡرَضُونَ لَا تَخۡفَىٰ مِنكُمۡ خَافِيَةٞ",
          "textImlaei": "يومئذ تعرضون لا تخفى منكم خافية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC11"
        },
        {
          "ayah": 19,
          "page": 567,
          "lineStart": 7,
          "lineEnd": 8,
          "textUthmaniRaw": "فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقۡرَءُواْ كِتَٰبِيَهۡ ﰒ",
          "textUthmaniBody": "فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقۡرَءُواْ كِتَٰبِيَهۡ",
          "textImlaei": "فأما من أوتي كتابه بيمينه فيقول هاؤم اقرءوا كتابيه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC12"
        },
        {
          "ayah": 20,
          "page": 567,
          "lineStart": 8,
          "lineEnd": 9,
          "textUthmaniRaw": "إِنِّي ظَنَنتُ أَنِّي مُلَٰقٍ حِسَابِيَهۡ ﰓ",
          "textUthmaniBody": "إِنِّي ظَنَنتُ أَنِّي مُلَٰقٍ حِسَابِيَهۡ",
          "textImlaei": "إني ظننت أني ملاق حسابيه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC13"
        },
        {
          "ayah": 21,
          "page": 567,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ ﰔ",
          "textUthmaniBody": "فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ",
          "textImlaei": "فهو في عيشة راضية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC14"
        },
        {
          "ayah": 22,
          "page": 567,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "فِي جَنَّةٍ عَالِيَةٖ ﰕ",
          "textUthmaniBody": "فِي جَنَّةٍ عَالِيَةٖ",
          "textImlaei": "في جنة عالية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC15"
        },
        {
          "ayah": 23,
          "page": 567,
          "lineStart": 9,
          "lineEnd": 10,
          "textUthmaniRaw": "قُطُوفُهَا دَانِيَةٞ ﰖ",
          "textUthmaniBody": "قُطُوفُهَا دَانِيَةٞ",
          "textImlaei": "قطوفها دانية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC16"
        },
        {
          "ayah": 24,
          "page": 567,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَآ أَسۡلَفۡتُمۡ فِي ٱلۡأَيَّامِ ٱلۡخَالِيَةِ ﰗ",
          "textUthmaniBody": "كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَآ أَسۡلَفۡتُمۡ فِي ٱلۡأَيَّامِ ٱلۡخَالِيَةِ",
          "textImlaei": "كلوا واشربوا هنيئا بما أسلفتم في الأيام الخالية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC17"
        },
        {
          "ayah": 25,
          "page": 567,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيۡتَنِي لَمۡ أُوتَ كِتَٰبِيَهۡ ﰘ",
          "textUthmaniBody": "وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيۡتَنِي لَمۡ أُوتَ كِتَٰبِيَهۡ",
          "textImlaei": "وأما من أوتي كتابه بشماله فيقول ياليتني لم أوت كتابيه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC18"
        },
        {
          "ayah": 26,
          "page": 567,
          "lineStart": 11,
          "lineEnd": 12,
          "textUthmaniRaw": "وَلَمۡ أَدۡرِ مَا حِسَابِيَهۡ ﰙ",
          "textUthmaniBody": "وَلَمۡ أَدۡرِ مَا حِسَابِيَهۡ",
          "textImlaei": "ولم أدر ما حسابيه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC19"
        },
        {
          "ayah": 27,
          "page": 567,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "يَٰلَيۡتَهَا كَانَتِ ٱلۡقَاضِيَةَ ﰚ",
          "textUthmaniBody": "يَٰلَيۡتَهَا كَانَتِ ٱلۡقَاضِيَةَ",
          "textImlaei": "ياليتها كانت القاضية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1A"
        },
        {
          "ayah": 28,
          "page": 567,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "مَآ أَغۡنَىٰ عَنِّي مَالِيَهۡۜ ﰛ",
          "textUthmaniBody": "مَآ أَغۡنَىٰ عَنِّي مَالِيَهۡۜ",
          "textImlaei": "ما أغنى عني ماليه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1B"
        },
        {
          "ayah": 29,
          "page": 567,
          "lineStart": 12,
          "lineEnd": 13,
          "textUthmaniRaw": "هَلَكَ عَنِّي سُلۡطَٰنِيَهۡ ﰜ",
          "textUthmaniBody": "هَلَكَ عَنِّي سُلۡطَٰنِيَهۡ",
          "textImlaei": "هلك عني سلطانيه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1C"
        },
        {
          "ayah": 30,
          "page": 567,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "خُذُوهُ فَغُلُّوهُ ﰝ",
          "textUthmaniBody": "خُذُوهُ فَغُلُّوهُ",
          "textImlaei": "خذوه فغلوه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1D"
        },
        {
          "ayah": 31,
          "page": 567,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "ثُمَّ ٱلۡجَحِيمَ صَلُّوهُ ﰞ",
          "textUthmaniBody": "ثُمَّ ٱلۡجَحِيمَ صَلُّوهُ",
          "textImlaei": "ثم الجحيم صلوه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1E"
        },
        {
          "ayah": 32,
          "page": 567,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "ثُمَّ فِي سِلۡسِلَةٖ ذَرۡعُهَا سَبۡعُونَ ذِرَاعٗا فَٱسۡلُكُوهُ ﰟ",
          "textUthmaniBody": "ثُمَّ فِي سِلۡسِلَةٖ ذَرۡعُهَا سَبۡعُونَ ذِرَاعٗا فَٱسۡلُكُوهُ",
          "textImlaei": "ثم في سلسلة ذرعها سبعون ذراعا فاسلكوه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1F"
        },
        {
          "ayah": 33,
          "page": 567,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "إِنَّهُۥ كَانَ لَا يُؤۡمِنُ بِٱللَّهِ ٱلۡعَظِيمِ ﰠ",
          "textUthmaniBody": "إِنَّهُۥ كَانَ لَا يُؤۡمِنُ بِٱللَّهِ ٱلۡعَظِيمِ",
          "textImlaei": "إنه كان لا يؤمن بالله العظيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC20"
        },
        {
          "ayah": 34,
          "page": 567,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ﰡ",
          "textUthmaniBody": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ",
          "textImlaei": "ولا يحض على طعام المسكين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC21"
        },
        {
          "ayah": 35,
          "page": 567,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "فَلَيۡسَ لَهُ ٱلۡيَوۡمَ هَٰهُنَا حَمِيمٞ ﰢ",
          "textUthmaniBody": "فَلَيۡسَ لَهُ ٱلۡيَوۡمَ هَٰهُنَا حَمِيمٞ",
          "textImlaei": "فليس له اليوم هاهنا حميم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC22"
        }
      ]
    },
    {
      "page": 568,
      "juz": 29,
      "ayahs": [
        {
          "ayah": 36,
          "page": 568,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "وَلَا طَعَامٌ إِلَّا مِنۡ غِسۡلِينٖ ﰣ",
          "textUthmaniBody": "وَلَا طَعَامٌ إِلَّا مِنۡ غِسۡلِينٖ",
          "textImlaei": "ولا طعام إلا من غسلين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC23"
        },
        {
          "ayah": 37,
          "page": 568,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "لَّا يَأۡكُلُهُۥٓ إِلَّا ٱلۡخَٰطِـُٔونَ ﰤ",
          "textUthmaniBody": "لَّا يَأۡكُلُهُۥٓ إِلَّا ٱلۡخَٰطِـُٔونَ",
          "textImlaei": "لا يأكله إلا الخاطئون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC24"
        },
        {
          "ayah": 38,
          "page": 568,
          "lineStart": 1,
          "lineEnd": 2,
          "textUthmaniRaw": "فَلَآ أُقۡسِمُ بِمَا تُبۡصِرُونَ ﰥ",
          "textUthmaniBody": "فَلَآ أُقۡسِمُ بِمَا تُبۡصِرُونَ",
          "textImlaei": "فلا أقسم بما تبصرون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC25"
        },
        {
          "ayah": 39,
          "page": 568,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "وَمَا لَا تُبۡصِرُونَ ﰦ",
          "textUthmaniBody": "وَمَا لَا تُبۡصِرُونَ",
          "textImlaei": "وما لا تبصرون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC26"
        },
        {
          "ayah": 40,
          "page": 568,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ ﰧ",
          "textUthmaniBody": "إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ",
          "textImlaei": "إنه لقول رسول كريم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC27"
        },
        {
          "ayah": 41,
          "page": 568,
          "lineStart": 2,
          "lineEnd": 3,
          "textUthmaniRaw": "وَمَا هُوَ بِقَوۡلِ شَاعِرٖۚ قَلِيلٗا مَّا تُؤۡمِنُونَ ﰨ",
          "textUthmaniBody": "وَمَا هُوَ بِقَوۡلِ شَاعِرٖۚ قَلِيلٗا مَّا تُؤۡمِنُونَ",
          "textImlaei": "وما هو بقول شاعر قليلا ما تؤمنون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC28"
        },
        {
          "ayah": 42,
          "page": 568,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "وَلَا بِقَوۡلِ كَاهِنٖۚ قَلِيلٗا مَّا تَذَكَّرُونَ ﰩ",
          "textUthmaniBody": "وَلَا بِقَوۡلِ كَاهِنٖۚ قَلِيلٗا مَّا تَذَكَّرُونَ",
          "textImlaei": "ولا بقول كاهن قليلا ما تذكرون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC29"
        },
        {
          "ayah": 43,
          "page": 568,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ ﰪ",
          "textUthmaniBody": "تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ",
          "textImlaei": "تنزيل من رب العالمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2A"
        },
        {
          "ayah": 44,
          "page": 568,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "وَلَوۡ تَقَوَّلَ عَلَيۡنَا بَعۡضَ ٱلۡأَقَاوِيلِ ﰫ",
          "textUthmaniBody": "وَلَوۡ تَقَوَّلَ عَلَيۡنَا بَعۡضَ ٱلۡأَقَاوِيلِ",
          "textImlaei": "ولو تقول علينا بعض الأقاويل",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2B"
        },
        {
          "ayah": 45,
          "page": 568,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "لَأَخَذۡنَا مِنۡهُ بِٱلۡيَمِينِ ﰬ",
          "textUthmaniBody": "لَأَخَذۡنَا مِنۡهُ بِٱلۡيَمِينِ",
          "textImlaei": "لأخذنا منه باليمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2C"
        },
        {
          "ayah": 46,
          "page": 568,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "ثُمَّ لَقَطَعۡنَا مِنۡهُ ٱلۡوَتِينَ ﰭ",
          "textUthmaniBody": "ثُمَّ لَقَطَعۡنَا مِنۡهُ ٱلۡوَتِينَ",
          "textImlaei": "ثم لقطعنا منه الوتين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2D"
        },
        {
          "ayah": 47,
          "page": 568,
          "lineStart": 5,
          "lineEnd": 6,
          "textUthmaniRaw": "فَمَا مِنكُم مِّنۡ أَحَدٍ عَنۡهُ حَٰجِزِينَ ﰮ",
          "textUthmaniBody": "فَمَا مِنكُم مِّنۡ أَحَدٍ عَنۡهُ حَٰجِزِينَ",
          "textImlaei": "فما منكم من أحد عنه حاجزين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2E"
        },
        {
          "ayah": 48,
          "page": 568,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "وَإِنَّهُۥ لَتَذۡكِرَةٞ لِّلۡمُتَّقِينَ ﰯ",
          "textUthmaniBody": "وَإِنَّهُۥ لَتَذۡكِرَةٞ لِّلۡمُتَّقِينَ",
          "textImlaei": "وإنه لتذكرة للمتقين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2F"
        },
        {
          "ayah": 49,
          "page": 568,
          "lineStart": 6,
          "lineEnd": 7,
          "textUthmaniRaw": "وَإِنَّا لَنَعۡلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ ﰰ",
          "textUthmaniBody": "وَإِنَّا لَنَعۡلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ",
          "textImlaei": "وإنا لنعلم أن منكم مكذبين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC30"
        },
        {
          "ayah": 50,
          "page": 568,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "وَإِنَّهُۥ لَحَسۡرَةٌ عَلَى ٱلۡكَٰفِرِينَ ﰱ",
          "textUthmaniBody": "وَإِنَّهُۥ لَحَسۡرَةٌ عَلَى ٱلۡكَٰفِرِينَ",
          "textImlaei": "وإنه لحسرة على الكافرين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC31"
        },
        {
          "ayah": 51,
          "page": 568,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "وَإِنَّهُۥ لَحَقُّ ٱلۡيَقِينِ ﰲ",
          "textUthmaniBody": "وَإِنَّهُۥ لَحَقُّ ٱلۡيَقِينِ",
          "textImlaei": "وإنه لحق اليقين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC32"
        },
        {
          "ayah": 52,
          "page": 568,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ﰳ",
          "textUthmaniBody": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ",
          "textImlaei": "فسبح باسم ربك العظيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC33"
        }
      ]
    }
  ]
}
