{
  "surah": 70,
  "nameAr": "المَعَارج",
  "nameEn": "Al-Ma‘ārij",
  "ayahCount": 44,
  "firstPage": 568,
  "lastPage": 570,
  "pageCount": 3,
  "juz": [
