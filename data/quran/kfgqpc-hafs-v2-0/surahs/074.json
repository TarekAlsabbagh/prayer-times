          "page": 576,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "كَلَّا وَٱلۡقَمَرِ ﰟ",
          "textUthmaniBody": "كَلَّا وَٱلۡقَمَرِ",
          "textImlaei": "كلا والقمر",
          "rawEndSeparatorCodePoint": "U+00A0",
