          "textUthmaniBody": "إِنَّهَا لَإِحۡدَى ٱلۡكُبَرِ",
          "textImlaei": "إنها لإحدى الكبر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC22"
        },
        {
          "ayah": 36,
          "page": 576,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "نَذِيرٗا لِّلۡبَشَرِ ﰣ",
          "textUthmaniBody": "نَذِيرٗا لِّلۡبَشَرِ",
          "textImlaei": "نذيرا للبشر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC23"
        },
        {
          "ayah": 37,
          "page": 576,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "لِمَن شَآءَ مِنكُمۡ أَن يَتَقَدَّمَ أَوۡ يَتَأَخَّرَ ﰤ",
          "textUthmaniBody": "لِمَن شَآءَ مِنكُمۡ أَن يَتَقَدَّمَ أَوۡ يَتَأَخَّرَ",
          "textImlaei": "لمن شاء منكم أن يتقدم أو يتأخر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC24"
        },
        {
          "ayah": 38,
          "page": 576,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "كُلُّ نَفۡسِۭ بِمَا كَسَبَتۡ رَهِينَةٌ ﰥ",
          "textUthmaniBody": "كُلُّ نَفۡسِۭ بِمَا كَسَبَتۡ رَهِينَةٌ",
          "textImlaei": "كل نفس بما كسبت رهينة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC25"
        },
        {
          "ayah": 39,
          "page": 576,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "إِلَّآ أَصۡحَٰبَ ٱلۡيَمِينِ ﰦ",
          "textUthmaniBody": "إِلَّآ أَصۡحَٰبَ ٱلۡيَمِينِ",
          "textImlaei": "إلا أصحاب اليمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC26"
        },
        {
          "ayah": 40,
          "page": 576,
          "lineStart": 12,
          "lineEnd": 13,
          "textUthmaniRaw": "فِي جَنَّٰتٖ يَتَسَآءَلُونَ ﰧ",
          "textUthmaniBody": "فِي جَنَّٰتٖ يَتَسَآءَلُونَ",
          "textImlaei": "في جنات يتساءلون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC27"
        },
        {
          "ayah": 41,
          "page": 576,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "عَنِ ٱلۡمُجۡرِمِينَ ﰨ",
          "textUthmaniBody": "عَنِ ٱلۡمُجۡرِمِينَ",
          "textImlaei": "عن المجرمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC28"
        },
        {
          "ayah": 42,
          "page": 576,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "مَا سَلَكَكُمۡ فِي سَقَرَ ﰩ",
          "textUthmaniBody": "مَا سَلَكَكُمۡ فِي سَقَرَ",
          "textImlaei": "ما سلككم في سقر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC29"
        },
        {
          "ayah": 43,
          "page": 576,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "قَالُواْ لَمۡ نَكُ مِنَ ٱلۡمُصَلِّينَ ﰪ",
          "textUthmaniBody": "قَالُواْ لَمۡ نَكُ مِنَ ٱلۡمُصَلِّينَ",
          "textImlaei": "قالوا لم نك من المصلين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2A"
        },
        {
          "ayah": 44,
          "page": 576,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "وَلَمۡ نَكُ نُطۡعِمُ ٱلۡمِسۡكِينَ ﰫ",
          "textUthmaniBody": "وَلَمۡ نَكُ نُطۡعِمُ ٱلۡمِسۡكِينَ",
          "textImlaei": "ولم نك نطعم المسكين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2B"
        },
        {
          "ayah": 45,
          "page": 576,
          "lineStart": 14,
          "lineEnd": 15,
          "textUthmaniRaw": "وَكُنَّا نَخُوضُ مَعَ ٱلۡخَآئِضِينَ ﰬ",
          "textUthmaniBody": "وَكُنَّا نَخُوضُ مَعَ ٱلۡخَآئِضِينَ",
          "textImlaei": "وكنا نخوض مع الخائضين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2C"
        },
        {
          "ayah": 46,
          "page": 576,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "وَكُنَّا نُكَذِّبُ بِيَوۡمِ ٱلدِّينِ ﰭ",
          "textUthmaniBody": "وَكُنَّا نُكَذِّبُ بِيَوۡمِ ٱلدِّينِ",
          "textImlaei": "وكنا نكذب بيوم الدين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2D"
        },
        {
          "ayah": 47,
          "page": 576,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "حَتَّىٰٓ أَتَىٰنَا ٱلۡيَقِينُ ﰮ",
          "textUthmaniBody": "حَتَّىٰٓ أَتَىٰنَا ٱلۡيَقِينُ",
          "textImlaei": "حتى أتانا اليقين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2E"
        }
      ]
    },
    {
      "page": 577,
      "juz": 29,
      "ayahs": [
        {
          "ayah": 48,
          "page": 577,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "فَمَا تَنفَعُهُمۡ شَفَٰعَةُ ٱلشَّٰفِعِينَ ﰯ",
          "textUthmaniBody": "فَمَا تَنفَعُهُمۡ شَفَٰعَةُ ٱلشَّٰفِعِينَ",
          "textImlaei": "فما تنفعهم شفاعة الشافعين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2F"
        },
        {
          "ayah": 49,
          "page": 577,
          "lineStart": 1,
          "lineEnd": 2,
          "textUthmaniRaw": "فَمَا لَهُمۡ عَنِ ٱلتَّذۡكِرَةِ مُعۡرِضِينَ ﰰ",
          "textUthmaniBody": "فَمَا لَهُمۡ عَنِ ٱلتَّذۡكِرَةِ مُعۡرِضِينَ",
          "textImlaei": "فما لهم عن التذكرة معرضين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC30"
        },
        {
          "ayah": 50,
          "page": 577,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "كَأَنَّهُمۡ حُمُرٞ مُّسۡتَنفِرَةٞ ﰱ",
          "textUthmaniBody": "كَأَنَّهُمۡ حُمُرٞ مُّسۡتَنفِرَةٞ",
          "textImlaei": "كأنهم حمر مستنفرة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC31"
        },
        {
          "ayah": 51,
          "page": 577,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "فَرَّتۡ مِن قَسۡوَرَةِۭ ﰲ",
          "textUthmaniBody": "فَرَّتۡ مِن قَسۡوَرَةِۭ",
          "textImlaei": "فرت من قسورة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC32"
        },
        {
          "ayah": 52,
          "page": 577,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "بَلۡ يُرِيدُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُؤۡتَىٰ صُحُفٗا مُّنَشَّرَةٗ ﰳ",
          "textUthmaniBody": "بَلۡ يُرِيدُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُؤۡتَىٰ صُحُفٗا مُّنَشَّرَةٗ",
          "textImlaei": "بل يريد كل امرئ منهم أن يؤتى صحفا منشرة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC33"
        },
        {
          "ayah": 53,
          "page": 577,
          "lineStart": 3,
          "lineEnd": 4,
          "textUthmaniRaw": "كَلَّاۖ بَل لَّا يَخَافُونَ ٱلۡأٓخِرَةَ ﰴ",
          "textUthmaniBody": "كَلَّاۖ بَل لَّا يَخَافُونَ ٱلۡأٓخِرَةَ",
          "textImlaei": "كلا بل لا يخافون الآخرة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC34"
        },
        {
          "ayah": 54,
          "page": 577,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "كَلَّآ إِنَّهُۥ تَذۡكِرَةٞ ﰵ",
          "textUthmaniBody": "كَلَّآ إِنَّهُۥ تَذۡكِرَةٞ",
          "textImlaei": "كلا إنه تذكرة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC35"
        },
        {
          "ayah": 55,
          "page": 577,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "فَمَن شَآءَ ذَكَرَهُۥ ﰶ",
          "textUthmaniBody": "فَمَن شَآءَ ذَكَرَهُۥ",
          "textImlaei": "فمن شاء ذكره",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC36"
        },
        {
          "ayah": 56,
          "page": 577,
          "lineStart": 4,
          "lineEnd": 5,
          "textUthmaniRaw": "وَمَا يَذۡكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ هُوَ أَهۡلُ ٱلتَّقۡوَىٰ وَأَهۡلُ ٱلۡمَغۡفِرَةِ ﰷ",
          "textUthmaniBody": "وَمَا يَذۡكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ هُوَ أَهۡلُ ٱلتَّقۡوَىٰ وَأَهۡلُ ٱلۡمَغۡفِرَةِ",
          "textImlaei": "وما يذكرون إلا أن يشاء الله هو أهل التقوى وأهل المغفرة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC37"
        }
      ]
    }
  ]
}
