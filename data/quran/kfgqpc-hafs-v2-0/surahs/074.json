          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 575,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "وَبَنِينَ شُهُودٗا ﰌ",
          "textUthmaniBody": "وَبَنِينَ شُهُودٗا",
          "textImlaei": "وبنين شهودا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 575,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "وَمَهَّدتُّ لَهُۥ تَمۡهِيدٗا ﰍ",
          "textUthmaniBody": "وَمَهَّدتُّ لَهُۥ تَمۡهِيدٗا",
          "textImlaei": "ومهدت له تمهيدا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 575,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "ثُمَّ يَطۡمَعُ أَنۡ أَزِيدَ ﰎ",
          "textUthmaniBody": "ثُمَّ يَطۡمَعُ أَنۡ أَزِيدَ",
          "textImlaei": "ثم يطمع أن أزيد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 575,
          "lineStart": 14,
          "lineEnd": 15,
          "textUthmaniRaw": "كَلَّآۖ إِنَّهُۥ كَانَ لِأٓيَٰتِنَا عَنِيدٗا ﰏ",
          "textUthmaniBody": "كَلَّآۖ إِنَّهُۥ كَانَ لِأٓيَٰتِنَا عَنِيدٗا",
