          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 575,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "وَرَبَّكَ فَكَبِّرۡ ﰂ",
          "textUthmaniBody": "وَرَبَّكَ فَكَبِّرۡ",
          "textImlaei": "وربك فكبر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 575,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "وَثِيَابَكَ فَطَهِّرۡ ﰃ",
          "textUthmaniBody": "وَثِيَابَكَ فَطَهِّرۡ",
          "textImlaei": "وثيابك فطهر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 575,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "وَٱلرُّجۡزَ فَٱهۡجُرۡ ﰄ",
          "textUthmaniBody": "وَٱلرُّجۡزَ فَٱهۡجُرۡ",
          "textImlaei": "والرجز فاهجر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 575,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "وَلَا تَمۡنُن تَسۡتَكۡثِرُ ﰅ",
          "textUthmaniBody": "وَلَا تَمۡنُن تَسۡتَكۡثِرُ",
          "textImlaei": "ولا تمنن تستكثر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 575,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "وَلِرَبِّكَ فَٱصۡبِرۡ ﰆ",
          "textUthmaniBody": "وَلِرَبِّكَ فَٱصۡبِرۡ",
          "textImlaei": "ولربك فاصبر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 575,
          "lineStart": 11,
          "lineEnd": 12,
          "textUthmaniRaw": "فَإِذَا نُقِرَ فِي ٱلنَّاقُورِ ﰇ",
          "textUthmaniBody": "فَإِذَا نُقِرَ فِي ٱلنَّاقُورِ",
          "textImlaei": "فإذا نقر في الناقور",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 575,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "فَذَٰلِكَ يَوۡمَئِذٖ يَوۡمٌ عَسِيرٌ ﰈ",
          "textUthmaniBody": "فَذَٰلِكَ يَوۡمَئِذٖ يَوۡمٌ عَسِيرٌ",
          "textImlaei": "فذلك يومئذ يوم عسير",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 575,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "عَلَى ٱلۡكَٰفِرِينَ غَيۡرُ يَسِيرٖ ﰉ",
          "textUthmaniBody": "عَلَى ٱلۡكَٰفِرِينَ غَيۡرُ يَسِيرٖ",
          "textImlaei": "على الكافرين غير يسير",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 575,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "ذَرۡنِي وَمَنۡ خَلَقۡتُ وَحِيدٗا ﰊ",
          "textUthmaniBody": "ذَرۡنِي وَمَنۡ خَلَقۡتُ وَحِيدٗا",
          "textImlaei": "ذرني ومن خلقت وحيدا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 575,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "وَجَعَلۡتُ لَهُۥ مَالٗا مَّمۡدُودٗا ﰋ",
          "textUthmaniBody": "وَجَعَلۡتُ لَهُۥ مَالٗا مَّمۡدُودٗا",
          "textImlaei": "وجعلت له مالا ممدودا",
