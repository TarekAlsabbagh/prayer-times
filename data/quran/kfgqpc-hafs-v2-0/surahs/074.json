          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 575,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "قُمۡ فَأَنذِرۡ ﰁ",
          "textUthmaniBody": "قُمۡ فَأَنذِرۡ",
          "textImlaei": "قم فأنذر",
