        },
        {
          "ayah": 24,
          "page": 576,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "فَقَالَ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ يُؤۡثَرُ ﰗ",
          "textUthmaniBody": "فَقَالَ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ يُؤۡثَرُ",
          "textImlaei": "فقال إن هذا إلا سحر يؤثر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC17"
        },
        {
          "ayah": 25,
          "page": 576,
          "lineStart": 2,
          "lineEnd": 3,
          "textUthmaniRaw": "إِنۡ هَٰذَآ إِلَّا قَوۡلُ ٱلۡبَشَرِ ﰘ",
          "textUthmaniBody": "إِنۡ هَٰذَآ إِلَّا قَوۡلُ ٱلۡبَشَرِ",
          "textImlaei": "إن هذا إلا قول البشر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC18"
        },
        {
          "ayah": 26,
          "page": 576,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "سَأُصۡلِيهِ سَقَرَ ﰙ",
          "textUthmaniBody": "سَأُصۡلِيهِ سَقَرَ",
          "textImlaei": "سأصليه سقر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC19"
        },
        {
          "ayah": 27,
          "page": 576,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "وَمَآ أَدۡرَىٰكَ مَا سَقَرُ ﰚ",
          "textUthmaniBody": "وَمَآ أَدۡرَىٰكَ مَا سَقَرُ",
          "textImlaei": "وما أدراك ما سقر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1A"
        },
        {
          "ayah": 28,
          "page": 576,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "لَا تُبۡقِي وَلَا تَذَرُ ﰛ",
          "textUthmaniBody": "لَا تُبۡقِي وَلَا تَذَرُ",
          "textImlaei": "لا تبقي ولا تذر",
