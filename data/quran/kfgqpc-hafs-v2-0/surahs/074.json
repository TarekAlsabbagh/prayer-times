          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        },
        {
          "ayah": 17,
          "page": 575,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "سَأُرۡهِقُهُۥ صَعُودًا ﰐ",
          "textUthmaniBody": "سَأُرۡهِقُهُۥ صَعُودًا",
          "textImlaei": "سأرهقه صعودا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        },
        {
          "ayah": 18,
          "page": 575,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "إِنَّهُۥ فَكَّرَ وَقَدَّرَ ﰑ",
          "textUthmaniBody": "إِنَّهُۥ فَكَّرَ وَقَدَّرَ",
          "textImlaei": "إنه فكر وقدر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC11"
        }
      ]
    },
    {
