      "ayahs": [
        {
          "ayah": 1,
          "page": 580,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "وَٱلۡمُرۡسَلَٰتِ عُرۡفٗا ﰀ",
          "textUthmaniBody": "وَٱلۡمُرۡسَلَٰتِ عُرۡفٗا",
          "textImlaei": "والمرسلات عرفا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 580,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "فَٱلۡعَٰصِفَٰتِ عَصۡفٗا ﰁ",
          "textUthmaniBody": "فَٱلۡعَٰصِفَٰتِ عَصۡفٗا",
          "textImlaei": "فالعاصفات عصفا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 580,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "وَٱلنَّٰشِرَٰتِ نَشۡرٗا ﰂ",
          "textUthmaniBody": "وَٱلنَّٰشِرَٰتِ نَشۡرٗا",
          "textImlaei": "والناشرات نشرا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 580,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "فَٱلۡفَٰرِقَٰتِ فَرۡقٗا ﰃ",
          "textUthmaniBody": "فَٱلۡفَٰرِقَٰتِ فَرۡقٗا",
          "textImlaei": "فالفارقات فرقا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 580,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا ﰄ",
          "textUthmaniBody": "فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا",
          "textImlaei": "فالملقيات ذكرا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 580,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "عُذۡرًا أَوۡ نُذۡرًا ﰅ",
          "textUthmaniBody": "عُذۡرًا أَوۡ نُذۡرًا",
          "textImlaei": "عذرا أو نذرا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 580,
          "lineStart": 10,
          "lineEnd": 11,
          "textUthmaniRaw": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٞ ﰆ",
          "textUthmaniBody": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٞ",
          "textImlaei": "إنما توعدون لواقع",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 580,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "فَإِذَا ٱلنُّجُومُ طُمِسَتۡ ﰇ",
          "textUthmaniBody": "فَإِذَا ٱلنُّجُومُ طُمِسَتۡ",
          "textImlaei": "فإذا النجوم طمست",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 580,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ ﰈ",
          "textUthmaniBody": "وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ",
          "textImlaei": "وإذا السماء فرجت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 580,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ ﰉ",
          "textUthmaniBody": "وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ",
          "textImlaei": "وإذا الجبال نسفت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 580,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ ﰊ",
          "textUthmaniBody": "وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ",
          "textImlaei": "وإذا الرسل أقتت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 580,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "لِأَيِّ يَوۡمٍ أُجِّلَتۡ ﰋ",
          "textUthmaniBody": "لِأَيِّ يَوۡمٍ أُجِّلَتۡ",
          "textImlaei": "لأي يوم أجلت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 580,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "لِيَوۡمِ ٱلۡفَصۡلِ ﰌ",
          "textUthmaniBody": "لِيَوۡمِ ٱلۡفَصۡلِ",
          "textImlaei": "ليوم الفصل",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 580,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ ﰍ",
          "textUthmaniBody": "وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ",
          "textImlaei": "وما أدراك ما يوم الفصل",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 580,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰎ",
          "textUthmaniBody": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
          "textImlaei": "ويل يومئذ للمكذبين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 580,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ ﰏ",
          "textUthmaniBody": "أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ",
          "textImlaei": "ألم نهلك الأولين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        },
        {
          "ayah": 17,
          "page": 580,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ ﰐ",
          "textUthmaniBody": "ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ",
          "textImlaei": "ثم نتبعهم الآخرين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        },
        {
          "ayah": 18,
          "page": 580,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ ﰑ",
          "textUthmaniBody": "كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ",
          "textImlaei": "كذلك نفعل بالمجرمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC11"
        },
        {
          "ayah": 19,
          "page": 580,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰒ",
          "textUthmaniBody": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
          "textImlaei": "ويل يومئذ للمكذبين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC12"
        }
      ]
    },
    {
      "page": 581,
      "juz": 29,
      "ayahs": [
        {
          "ayah": 20,
          "page": 581,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "أَلَمۡ نَخۡلُقكُّم مِّن مَّآءٖ مَّهِينٖ ﰓ",
          "textUthmaniBody": "أَلَمۡ نَخۡلُقكُّم مِّن مَّآءٖ مَّهِينٖ",
          "textImlaei": "ألم نخلقكم من ماء مهين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC13"
        },
        {
          "ayah": 21,
          "page": 581,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "فَجَعَلۡنَٰهُ فِي قَرَارٖ مَّكِينٍ ﰔ",
          "textUthmaniBody": "فَجَعَلۡنَٰهُ فِي قَرَارٖ مَّكِينٍ",
          "textImlaei": "فجعلناه في قرار مكين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC14"
        },
        {
          "ayah": 22,
          "page": 581,
          "lineStart": 1,
          "lineEnd": 2,
          "textUthmaniRaw": "إِلَىٰ قَدَرٖ مَّعۡلُومٖ ﰕ",
          "textUthmaniBody": "إِلَىٰ قَدَرٖ مَّعۡلُومٖ",
          "textImlaei": "إلى قدر معلوم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC15"
        },
        {
          "ayah": 23,
          "page": 581,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ ﰖ",
          "textUthmaniBody": "فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ",
          "textImlaei": "فقدرنا فنعم القادرون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC16"
        },
        {
          "ayah": 24,
          "page": 581,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰗ",
          "textUthmaniBody": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
          "textImlaei": "ويل يومئذ للمكذبين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC17"
        },
        {
          "ayah": 25,
          "page": 581,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا ﰘ",
          "textUthmaniBody": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا",
          "textImlaei": "ألم نجعل الأرض كفاتا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC18"
        },
        {
          "ayah": 26,
          "page": 581,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "أَحۡيَآءٗ وَأَمۡوَٰتٗا ﰙ",
          "textUthmaniBody": "أَحۡيَآءٗ وَأَمۡوَٰتٗا",
          "textImlaei": "أحياء وأمواتا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC19"
        },
        {
          "ayah": 27,
          "page": 581,
          "lineStart": 3,
          "lineEnd": 4,
          "textUthmaniRaw": "وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسۡقَيۡنَٰكُم مَّآءٗ فُرَاتٗا ﰚ",
          "textUthmaniBody": "وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسۡقَيۡنَٰكُم مَّآءٗ فُرَاتٗا",
          "textImlaei": "وجعلنا فيها رواسي شامخات وأسقيناكم ماء فراتا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1A"
        },
        {
          "ayah": 28,
          "page": 581,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰛ",
          "textUthmaniBody": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
          "textImlaei": "ويل يومئذ للمكذبين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1B"
        },
        {
          "ayah": 29,
          "page": 581,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ ﰜ",
          "textUthmaniBody": "ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
          "textImlaei": "انطلقوا إلى ما كنتم به تكذبون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1C"
        },
        {
          "ayah": 30,
          "page": 581,
          "lineStart": 5,
          "lineEnd": 6,
          "textUthmaniRaw": "ٱنطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِي ثَلَٰثِ شُعَبٖ ﰝ",
          "textUthmaniBody": "ٱنطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِي ثَلَٰثِ شُعَبٖ",
          "textImlaei": "انطلقوا إلى ظل ذي ثلاث شعب",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1D"
        },
        {
          "ayah": 31,
          "page": 581,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "لَّا ظَلِيلٖ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ ﰞ",
          "textUthmaniBody": "لَّا ظَلِيلٖ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ",
          "textImlaei": "لا ظليل ولا يغني من اللهب",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1E"
        },
        {
          "ayah": 32,
          "page": 581,
          "lineStart": 6,
          "lineEnd": 7,
          "textUthmaniRaw": "إِنَّهَا تَرۡمِي بِشَرَرٖ كَٱلۡقَصۡرِ ﰟ",
          "textUthmaniBody": "إِنَّهَا تَرۡمِي بِشَرَرٖ كَٱلۡقَصۡرِ",
          "textImlaei": "إنها ترمي بشرر كالقصر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1F"
        },
        {
          "ayah": 33,
          "page": 581,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "كَأَنَّهُۥ جِمَٰلَتٞ صُفۡرٞ ﰠ",
          "textUthmaniBody": "كَأَنَّهُۥ جِمَٰلَتٞ صُفۡرٞ",
          "textImlaei": "كأنه جمالة صفر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC20"
        },
        {
          "ayah": 34,
          "page": 581,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰡ",
          "textUthmaniBody": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
          "textImlaei": "ويل يومئذ للمكذبين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC21"
        },
        {
          "ayah": 35,
          "page": 581,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "هَٰذَا يَوۡمُ لَا يَنطِقُونَ ﰢ",
          "textUthmaniBody": "هَٰذَا يَوۡمُ لَا يَنطِقُونَ",
          "textImlaei": "هذا يوم لا ينطقون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC22"
        },
        {
          "ayah": 36,
          "page": 581,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ ﰣ",
          "textUthmaniBody": "وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ",
          "textImlaei": "ولا يؤذن لهم فيعتذرون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC23"
        },
        {
          "ayah": 37,
          "page": 581,
          "lineStart": 8,
          "lineEnd": 9,
          "textUthmaniRaw": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰤ",
          "textUthmaniBody": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
          "textImlaei": "ويل يومئذ للمكذبين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC24"
        },
        {
          "ayah": 38,
          "page": 581,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَٱلۡأَوَّلِينَ ﰥ",
          "textUthmaniBody": "هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَٱلۡأَوَّلِينَ",
          "textImlaei": "هذا يوم الفصل جمعناكم والأولين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC25"
        },
        {
          "ayah": 39,
          "page": 581,
          "lineStart": 9,
          "lineEnd": 10,
          "textUthmaniRaw": "فَإِن كَانَ لَكُمۡ كَيۡدٞ فَكِيدُونِ ﰦ",
          "textUthmaniBody": "فَإِن كَانَ لَكُمۡ كَيۡدٞ فَكِيدُونِ",
          "textImlaei": "فإن كان لكم كيد فكيدون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC26"
        },
        {
          "ayah": 40,
          "page": 581,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰧ",
          "textUthmaniBody": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
          "textImlaei": "ويل يومئذ للمكذبين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC27"
        },
        {
          "ayah": 41,
          "page": 581,
          "lineStart": 10,
          "lineEnd": 11,
          "textUthmaniRaw": "إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلٖ وَعُيُونٖ ﰨ",
          "textUthmaniBody": "إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلٖ وَعُيُونٖ",
          "textImlaei": "إن المتقين في ظلال وعيون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC28"
        },
        {
          "ayah": 42,
          "page": 581,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ ﰩ",
          "textUthmaniBody": "وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ",
          "textImlaei": "وفواكه مما يشتهون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC29"
        },
        {
          "ayah": 43,
          "page": 581,
          "lineStart": 11,
          "lineEnd": 12,
          "textUthmaniRaw": "كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ ﰪ",
          "textUthmaniBody": "كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ",
          "textImlaei": "كلوا واشربوا هنيئا بما كنتم تعملون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2A"
        },
        {
          "ayah": 44,
          "page": 581,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ ﰫ",
          "textUthmaniBody": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",
          "textImlaei": "إنا كذلك نجزي المحسنين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2B"
        },
        {
          "ayah": 45,
          "page": 581,
          "lineStart": 12,
          "lineEnd": 13,
          "textUthmaniRaw": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰬ",
          "textUthmaniBody": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
          "textImlaei": "ويل يومئذ للمكذبين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2C"
        },
        {
          "ayah": 46,
          "page": 581,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ ﰭ",
          "textUthmaniBody": "كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ",
          "textImlaei": "كلوا وتمتعوا قليلا إنكم مجرمون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2D"
        },
        {
          "ayah": 47,
          "page": 581,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰮ",
          "textUthmaniBody": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
          "textImlaei": "ويل يومئذ للمكذبين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2E"
        },
        {
          "ayah": 48,
          "page": 581,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ ﰯ",
          "textUthmaniBody": "وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ",
          "textImlaei": "وإذا قيل لهم اركعوا لا يركعون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC2F"
        },
        {
          "ayah": 49,
          "page": 581,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ ﰰ",
          "textUthmaniBody": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
          "textImlaei": "ويل يومئذ للمكذبين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC30"
        },
        {
          "ayah": 50,
          "page": 581,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ ﰱ",
          "textUthmaniBody": "فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ",
          "textImlaei": "فبأي حديث بعده يؤمنون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC31"
        }
      ]
    }
  ]
}
