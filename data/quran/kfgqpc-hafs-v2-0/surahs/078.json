        {
          "ayah": 1,
          "page": 582,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "عَمَّ يَتَسَآءَلُونَ ﰀ",
          "textUthmaniBody": "عَمَّ يَتَسَآءَلُونَ",
          "textImlaei": "عم يتساءلون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 582,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ ﰁ",
          "textUthmaniBody": "عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ",
          "textImlaei": "عن النبإ العظيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 582,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ ﰂ",
          "textUthmaniBody": "ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ",
          "textImlaei": "الذي هم فيه مختلفون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 582,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "كَلَّا سَيَعۡلَمُونَ ﰃ",
          "textUthmaniBody": "كَلَّا سَيَعۡلَمُونَ",
          "textImlaei": "كلا سيعلمون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 582,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "ثُمَّ كَلَّا سَيَعۡلَمُونَ ﰄ",
          "textUthmaniBody": "ثُمَّ كَلَّا سَيَعۡلَمُونَ",
          "textImlaei": "ثم كلا سيعلمون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 582,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا ﰅ",
          "textUthmaniBody": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا",
          "textImlaei": "ألم نجعل الأرض مهادا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 582,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَٱلۡجِبَالَ أَوۡتَادٗا ﰆ",
          "textUthmaniBody": "وَٱلۡجِبَالَ أَوۡتَادٗا",
          "textImlaei": "والجبال أوتادا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 582,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا ﰇ",
          "textUthmaniBody": "وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا",
          "textImlaei": "وخلقناكم أزواجا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 582,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا ﰈ",
          "textUthmaniBody": "وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا",
          "textImlaei": "وجعلنا نومكم سباتا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 582,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا ﰉ",
          "textUthmaniBody": "وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا",
          "textImlaei": "وجعلنا الليل لباسا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 582,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا ﰊ",
          "textUthmaniBody": "وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا",
          "textImlaei": "وجعلنا النهار معاشا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 582,
          "lineStart": 6,
          "lineEnd": 7,
          "textUthmaniRaw": "وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا ﰋ",
          "textUthmaniBody": "وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا",
          "textImlaei": "وبنينا فوقكم سبعا شدادا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 582,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا ﰌ",
          "textUthmaniBody": "وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا",
          "textImlaei": "وجعلنا سراجا وهاجا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 582,
          "lineStart": 7,
          "lineEnd": 8,
          "textUthmaniRaw": "وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا ﰍ",
          "textUthmaniBody": "وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا",
          "textImlaei": "وأنزلنا من المعصرات ماء ثجاجا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 582,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا ﰎ",
          "textUthmaniBody": "لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا",
          "textImlaei": "لنخرج به حبا ونباتا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 582,
          "lineStart": 8,
          "lineEnd": 9,
          "textUthmaniRaw": "وَجَنَّٰتٍ أَلۡفَافًا ﰏ",
          "textUthmaniBody": "وَجَنَّٰتٍ أَلۡفَافًا",
          "textImlaei": "وجنات ألفافا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        },
        {
          "ayah": 17,
          "page": 582,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا ﰐ",
          "textUthmaniBody": "إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا",
          "textImlaei": "إن يوم الفصل كان ميقاتا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        },
        {
          "ayah": 18,
          "page": 582,
          "lineStart": 9,
          "lineEnd": 10,
          "textUthmaniRaw": "يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا ﰑ",
          "textUthmaniBody": "يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا",
          "textImlaei": "يوم ينفخ في الصور فتأتون أفواجا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC11"
        },
        {
          "ayah": 19,
          "page": 582,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا ﰒ",
          "textUthmaniBody": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا",
          "textImlaei": "وفتحت السماء فكانت أبوابا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC12"
        },
        {
          "ayah": 20,
          "page": 582,
          "lineStart": 10,
          "lineEnd": 11,
          "textUthmaniRaw": "وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا ﰓ",
          "textUthmaniBody": "وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا",
          "textImlaei": "وسيرت الجبال فكانت سرابا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC13"
        },
        {
          "ayah": 21,
          "page": 582,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا ﰔ",
          "textUthmaniBody": "إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا",
          "textImlaei": "إن جهنم كانت مرصادا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC14"
        },
        {
          "ayah": 22,
          "page": 582,
          "lineStart": 11,
          "lineEnd": 12,
          "textUthmaniRaw": "لِّلطَّٰغِينَ مَـَٔابٗا ﰕ",
          "textUthmaniBody": "لِّلطَّٰغِينَ مَـَٔابٗا",
          "textImlaei": "للطاغين مآبا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC15"
        },
        {
          "ayah": 23,
          "page": 582,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "لَّٰبِثِينَ فِيهَآ أَحۡقَابٗا ﰖ",
          "textUthmaniBody": "لَّٰبِثِينَ فِيهَآ أَحۡقَابٗا",
          "textImlaei": "لابثين فيها أحقابا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC16"
        },
        {
          "ayah": 24,
          "page": 582,
          "lineStart": 12,
          "lineEnd": 13,
          "textUthmaniRaw": "لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا ﰗ",
          "textUthmaniBody": "لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا",
          "textImlaei": "لا يذوقون فيها بردا ولا شرابا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC17"
        },
        {
          "ayah": 25,
          "page": 582,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "إِلَّا حَمِيمٗا وَغَسَّاقٗا ﰘ",
          "textUthmaniBody": "إِلَّا حَمِيمٗا وَغَسَّاقٗا",
          "textImlaei": "إلا حميما وغساقا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC18"
        },
        {
          "ayah": 26,
          "page": 582,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "جَزَآءٗ وِفَاقًا ﰙ",
          "textUthmaniBody": "جَزَآءٗ وِفَاقًا",
          "textImlaei": "جزاء وفاقا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC19"
        },
        {
          "ayah": 27,
          "page": 582,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا ﰚ",
          "textUthmaniBody": "إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا",
          "textImlaei": "إنهم كانوا لا يرجون حسابا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1A"
        },
        {
          "ayah": 28,
          "page": 582,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا ﰛ",
          "textUthmaniBody": "وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا",
          "textImlaei": "وكذبوا بآياتنا كذابا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1B"
        },
        {
          "ayah": 29,
          "page": 582,
          "lineStart": 14,
          "lineEnd": 15,
          "textUthmaniRaw": "وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا ﰜ",
          "textUthmaniBody": "وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا",
          "textImlaei": "وكل شيء أحصيناه كتابا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1C"
        },
        {
          "ayah": 30,
          "page": 582,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا ﰝ",
          "textUthmaniBody": "فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا",
          "textImlaei": "فذوقوا فلن نزيدكم إلا عذابا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1D"
        }
      ]
    },
    {
      "page": 583,
      "juz": 30,
      "ayahs": [
        {
          "ayah": 31,
          "page": 583,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "إِنَّ لِلۡمُتَّقِينَ مَفَازًا ﰞ",
          "textUthmaniBody": "إِنَّ لِلۡمُتَّقِينَ مَفَازًا",
          "textImlaei": "إن للمتقين مفازا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1E"
        },
        {
          "ayah": 32,
          "page": 583,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "حَدَآئِقَ وَأَعۡنَٰبٗا ﰟ",
          "textUthmaniBody": "حَدَآئِقَ وَأَعۡنَٰبٗا",
          "textImlaei": "حدائق وأعنابا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1F"
        },
        {
          "ayah": 33,
          "page": 583,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "وَكَوَاعِبَ أَتۡرَابٗا ﰠ",
          "textUthmaniBody": "وَكَوَاعِبَ أَتۡرَابٗا",
          "textImlaei": "وكواعب أترابا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC20"
        },
        {
          "ayah": 34,
          "page": 583,
          "lineStart": 1,
          "lineEnd": 2,
          "textUthmaniRaw": "وَكَأۡسٗا دِهَاقٗا ﰡ",
          "textUthmaniBody": "وَكَأۡسٗا دِهَاقٗا",
          "textImlaei": "وكأسا دهاقا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC21"
        },
        {
          "ayah": 35,
          "page": 583,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّٰبٗا ﰢ",
          "textUthmaniBody": "لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّٰبٗا",
          "textImlaei": "لا يسمعون فيها لغوا ولا كذابا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC22"
        },
        {
          "ayah": 36,
          "page": 583,
          "lineStart": 2,
          "lineEnd": 3,
          "textUthmaniRaw": "جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا ﰣ",
          "textUthmaniBody": "جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا",
          "textImlaei": "جزاء من ربك عطاء حسابا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC23"
        },
        {
          "ayah": 37,
          "page": 583,
          "lineStart": 3,
          "lineEnd": 4,
          "textUthmaniRaw": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا ﰤ",
          "textUthmaniBody": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا",
          "textImlaei": "رب السموات والأرض وما بينهما الرحمن لا يملكون منه خطابا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC24"
        },
        {
          "ayah": 38,
          "page": 583,
          "lineStart": 4,
          "lineEnd": 5,
