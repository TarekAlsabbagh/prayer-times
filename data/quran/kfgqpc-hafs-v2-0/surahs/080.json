      "ayahs": [
        {
          "ayah": 1,
          "page": 585,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "عَبَسَ وَتَوَلَّىٰٓ ﰀ",
          "textUthmaniBody": "عَبَسَ وَتَوَلَّىٰٓ",
          "textImlaei": "عبس وتولى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 585,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "أَن جَآءَهُ ٱلۡأَعۡمَىٰ ﰁ",
          "textUthmaniBody": "أَن جَآءَهُ ٱلۡأَعۡمَىٰ",
          "textImlaei": "أن جاءه الأعمى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 585,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ ﰂ",
          "textUthmaniBody": "وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
          "textImlaei": "وما يدريك لعله يزكى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 585,
          "lineStart": 3,
          "lineEnd": 4,
          "textUthmaniRaw": "أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ ﰃ",
          "textUthmaniBody": "أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ",
          "textImlaei": "أو يذكر فتنفعه الذكرى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 585,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "أَمَّا مَنِ ٱسۡتَغۡنَىٰ ﰄ",
          "textUthmaniBody": "أَمَّا مَنِ ٱسۡتَغۡنَىٰ",
          "textImlaei": "أما من استغنى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 585,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "فَأَنتَ لَهُۥ تَصَدَّىٰ ﰅ",
          "textUthmaniBody": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
          "textImlaei": "فأنت له تصدى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 585,
          "lineStart": 4,
          "lineEnd": 5,
          "textUthmaniRaw": "وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ ﰆ",
          "textUthmaniBody": "وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ",
          "textImlaei": "وما عليك ألا يزكى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 585,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ ﰇ",
          "textUthmaniBody": "وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ",
          "textImlaei": "وأما من جاءك يسعى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 585,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَهُوَ يَخۡشَىٰ ﰈ",
          "textUthmaniBody": "وَهُوَ يَخۡشَىٰ",
          "textImlaei": "وهو يخشى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 585,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "فَأَنتَ عَنۡهُ تَلَهَّىٰ ﰉ",
          "textUthmaniBody": "فَأَنتَ عَنۡهُ تَلَهَّىٰ",
          "textImlaei": "فأنت عنه تلهى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 585,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "كَلَّآ إِنَّهَا تَذۡكِرَةٞ ﰊ",
          "textUthmaniBody": "كَلَّآ إِنَّهَا تَذۡكِرَةٞ",
          "textImlaei": "كلا إنها تذكرة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 585,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "فَمَن شَآءَ ذَكَرَهُۥ ﰋ",
          "textUthmaniBody": "فَمَن شَآءَ ذَكَرَهُۥ",
          "textImlaei": "فمن شاء ذكره",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 585,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "فِي صُحُفٖ مُّكَرَّمَةٖ ﰌ",
          "textUthmaniBody": "فِي صُحُفٖ مُّكَرَّمَةٖ",
          "textImlaei": "في صحف مكرمة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 585,
          "lineStart": 6,
          "lineEnd": 7,
          "textUthmaniRaw": "مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ ﰍ",
          "textUthmaniBody": "مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ",
          "textImlaei": "مرفوعة مطهرة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 585,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "بِأَيۡدِي سَفَرَةٖ ﰎ",
          "textUthmaniBody": "بِأَيۡدِي سَفَرَةٖ",
          "textImlaei": "بأيدي سفرة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 585,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "كِرَامِۭ بَرَرَةٖ ﰏ",
          "textUthmaniBody": "كِرَامِۭ بَرَرَةٖ",
          "textImlaei": "كرام بررة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        },
        {
          "ayah": 17,
          "page": 585,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ ﰐ",
          "textUthmaniBody": "قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ",
          "textImlaei": "قتل الإنسان ما أكفره",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        },
        {
          "ayah": 18,
          "page": 585,
          "lineStart": 7,
          "lineEnd": 8,
          "textUthmaniRaw": "مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ ﰑ",
          "textUthmaniBody": "مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ",
          "textImlaei": "من أي شيء خلقه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC11"
        },
        {
          "ayah": 19,
          "page": 585,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ﰒ",
          "textUthmaniBody": "مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
          "textImlaei": "من نطفة خلقه فقدره",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC12"
        },
        {
          "ayah": 20,
          "page": 585,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ ﰓ",
          "textUthmaniBody": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
          "textImlaei": "ثم السبيل يسره",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC13"
        },
        {
          "ayah": 21,
          "page": 585,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ ﰔ",
          "textUthmaniBody": "ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ",
          "textImlaei": "ثم أماته فأقبره",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC14"
        },
        {
          "ayah": 22,
          "page": 585,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ ﰕ",
          "textUthmaniBody": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
          "textImlaei": "ثم إذا شاء أنشره",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC15"
        },
        {
          "ayah": 23,
          "page": 585,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ ﰖ",
          "textUthmaniBody": "كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ",
          "textImlaei": "كلا لما يقض ما أمره",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC16"
        },
        {
          "ayah": 24,
          "page": 585,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ ﰗ",
          "textUthmaniBody": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ",
          "textImlaei": "فلينظر الإنسان إلى طعامه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC17"
        },
        {
          "ayah": 25,
          "page": 585,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا ﰘ",
          "textUthmaniBody": "أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا",
          "textImlaei": "أنا صببنا الماء صبا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC18"
        },
        {
          "ayah": 26,
          "page": 585,
          "lineStart": 10,
          "lineEnd": 11,
          "textUthmaniRaw": "ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا ﰙ",
          "textUthmaniBody": "ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا",
          "textImlaei": "ثم شققنا الأرض شقا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC19"
        },
        {
          "ayah": 27,
          "page": 585,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "فَأَنۢبَتۡنَا فِيهَا حَبّٗا ﰚ",
          "textUthmaniBody": "فَأَنۢبَتۡنَا فِيهَا حَبّٗا",
          "textImlaei": "فأنبتنا فيها حبا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1A"
        },
        {
          "ayah": 28,
          "page": 585,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "وَعِنَبٗا وَقَضۡبٗا ﰛ",
          "textUthmaniBody": "وَعِنَبٗا وَقَضۡبٗا",
          "textImlaei": "وعنبا وقضبا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1B"
        },
        {
          "ayah": 29,
          "page": 585,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "وَزَيۡتُونٗا وَنَخۡلٗا ﰜ",
          "textUthmaniBody": "وَزَيۡتُونٗا وَنَخۡلٗا",
          "textImlaei": "وزيتونا ونخلا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1C"
        },
        {
          "ayah": 30,
          "page": 585,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَحَدَآئِقَ غُلۡبٗا ﰝ",
          "textUthmaniBody": "وَحَدَآئِقَ غُلۡبٗا",
          "textImlaei": "وحدائق غلبا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1D"
        },
        {
          "ayah": 31,
          "page": 585,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَفَٰكِهَةٗ وَأَبّٗا ﰞ",
          "textUthmaniBody": "وَفَٰكِهَةٗ وَأَبّٗا",
          "textImlaei": "وفاكهة وأبا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1E"
        },
        {
          "ayah": 32,
          "page": 585,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ ﰟ",
          "textUthmaniBody": "مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ",
          "textImlaei": "متاعا لكم ولأنعامكم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1F"
        },
        {
          "ayah": 33,
          "page": 585,
          "lineStart": 12,
          "lineEnd": 13,
          "textUthmaniRaw": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ ﰠ",
          "textUthmaniBody": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
          "textImlaei": "فإذا جاءت الصاخة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC20"
        },
        {
          "ayah": 34,
          "page": 585,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ ﰡ",
          "textUthmaniBody": "يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ",
          "textImlaei": "يوم يفر المرء من أخيه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC21"
        },
        {
          "ayah": 35,
          "page": 585,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "وَأُمِّهِۦ وَأَبِيهِ ﰢ",
          "textUthmaniBody": "وَأُمِّهِۦ وَأَبِيهِ",
          "textImlaei": "وأمه وأبيه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC22"
        },
        {
          "ayah": 36,
          "page": 585,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "وَصَٰحِبَتِهِۦ وَبَنِيهِ ﰣ",
          "textUthmaniBody": "وَصَٰحِبَتِهِۦ وَبَنِيهِ",
          "textImlaei": "وصاحبته وبنيه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC23"
        },
        {
          "ayah": 37,
          "page": 585,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ ﰤ",
          "textUthmaniBody": "لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ",
          "textImlaei": "لكل امرئ منهم يومئذ شأن يغنيه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC24"
        },
        {
          "ayah": 38,
          "page": 585,
          "lineStart": 14,
          "lineEnd": 15,
          "textUthmaniRaw": "وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ ﰥ",
          "textUthmaniBody": "وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ",
          "textImlaei": "وجوه يومئذ مسفرة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC25"
        },
        {
          "ayah": 39,
          "page": 585,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ ﰦ",
          "textUthmaniBody": "ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ",
          "textImlaei": "ضاحكة مستبشرة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC26"
        },
        {
          "ayah": 40,
          "page": 585,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ ﰧ",
          "textUthmaniBody": "وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ",
          "textImlaei": "ووجوه يومئذ عليها غبرة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC27"
        }
      ]
    },
    {
      "page": 586,
      "juz": 30,
      "ayahs": [
        {
