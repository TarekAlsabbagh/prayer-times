{
  "surah": 81,
  "nameAr": "التَّكوير",
  "nameEn": "At-Takwīr",
  "ayahCount": 29,
  "firstPage": 586,
  "lastPage": 586,
  "pageCount": 1,
  "juz": [
    30
  ],
  "basmalaMode": "separate",
  "pages": [
    {
      "page": 586,
      "juz": 30,
      "ayahs": [
        {
          "ayah": 1,
          "page": 586,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "إِذَا ٱلشَّمۡسُ كُوِّرَتۡ ﰀ",
          "textUthmaniBody": "إِذَا ٱلشَّمۡسُ كُوِّرَتۡ",
          "textImlaei": "إذا الشمس كورت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 586,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ ﰁ",
          "textUthmaniBody": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ",
          "textImlaei": "وإذا النجوم انكدرت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 586,
          "lineStart": 4,
          "lineEnd": 5,
          "textUthmaniRaw": "وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ ﰂ",
          "textUthmaniBody": "وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ",
          "textImlaei": "وإذا الجبال سيرت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 586,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ ﰃ",
          "textUthmaniBody": "وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ",
          "textImlaei": "وإذا العشار عطلت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 586,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ ﰄ",
          "textUthmaniBody": "وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ",
          "textImlaei": "وإذا الوحوش حشرت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 586,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ ﰅ",
          "textUthmaniBody": "وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ",
          "textImlaei": "وإذا البحار سجرت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 586,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ ﰆ",
          "textUthmaniBody": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ",
          "textImlaei": "وإذا النفوس زوجت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 586,
          "lineStart": 6,
          "lineEnd": 7,
          "textUthmaniRaw": "وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ ﰇ",
          "textUthmaniBody": "وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ",
          "textImlaei": "وإذا الموءودة سئلت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 586,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "بِأَيِّ ذَنۢبٖ قُتِلَتۡ ﰈ",
          "textUthmaniBody": "بِأَيِّ ذَنۢبٖ قُتِلَتۡ",
          "textImlaei": "بأي ذنب قتلت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 586,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "وَإِذَا ٱلصُّحُفُ نُشِرَتۡ ﰉ",
          "textUthmaniBody": "وَإِذَا ٱلصُّحُفُ نُشِرَتۡ",
          "textImlaei": "وإذا الصحف نشرت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 586,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ ﰊ",
          "textUthmaniBody": "وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ",
          "textImlaei": "وإذا السماء كشطت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 586,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ ﰋ",
          "textUthmaniBody": "وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ",
          "textImlaei": "وإذا الجحيم سعرت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 586,
          "lineStart": 8,
          "lineEnd": 9,
          "textUthmaniRaw": "وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ ﰌ",
          "textUthmaniBody": "وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ",
          "textImlaei": "وإذا الجنة أزلفت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 586,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ ﰍ",
          "textUthmaniBody": "عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ",
          "textImlaei": "علمت نفس ما أحضرت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 586,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ ﰎ",
          "textUthmaniBody": "فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ",
          "textImlaei": "فلا أقسم بالخنس",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 586,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "ٱلۡجَوَارِ ٱلۡكُنَّسِ ﰏ",
          "textUthmaniBody": "ٱلۡجَوَارِ ٱلۡكُنَّسِ",
          "textImlaei": "الجوار الكنس",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        },
        {
          "ayah": 17,
          "page": 586,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "وَٱلَّيۡلِ إِذَا عَسۡعَسَ ﰐ",
          "textUthmaniBody": "وَٱلَّيۡلِ إِذَا عَسۡعَسَ",
          "textImlaei": "والليل إذا عسعس",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        },
        {
          "ayah": 18,
          "page": 586,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "وَٱلصُّبۡحِ إِذَا تَنَفَّسَ ﰑ",
          "textUthmaniBody": "وَٱلصُّبۡحِ إِذَا تَنَفَّسَ",
          "textImlaei": "والصبح إذا تنفس",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC11"
        },
        {
          "ayah": 19,
          "page": 586,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ ﰒ",
          "textUthmaniBody": "إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ",
          "textImlaei": "إنه لقول رسول كريم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC12"
        },
        {
          "ayah": 20,
          "page": 586,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ ﰓ",
          "textUthmaniBody": "ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ",
          "textImlaei": "ذي قوة عند ذي العرش مكين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC13"
        },
        {
          "ayah": 21,
          "page": 586,
          "lineStart": 11,
          "lineEnd": 12,
          "textUthmaniRaw": "مُّطَاعٖ ثَمَّ أَمِينٖ ﰔ",
          "textUthmaniBody": "مُّطَاعٖ ثَمَّ أَمِينٖ",
          "textImlaei": "مطاع ثم أمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC14"
        },
        {
          "ayah": 22,
          "page": 586,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَمَا صَاحِبُكُم بِمَجۡنُونٖ ﰕ",
          "textUthmaniBody": "وَمَا صَاحِبُكُم بِمَجۡنُونٖ",
          "textImlaei": "وما صاحبكم بمجنون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC15"
        },
        {
          "ayah": 23,
          "page": 586,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ ﰖ",
          "textUthmaniBody": "وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ",
          "textImlaei": "ولقد رآه بالأفق المبين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC16"
        },
        {
          "ayah": 24,
          "page": 586,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينٖ ﰗ",
          "textUthmaniBody": "وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينٖ",
          "textImlaei": "وما هو على الغيب بضنين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC17"
        },
        {
          "ayah": 25,
          "page": 586,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ ﰘ",
          "textUthmaniBody": "وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ",
          "textImlaei": "وما هو بقول شيطان رجيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC18"
        },
        {
          "ayah": 26,
          "page": 586,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "فَأَيۡنَ تَذۡهَبُونَ ﰙ",
          "textUthmaniBody": "فَأَيۡنَ تَذۡهَبُونَ",
          "textImlaei": "فأين تذهبون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC19"
        },
        {
          "ayah": 27,
          "page": 586,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ ﰚ",
          "textUthmaniBody": "إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ",
          "textImlaei": "إن هو إلا ذكر للعالمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1A"
        },
        {
          "ayah": 28,
          "page": 586,
          "lineStart": 14,
          "lineEnd": 15,
          "textUthmaniRaw": "لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ ﰛ",
          "textUthmaniBody": "لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ",
          "textImlaei": "لمن شاء منكم أن يستقيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1B"
        },
        {
          "ayah": 29,
          "page": 586,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ ﰜ",
          "textUthmaniBody": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ",
          "textImlaei": "وما تشاءون إلا أن يشاء الله رب العالمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1C"
        }
      ]
    }
  ]
}
