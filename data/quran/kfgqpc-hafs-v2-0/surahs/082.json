  "basmalaMode": "separate",
  "pages": [
    {
      "page": 587,
      "juz": 30,
      "ayahs": [
        {
          "ayah": 1,
          "page": 587,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ ﰀ",
          "textUthmaniBody": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ",
          "textImlaei": "إذا السماء انفطرت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 587,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ ﰁ",
          "textUthmaniBody": "وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ",
          "textImlaei": "وإذا الكواكب انتثرت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 587,
          "lineStart": 3,
          "lineEnd": 4,
          "textUthmaniRaw": "وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ ﰂ",
          "textUthmaniBody": "وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ",
          "textImlaei": "وإذا البحار فجرت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 587,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ ﰃ",
          "textUthmaniBody": "وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ",
          "textImlaei": "وإذا القبور بعثرت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 587,
          "lineStart": 4,
          "lineEnd": 5,
          "textUthmaniRaw": "عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ ﰄ",
          "textUthmaniBody": "عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ",
          "textImlaei": "علمت نفس ما قدمت وأخرت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 587,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ ﰅ",
          "textUthmaniBody": "يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ",
          "textImlaei": "ياأيها الإنسان ما غرك بربك الكريم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 587,
          "lineStart": 5,
          "lineEnd": 6,
          "textUthmaniRaw": "ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ ﰆ",
          "textUthmaniBody": "ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
          "textImlaei": "الذي خلقك فسواك فعدلك",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 587,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ ﰇ",
          "textUthmaniBody": "فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ",
          "textImlaei": "في أي صورة ما شاء ركبك",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 587,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ ﰈ",
          "textUthmaniBody": "كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ",
          "textImlaei": "كلا بل تكذبون بالدين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 587,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ ﰉ",
          "textUthmaniBody": "وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ",
          "textImlaei": "وإن عليكم لحافظين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 587,
          "lineStart": 7,
          "lineEnd": 8,
          "textUthmaniRaw": "كِرَامٗا كَٰتِبِينَ ﰊ",
          "textUthmaniBody": "كِرَامٗا كَٰتِبِينَ",
          "textImlaei": "كراما كاتبين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 587,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "يَعۡلَمُونَ مَا تَفۡعَلُونَ ﰋ",
          "textUthmaniBody": "يَعۡلَمُونَ مَا تَفۡعَلُونَ",
          "textImlaei": "يعلمون ما تفعلون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 587,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ ﰌ",
          "textUthmaniBody": "إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ",
          "textImlaei": "إن الأبرار لفي نعيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 587,
          "lineStart": 8,
          "lineEnd": 9,
          "textUthmaniRaw": "وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ ﰍ",
          "textUthmaniBody": "وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ",
          "textImlaei": "وإن الفجار لفي جحيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 587,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ ﰎ",
          "textUthmaniBody": "يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ",
          "textImlaei": "يصلونها يوم الدين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 587,
          "lineStart": 9,
          "lineEnd": 10,
          "textUthmaniRaw": "وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ ﰏ",
          "textUthmaniBody": "وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ",
          "textImlaei": "وما هم عنها بغائبين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        },
        {
          "ayah": 17,
          "page": 587,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ ﰐ",
          "textUthmaniBody": "وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ",
          "textImlaei": "وما أدراك ما يوم الدين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        },
        {
          "ayah": 18,
          "page": 587,
          "lineStart": 10,
          "lineEnd": 11,
          "textUthmaniRaw": "ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ ﰑ",
          "textUthmaniBody": "ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ",
          "textImlaei": "ثم ما أدراك ما يوم الدين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC11"
        },
        {
          "ayah": 19,
          "page": 587,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "يَوۡمَ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ ﰒ",
          "textUthmaniBody": "يَوۡمَ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ",
          "textImlaei": "يوم لا تملك نفس لنفس شيئا والأمر يومئذ لله",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC12"
        }
      ]
    }
  ]
}
