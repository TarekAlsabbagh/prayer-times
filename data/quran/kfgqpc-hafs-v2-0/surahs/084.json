{
  "surah": 84,
  "nameAr": "الانشِقَاق",
  "nameEn": "Al-Inshiqāq",
  "ayahCount": 25,
  "firstPage": 589,
  "lastPage": 590,
  "pageCount": 2,
  "juz": [
