  "basmalaMode": "separate",
  "pages": [
    {
      "page": 589,
      "juz": 30,
      "ayahs": [
        {
          "ayah": 1,
          "page": 589,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ ﰀ",
          "textUthmaniBody": "إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ",
          "textImlaei": "إذا السماء انشقت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 589,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ ﰁ",
          "textUthmaniBody": "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ",
          "textImlaei": "وأذنت لربها وحقت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 589,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ ﰂ",
          "textUthmaniBody": "وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ",
          "textImlaei": "وإذا الأرض مدت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 589,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ ﰃ",
          "textUthmaniBody": "وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ",
          "textImlaei": "وألقت ما فيها وتخلت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 589,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ ﰄ",
          "textUthmaniBody": "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ",
          "textImlaei": "وأذنت لربها وحقت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 589,
          "lineStart": 6,
          "lineEnd": 7,
          "textUthmaniRaw": "يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِ ﰅ",
          "textUthmaniBody": "يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِ",
          "textImlaei": "ياأيها الإنسان إنك كادح إلى ربك كدحا فملاقيه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 589,
          "lineStart": 7,
          "lineEnd": 8,
          "textUthmaniRaw": "فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ ﰆ",
          "textUthmaniBody": "فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ",
          "textImlaei": "فأما من أوتي كتابه بيمينه",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 589,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا ﰇ",
          "textUthmaniBody": "فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا",
          "textImlaei": "فسوف يحاسب حسابا يسيرا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 589,
          "lineStart": 8,
          "lineEnd": 9,
          "textUthmaniRaw": "وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورٗا ﰈ",
          "textUthmaniBody": "وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورٗا",
          "textImlaei": "وينقلب إلى أهله مسرورا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 589,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ ﰉ",
          "textUthmaniBody": "وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ",
          "textImlaei": "وأما من أوتي كتابه وراء ظهره",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 589,
          "lineStart": 9,
          "lineEnd": 10,
          "textUthmaniRaw": "فَسَوۡفَ يَدۡعُواْ ثُبُورٗا ﰊ",
          "textUthmaniBody": "فَسَوۡفَ يَدۡعُواْ ثُبُورٗا",
          "textImlaei": "فسوف يدعو ثبورا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 589,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "وَيَصۡلَىٰ سَعِيرًا ﰋ",
          "textUthmaniBody": "وَيَصۡلَىٰ سَعِيرًا",
          "textImlaei": "ويصلى سعيرا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 589,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا ﰌ",
          "textUthmaniBody": "إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا",
          "textImlaei": "إنه كان في أهله مسرورا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 589,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ ﰍ",
          "textUthmaniBody": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ",
          "textImlaei": "إنه ظن أن لن يحور",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 589,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا ﰎ",
          "textUthmaniBody": "بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا",
          "textImlaei": "بلى إن ربه كان به بصيرا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 589,
          "lineStart": 11,
          "lineEnd": 12,
          "textUthmaniRaw": "فَلَآ أُقۡسِمُ بِٱلشَّفَقِ ﰏ",
          "textUthmaniBody": "فَلَآ أُقۡسِمُ بِٱلشَّفَقِ",
          "textImlaei": "فلا أقسم بالشفق",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        },
        {
          "ayah": 17,
          "page": 589,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَٱلَّيۡلِ وَمَا وَسَقَ ﰐ",
          "textUthmaniBody": "وَٱلَّيۡلِ وَمَا وَسَقَ",
          "textImlaei": "والليل وما وسق",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        },
        {
          "ayah": 18,
          "page": 589,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ ﰑ",
          "textUthmaniBody": "وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ",
          "textImlaei": "والقمر إذا اتسق",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC11"
        },
        {
          "ayah": 19,
          "page": 589,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ ﰒ",
          "textUthmaniBody": "لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ",
          "textImlaei": "لتركبن طبقا عن طبق",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC12"
        },
        {
          "ayah": 20,
          "page": 589,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "فَمَا لَهُمۡ لَا يُؤۡمِنُونَ ﰓ",
          "textUthmaniBody": "فَمَا لَهُمۡ لَا يُؤۡمِنُونَ",
          "textImlaei": "فما لهم لا يؤمنون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC13"
        },
        {
          "ayah": 21,
          "page": 589,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩ ﰔ",
          "textUthmaniBody": "وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩",
          "textImlaei": "وإذا قرئ عليهم القرآن لا يسجدون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC14"
        },
        {
          "ayah": 22,
          "page": 589,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ ﰕ",
          "textUthmaniBody": "بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ",
          "textImlaei": "بل الذين كفروا يكذبون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC15"
        },
        {
          "ayah": 23,
          "page": 589,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ ﰖ",
          "textUthmaniBody": "وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ",
          "textImlaei": "والله أعلم بما يوعون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC16"
        },
        {
          "ayah": 24,
          "page": 589,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ ﰗ",
          "textUthmaniBody": "فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ",
          "textImlaei": "فبشرهم بعذاب أليم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC17"
        }
      ]
    },
    {
      "page": 590,
      "juz": 30,
      "ayahs": [
        {
          "ayah": 25,
          "page": 590,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ ﰘ",
          "textUthmaniBody": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ",
          "textImlaei": "إلا الذين آمنوا وعملوا الصالحات لهم أجر غير ممنون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC18"
        }
      ]
    }
  ]
}
