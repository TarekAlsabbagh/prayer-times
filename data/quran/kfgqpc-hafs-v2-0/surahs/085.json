  "basmalaMode": "separate",
  "pages": [
    {
      "page": 590,
      "juz": 30,
      "ayahs": [
        {
          "ayah": 1,
          "page": 590,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "وَٱلسَّمَآءِ ذَاتِ ٱلۡبُرُوجِ ﰀ",
          "textUthmaniBody": "وَٱلسَّمَآءِ ذَاتِ ٱلۡبُرُوجِ",
          "textImlaei": "والسماء ذات البروج",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 590,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "وَٱلۡيَوۡمِ ٱلۡمَوۡعُودِ ﰁ",
          "textUthmaniBody": "وَٱلۡيَوۡمِ ٱلۡمَوۡعُودِ",
          "textImlaei": "واليوم الموعود",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 590,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "وَشَاهِدٖ وَمَشۡهُودٖ ﰂ",
          "textUthmaniBody": "وَشَاهِدٖ وَمَشۡهُودٖ",
          "textImlaei": "وشاهد ومشهود",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 590,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "قُتِلَ أَصۡحَٰبُ ٱلۡأُخۡدُودِ ﰃ",
          "textUthmaniBody": "قُتِلَ أَصۡحَٰبُ ٱلۡأُخۡدُودِ",
          "textImlaei": "قتل أصحاب الأخدود",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 590,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "ٱلنَّارِ ذَاتِ ٱلۡوَقُودِ ﰄ",
          "textUthmaniBody": "ٱلنَّارِ ذَاتِ ٱلۡوَقُودِ",
          "textImlaei": "النار ذات الوقود",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 590,
          "lineStart": 5,
          "lineEnd": 6,
          "textUthmaniRaw": "إِذۡ هُمۡ عَلَيۡهَا قُعُودٞ ﰅ",
          "textUthmaniBody": "إِذۡ هُمۡ عَلَيۡهَا قُعُودٞ",
          "textImlaei": "إذ هم عليها قعود",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 590,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "وَهُمۡ عَلَىٰ مَا يَفۡعَلُونَ بِٱلۡمُؤۡمِنِينَ شُهُودٞ ﰆ",
          "textUthmaniBody": "وَهُمۡ عَلَىٰ مَا يَفۡعَلُونَ بِٱلۡمُؤۡمِنِينَ شُهُودٞ",
          "textImlaei": "وهم على ما يفعلون بالمؤمنين شهود",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 590,
          "lineStart": 6,
          "lineEnd": 7,
          "textUthmaniRaw": "وَمَا نَقَمُواْ مِنۡهُمۡ إِلَّآ أَن يُؤۡمِنُواْ بِٱللَّهِ ٱلۡعَزِيزِ ٱلۡحَمِيدِ ﰇ",
          "textUthmaniBody": "وَمَا نَقَمُواْ مِنۡهُمۡ إِلَّآ أَن يُؤۡمِنُواْ بِٱللَّهِ ٱلۡعَزِيزِ ٱلۡحَمِيدِ",
          "textImlaei": "وما نقموا منهم إلا أن يؤمنوا بالله العزيز الحميد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 590,
          "lineStart": 7,
          "lineEnd": 8,
          "textUthmaniRaw": "ٱلَّذِي لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدٌ ﰈ",
          "textUthmaniBody": "ٱلَّذِي لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدٌ",
          "textImlaei": "الذي له ملك السموات والأرض والله على كل شيء شهيد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 590,
          "lineStart": 8,
          "lineEnd": 10,
          "textUthmaniRaw": "إِنَّ ٱلَّذِينَ فَتَنُواْ ٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِ ثُمَّ لَمۡ يَتُوبُواْ فَلَهُمۡ عَذَابُ جَهَنَّمَ وَلَهُمۡ عَذَابُ ٱلۡحَرِيقِ ﰉ",
          "textUthmaniBody": "إِنَّ ٱلَّذِينَ فَتَنُواْ ٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِ ثُمَّ لَمۡ يَتُوبُواْ فَلَهُمۡ عَذَابُ جَهَنَّمَ وَلَهُمۡ عَذَابُ ٱلۡحَرِيقِ",
          "textImlaei": "إن الذين فتنوا المؤمنين والمؤمنات ثم لم يتوبوا فلهم عذاب جهنم ولهم عذاب الحريق",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 590,
          "lineStart": 10,
          "lineEnd": 11,
          "textUthmaniRaw": "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ جَنَّٰتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۚ ذَٰلِكَ ٱلۡفَوۡزُ ٱلۡكَبِيرُ ﰊ",
          "textUthmaniBody": "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ جَنَّٰتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۚ ذَٰلِكَ ٱلۡفَوۡزُ ٱلۡكَبِيرُ",
          "textImlaei": "إن الذين آمنوا وعملوا الصالحات لهم جنات تجري من تحتها الأنهار ذلك الفوز الكبير",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 590,
          "lineStart": 11,
          "lineEnd": 12,
          "textUthmaniRaw": "إِنَّ بَطۡشَ رَبِّكَ لَشَدِيدٌ ﰋ",
          "textUthmaniBody": "إِنَّ بَطۡشَ رَبِّكَ لَشَدِيدٌ",
          "textImlaei": "إن بطش ربك لشديد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 590,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "إِنَّهُۥ هُوَ يُبۡدِئُ وَيُعِيدُ ﰌ",
          "textUthmaniBody": "إِنَّهُۥ هُوَ يُبۡدِئُ وَيُعِيدُ",
          "textImlaei": "إنه هو يبدئ ويعيد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 590,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَهُوَ ٱلۡغَفُورُ ٱلۡوَدُودُ ﰍ",
          "textUthmaniBody": "وَهُوَ ٱلۡغَفُورُ ٱلۡوَدُودُ",
          "textImlaei": "وهو الغفور الودود",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 590,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "ذُو ٱلۡعَرۡشِ ٱلۡمَجِيدُ ﰎ",
          "textUthmaniBody": "ذُو ٱلۡعَرۡشِ ٱلۡمَجِيدُ",
          "textImlaei": "ذو العرش المجيد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 590,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "فَعَّالٞ لِّمَا يُرِيدُ ﰏ",
          "textUthmaniBody": "فَعَّالٞ لِّمَا يُرِيدُ",
          "textImlaei": "فعال لما يريد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        },
        {
          "ayah": 17,
          "page": 590,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡجُنُودِ ﰐ",
          "textUthmaniBody": "هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡجُنُودِ",
          "textImlaei": "هل أتاك حديث الجنود",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        },
        {
          "ayah": 18,
          "page": 590,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "فِرۡعَوۡنَ وَثَمُودَ ﰑ",
          "textUthmaniBody": "فِرۡعَوۡنَ وَثَمُودَ",
          "textImlaei": "فرعون وثمود",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC11"
        },
        {
          "ayah": 19,
          "page": 590,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "بَلِ ٱلَّذِينَ كَفَرُواْ فِي تَكۡذِيبٖ ﰒ",
          "textUthmaniBody": "بَلِ ٱلَّذِينَ كَفَرُواْ فِي تَكۡذِيبٖ",
          "textImlaei": "بل الذين كفروا في تكذيب",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC12"
        },
        {
          "ayah": 20,
          "page": 590,
          "lineStart": 14,
          "lineEnd": 15,
          "textUthmaniRaw": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطُۢ ﰓ",
          "textUthmaniBody": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطُۢ",
          "textImlaei": "والله من ورائهم محيط",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC13"
        },
        {
          "ayah": 21,
          "page": 590,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "بَلۡ هُوَ قُرۡءَانٞ مَّجِيدٞ ﰔ",
          "textUthmaniBody": "بَلۡ هُوَ قُرۡءَانٞ مَّجِيدٞ",
          "textImlaei": "بل هو قرآن مجيد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC14"
        },
        {
          "ayah": 22,
          "page": 590,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "فِي لَوۡحٖ مَّحۡفُوظِۭ ﰕ",
          "textUthmaniBody": "فِي لَوۡحٖ مَّحۡفُوظِۭ",
          "textImlaei": "في لوح محفوظ",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC15"
        }
      ]
    }
  ]
}
