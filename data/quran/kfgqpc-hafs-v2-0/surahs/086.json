  "basmalaMode": "separate",
  "pages": [
    {
      "page": 591,
      "juz": 30,
      "ayahs": [
        {
          "ayah": 1,
          "page": 591,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "وَٱلسَّمَآءِ وَٱلطَّارِقِ ﰀ",
          "textUthmaniBody": "وَٱلسَّمَآءِ وَٱلطَّارِقِ",
          "textImlaei": "والسماء والطارق",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 591,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ ﰁ",
          "textUthmaniBody": "وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ",
          "textImlaei": "وما أدراك ما الطارق",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 591,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "ٱلنَّجۡمُ ٱلثَّاقِبُ ﰂ",
          "textUthmaniBody": "ٱلنَّجۡمُ ٱلثَّاقِبُ",
          "textImlaei": "النجم الثاقب",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 591,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ ﰃ",
          "textUthmaniBody": "إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ",
          "textImlaei": "إن كل نفس لما عليها حافظ",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 591,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ ﰄ",
          "textUthmaniBody": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ",
          "textImlaei": "فلينظر الإنسان مم خلق",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 591,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "خُلِقَ مِن مَّآءٖ دَافِقٖ ﰅ",
          "textUthmaniBody": "خُلِقَ مِن مَّآءٖ دَافِقٖ",
          "textImlaei": "خلق من ماء دافق",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 591,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ ﰆ",
          "textUthmaniBody": "يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ",
          "textImlaei": "يخرج من بين الصلب والترائب",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 591,
          "lineStart": 5,
          "lineEnd": 6,
          "textUthmaniRaw": "إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ ﰇ",
          "textUthmaniBody": "إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ",
          "textImlaei": "إنه على رجعه لقادر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 591,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ ﰈ",
          "textUthmaniBody": "يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ",
          "textImlaei": "يوم تبلى السرائر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 591,
          "lineStart": 6,
          "lineEnd": 7,
          "textUthmaniRaw": "فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ ﰉ",
          "textUthmaniBody": "فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ",
          "textImlaei": "فما له من قوة ولا ناصر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 591,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ ﰊ",
          "textUthmaniBody": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ",
          "textImlaei": "والسماء ذات الرجع",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 591,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ ﰋ",
          "textUthmaniBody": "وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ",
          "textImlaei": "والأرض ذات الصدع",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 591,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ ﰌ",
          "textUthmaniBody": "إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ",
          "textImlaei": "إنه لقول فصل",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 591,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "وَمَا هُوَ بِٱلۡهَزۡلِ ﰍ",
          "textUthmaniBody": "وَمَا هُوَ بِٱلۡهَزۡلِ",
          "textImlaei": "وما هو بالهزل",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 591,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا ﰎ",
          "textUthmaniBody": "إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا",
          "textImlaei": "إنهم يكيدون كيدا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 591,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "وَأَكِيدُ كَيۡدٗا ﰏ",
          "textUthmaniBody": "وَأَكِيدُ كَيۡدٗا",
          "textImlaei": "وأكيد كيدا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        },
        {
          "ayah": 17,
          "page": 591,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا ﰐ",
          "textUthmaniBody": "فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا",
          "textImlaei": "فمهل الكافرين أمهلهم رويدا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        }
      ]
    }
  ]
}
