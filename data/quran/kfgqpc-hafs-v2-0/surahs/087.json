  "pages": [
    {
      "page": 591,
      "juz": 30,
      "ayahs": [
        {
          "ayah": 1,
          "page": 591,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى ﰀ",
          "textUthmaniBody": "سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى",
          "textImlaei": "سبح اسم ربك الأعلى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 591,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "ٱلَّذِي خَلَقَ فَسَوَّىٰ ﰁ",
          "textUthmaniBody": "ٱلَّذِي خَلَقَ فَسَوَّىٰ",
          "textImlaei": "الذي خلق فسوى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 591,
          "lineStart": 12,
          "lineEnd": 13,
          "textUthmaniRaw": "وَٱلَّذِي قَدَّرَ فَهَدَىٰ ﰂ",
          "textUthmaniBody": "وَٱلَّذِي قَدَّرَ فَهَدَىٰ",
          "textImlaei": "والذي قدر فهدى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 591,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ ﰃ",
          "textUthmaniBody": "وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ",
          "textImlaei": "والذي أخرج المرعى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 591,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ ﰄ",
          "textUthmaniBody": "فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ",
          "textImlaei": "فجعله غثاء أحوى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 591,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ ﰅ",
          "textUthmaniBody": "سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ",
          "textImlaei": "سنقرئك فلا تنسى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 591,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ ﰆ",
          "textUthmaniBody": "إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ",
          "textImlaei": "إلا ما شاء الله إنه يعلم الجهر وما يخفى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 591,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ ﰇ",
          "textUthmaniBody": "وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ",
          "textImlaei": "ونيسرك لليسرى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 591,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ ﰈ",
          "textUthmaniBody": "فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ",
          "textImlaei": "فذكر إن نفعت الذكرى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 591,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "سَيَذَّكَّرُ مَن يَخۡشَىٰ ﰉ",
          "textUthmaniBody": "سَيَذَّكَّرُ مَن يَخۡشَىٰ",
          "textImlaei": "سيذكر من يخشى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        }
      ]
    },
    {
      "page": 592,
      "juz": 30,
      "ayahs": [
        {
          "ayah": 11,
          "page": 592,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى ﰊ",
          "textUthmaniBody": "وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى",
          "textImlaei": "ويتجنبها الأشقى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 592,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ ﰋ",
          "textUthmaniBody": "ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ",
          "textImlaei": "الذي يصلى النار الكبرى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 592,
          "lineStart": 1,
          "lineEnd": 2,
          "textUthmaniRaw": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ ﰌ",
          "textUthmaniBody": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ",
          "textImlaei": "ثم لا يموت فيها ولا يحيا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 592,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ ﰍ",
          "textUthmaniBody": "قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ",
          "textImlaei": "قد أفلح من تزكى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 592,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ ﰎ",
          "textUthmaniBody": "وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ",
          "textImlaei": "وذكر اسم ربه فصلى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 592,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا ﰏ",
          "textUthmaniBody": "بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا",
          "textImlaei": "بل تؤثرون الحياة الدنيا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        },
        {
          "ayah": 17,
          "page": 592,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ ﰐ",
          "textUthmaniBody": "وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ",
          "textImlaei": "والآخرة خير وأبقى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        },
        {
          "ayah": 18,
          "page": 592,
          "lineStart": 3,
          "lineEnd": 4,
          "textUthmaniRaw": "إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ ﰑ",
          "textUthmaniBody": "إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ",
          "textImlaei": "إن هذا لفي الصحف الأولى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC11"
        },
        {
          "ayah": 19,
          "page": 592,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ ﰒ",
          "textUthmaniBody": "صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ",
          "textImlaei": "صحف إبراهيم وموسى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC12"
        }
      ]
    }
  ]
}
