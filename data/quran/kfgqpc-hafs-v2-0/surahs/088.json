{
  "surah": 88,
  "nameAr": "الغَاشِية",
  "nameEn": "Al-Ghāshiyah",
  "ayahCount": 26,
  "firstPage": 592,
  "lastPage": 593,
  "pageCount": 2,
  "juz": [
