  "basmalaMode": "separate",
  "pages": [
    {
      "page": 592,
      "juz": 30,
      "ayahs": [
        {
          "ayah": 1,
          "page": 592,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ ﰀ",
          "textUthmaniBody": "هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ",
          "textImlaei": "هل أتاك حديث الغاشية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 592,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ ﰁ",
          "textUthmaniBody": "وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ",
          "textImlaei": "وجوه يومئذ خاشعة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 592,
          "lineStart": 7,
          "lineEnd": 8,
          "textUthmaniRaw": "عَامِلَةٞ نَّاصِبَةٞ ﰂ",
          "textUthmaniBody": "عَامِلَةٞ نَّاصِبَةٞ",
          "textImlaei": "عاملة ناصبة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 592,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "تَصۡلَىٰ نَارًا حَامِيَةٗ ﰃ",
          "textUthmaniBody": "تَصۡلَىٰ نَارًا حَامِيَةٗ",
          "textImlaei": "تصلى نارا حامية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 592,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ ﰄ",
          "textUthmaniBody": "تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ",
          "textImlaei": "تسقى من عين آنية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 592,
          "lineStart": 8,
          "lineEnd": 9,
          "textUthmaniRaw": "لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ ﰅ",
          "textUthmaniBody": "لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ",
          "textImlaei": "ليس لهم طعام إلا من ضريع",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 592,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ ﰆ",
          "textUthmaniBody": "لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ",
          "textImlaei": "لا يسمن ولا يغني من جوع",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 592,
          "lineStart": 9,
          "lineEnd": 10,
          "textUthmaniRaw": "وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ ﰇ",
          "textUthmaniBody": "وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ",
          "textImlaei": "وجوه يومئذ ناعمة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 592,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "لِّسَعۡيِهَا رَاضِيَةٞ ﰈ",
          "textUthmaniBody": "لِّسَعۡيِهَا رَاضِيَةٞ",
          "textImlaei": "لسعيها راضية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 592,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "فِي جَنَّةٍ عَالِيَةٖ ﰉ",
          "textUthmaniBody": "فِي جَنَّةٍ عَالِيَةٖ",
          "textImlaei": "في جنة عالية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 592,
          "lineStart": 10,
          "lineEnd": 11,
          "textUthmaniRaw": "لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ ﰊ",
          "textUthmaniBody": "لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ",
          "textImlaei": "لا تسمع فيها لاغية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 592,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "فِيهَا عَيۡنٞ جَارِيَةٞ ﰋ",
          "textUthmaniBody": "فِيهَا عَيۡنٞ جَارِيَةٞ",
          "textImlaei": "فيها عين جارية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 592,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "فِيهَا سُرُرٞ مَّرۡفُوعَةٞ ﰌ",
          "textUthmaniBody": "فِيهَا سُرُرٞ مَّرۡفُوعَةٞ",
          "textImlaei": "فيها سرر مرفوعة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 592,
          "lineStart": 11,
          "lineEnd": 12,
          "textUthmaniRaw": "وَأَكۡوَابٞ مَّوۡضُوعَةٞ ﰍ",
          "textUthmaniBody": "وَأَكۡوَابٞ مَّوۡضُوعَةٞ",
          "textImlaei": "وأكواب موضوعة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 592,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَنَمَارِقُ مَصۡفُوفَةٞ ﰎ",
          "textUthmaniBody": "وَنَمَارِقُ مَصۡفُوفَةٞ",
          "textImlaei": "ونمارق مصفوفة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 592,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَزَرَابِيُّ مَبۡثُوثَةٌ ﰏ",
          "textUthmaniBody": "وَزَرَابِيُّ مَبۡثُوثَةٌ",
          "textImlaei": "وزرابي مبثوثة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        },
        {
          "ayah": 17,
          "page": 592,
          "lineStart": 12,
          "lineEnd": 13,
          "textUthmaniRaw": "أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ ﰐ",
          "textUthmaniBody": "أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ",
          "textImlaei": "أفلا ينظرون إلى الإبل كيف خلقت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        },
        {
          "ayah": 18,
          "page": 592,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ ﰑ",
          "textUthmaniBody": "وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ",
          "textImlaei": "وإلى السماء كيف رفعت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC11"
        },
        {
          "ayah": 19,
          "page": 592,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ ﰒ",
          "textUthmaniBody": "وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ",
          "textImlaei": "وإلى الجبال كيف نصبت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC12"
        },
        {
          "ayah": 20,
          "page": 592,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ ﰓ",
          "textUthmaniBody": "وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ",
          "textImlaei": "وإلى الأرض كيف سطحت",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC13"
        },
        {
          "ayah": 21,
          "page": 592,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ ﰔ",
          "textUthmaniBody": "فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ",
          "textImlaei": "فذكر إنما أنت مذكر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC14"
        },
        {
          "ayah": 22,
          "page": 592,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ ﰕ",
          "textUthmaniBody": "لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ",
          "textImlaei": "لست عليهم بمصيطر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC15"
        }
      ]
    },
    {
      "page": 593,
      "juz": 30,
      "ayahs": [
        {
          "ayah": 23,
          "page": 593,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ ﰖ",
          "textUthmaniBody": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
          "textImlaei": "إلا من تولى وكفر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC16"
        },
        {
          "ayah": 24,
          "page": 593,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ ﰗ",
          "textUthmaniBody": "فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ",
          "textImlaei": "فيعذبه الله العذاب الأكبر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC17"
        },
        {
          "ayah": 25,
          "page": 593,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "إِنَّ إِلَيۡنَآ إِيَابَهُمۡ ﰘ",
          "textUthmaniBody": "إِنَّ إِلَيۡنَآ إِيَابَهُمۡ",
          "textImlaei": "إن إلينا إيابهم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC18"
        },
        {
          "ayah": 26,
          "page": 593,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم ﰙ",
          "textUthmaniBody": "ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم",
          "textImlaei": "ثم إن علينا حسابهم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC19"
        }
      ]
    }
  ]
}
