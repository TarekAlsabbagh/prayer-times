  ],
  "basmalaMode": "separate",
  "pages": [
    {
      "page": 593,
      "juz": 30,
      "ayahs": [
        {
          "ayah": 1,
          "page": 593,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَٱلۡفَجۡرِ ﰀ",
          "textUthmaniBody": "وَٱلۡفَجۡرِ",
          "textImlaei": "والفجر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 593,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَلَيَالٍ عَشۡرٖ ﰁ",
          "textUthmaniBody": "وَلَيَالٍ عَشۡرٖ",
          "textImlaei": "وليال عشر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 593,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَٱلشَّفۡعِ وَٱلۡوَتۡرِ ﰂ",
          "textUthmaniBody": "وَٱلشَّفۡعِ وَٱلۡوَتۡرِ",
          "textImlaei": "والشفع والوتر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 593,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَٱلَّيۡلِ إِذَا يَسۡرِ ﰃ",
          "textUthmaniBody": "وَٱلَّيۡلِ إِذَا يَسۡرِ",
          "textImlaei": "والليل إذا يسر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 593,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ ﰄ",
          "textUthmaniBody": "هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ",
          "textImlaei": "هل في ذلك قسم لذي حجر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 593,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ ﰅ",
          "textUthmaniBody": "أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ",
          "textImlaei": "ألم تر كيف فعل ربك بعاد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 593,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "إِرَمَ ذَاتِ ٱلۡعِمَادِ ﰆ",
          "textUthmaniBody": "إِرَمَ ذَاتِ ٱلۡعِمَادِ",
          "textImlaei": "إرم ذات العماد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 593,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ ﰇ",
          "textUthmaniBody": "ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ",
          "textImlaei": "التي لم يخلق مثلها في البلاد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 593,
          "lineStart": 7,
          "lineEnd": 8,
          "textUthmaniRaw": "وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ ﰈ",
          "textUthmaniBody": "وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ",
          "textImlaei": "وثمود الذين جابوا الصخر بالواد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 593,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ ﰉ",
          "textUthmaniBody": "وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ",
          "textImlaei": "وفرعون ذي الأوتاد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 593,
          "lineStart": 8,
          "lineEnd": 9,
          "textUthmaniRaw": "ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ ﰊ",
          "textUthmaniBody": "ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ",
          "textImlaei": "الذين طغوا في البلاد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 593,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ ﰋ",
          "textUthmaniBody": "فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ",
          "textImlaei": "فأكثروا فيها الفساد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 593,
          "lineStart": 9,
          "lineEnd": 10,
          "textUthmaniRaw": "فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ ﰌ",
          "textUthmaniBody": "فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ",
          "textImlaei": "فصب عليهم ربك سوط عذاب",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 593,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ ﰍ",
          "textUthmaniBody": "إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ",
          "textImlaei": "إن ربك لبالمرصاد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 593,
          "lineStart": 10,
          "lineEnd": 11,
          "textUthmaniRaw": "فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ ﰎ",
          "textUthmaniBody": "فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ",
          "textImlaei": "فأما الإنسان إذا ما ابتلاه ربه فأكرمه ونعمه فيقول ربي أكرمن",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 593,
          "lineStart": 11,
          "lineEnd": 12,
          "textUthmaniRaw": "وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ ﰏ",
          "textUthmaniBody": "وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ",
          "textImlaei": "وأما إذا ما ابتلاه فقدر عليه رزقه فيقول ربي أهانن",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        },
        {
          "ayah": 17,
          "page": 593,
          "lineStart": 12,
          "lineEnd": 13,
          "textUthmaniRaw": "كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ ﰐ",
          "textUthmaniBody": "كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ",
          "textImlaei": "كلا بل لا تكرمون اليتيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        },
        {
          "ayah": 18,
          "page": 593,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ﰑ",
          "textUthmaniBody": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ",
          "textImlaei": "ولا تحاضون على طعام المسكين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC11"
        },
        {
          "ayah": 19,
          "page": 593,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا ﰒ",
          "textUthmaniBody": "وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا",
          "textImlaei": "وتأكلون التراث أكلا لما",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC12"
        },
        {
          "ayah": 20,
          "page": 593,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا ﰓ",
          "textUthmaniBody": "وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا",
          "textImlaei": "وتحبون المال حبا جما",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC13"
        },
        {
          "ayah": 21,
          "page": 593,
          "lineStart": 14,
          "lineEnd": 15,
          "textUthmaniRaw": "كَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا ﰔ",
          "textUthmaniBody": "كَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا",
          "textImlaei": "كلا إذا دكت الأرض دكا دكا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC14"
        },
        {
          "ayah": 22,
          "page": 593,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا ﰕ",
          "textUthmaniBody": "وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا",
          "textImlaei": "وجاء ربك والملك صفا صفا",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC15"
        }
      ]
    },
    {
      "page": 594,
      "juz": 30,
      "ayahs": [
        {
          "ayah": 23,
          "page": 594,
          "lineStart": 1,
          "lineEnd": 2,
          "textUthmaniRaw": "وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ ﰖ",
          "textUthmaniBody": "وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ",
          "textImlaei": "وجيء يومئذ بجهنم يومئذ يتذكر الإنسان وأنى له الذكرى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC16"
        },
        {
          "ayah": 24,
          "page": 594,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي ﰗ",
          "textUthmaniBody": "يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي",
          "textImlaei": "يقول ياليتني قدمت لحياتي",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC17"
        },
        {
          "ayah": 25,
          "page": 594,
          "lineStart": 2,
          "lineEnd": 3,
          "textUthmaniRaw": "فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ ﰘ",
          "textUthmaniBody": "فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ",
          "textImlaei": "فيومئذ لا يعذب عذابه أحد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC18"
        },
        {
          "ayah": 26,
          "page": 594,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ ﰙ",
          "textUthmaniBody": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ",
          "textImlaei": "ولا يوثق وثاقه أحد",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC19"
        },
        {
          "ayah": 27,
          "page": 594,
          "lineStart": 3,
          "lineEnd": 4,
          "textUthmaniRaw": "يَٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ ﰚ",
          "textUthmaniBody": "يَٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ",
          "textImlaei": "ياأيتها النفس المطمئنة",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1A"
        },
        {
          "ayah": 28,
          "page": 594,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ ﰛ",
          "textUthmaniBody": "ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ",
          "textImlaei": "ارجعي إلى ربك راضية مرضية",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1B"
        },
        {
          "ayah": 29,
          "page": 594,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "فَٱدۡخُلِي فِي عِبَٰدِي ﰜ",
          "textUthmaniBody": "فَٱدۡخُلِي فِي عِبَٰدِي",
          "textImlaei": "فادخلي في عبادي",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1C"
        },
        {
          "ayah": 30,
          "page": 594,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَٱدۡخُلِي جَنَّتِي ﰝ",
          "textUthmaniBody": "وَٱدۡخُلِي جَنَّتِي",
          "textImlaei": "وادخلي جنتي",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC1D"
        }
      ]
    }
  ]
}
