  "pages": [
    {
      "page": 595,
      "juz": 30,
      "ayahs": [
        {
          "ayah": 1,
          "page": 595,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "وَٱلَّيۡلِ إِذَا يَغۡشَىٰ ﰀ",
          "textUthmaniBody": "وَٱلَّيۡلِ إِذَا يَغۡشَىٰ",
          "textImlaei": "والليل إذا يغشى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 595,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ ﰁ",
          "textUthmaniBody": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
          "textImlaei": "والنهار إذا تجلى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 595,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ ﰂ",
          "textUthmaniBody": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ",
          "textImlaei": "وما خلق الذكر والأنثى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 595,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ ﰃ",
          "textUthmaniBody": "إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ",
          "textImlaei": "إن سعيكم لشتى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 595,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ ﰄ",
          "textUthmaniBody": "فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ",
          "textImlaei": "فأما من أعطى واتقى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 595,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "وَصَدَّقَ بِٱلۡحُسۡنَىٰ ﰅ",
          "textUthmaniBody": "وَصَدَّقَ بِٱلۡحُسۡنَىٰ",
          "textImlaei": "وصدق بالحسنى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 595,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ ﰆ",
          "textUthmaniBody": "فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ",
          "textImlaei": "فسنيسره لليسرى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 595,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ ﰇ",
          "textUthmaniBody": "وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ",
          "textImlaei": "وأما من بخل واستغنى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 595,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "وَكَذَّبَ بِٱلۡحُسۡنَىٰ ﰈ",
          "textUthmaniBody": "وَكَذَّبَ بِٱلۡحُسۡنَىٰ",
          "textImlaei": "وكذب بالحسنى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        }
      ]
    },
    {
      "page": 596,
      "juz": 30,
      "ayahs": [
        {
          "ayah": 10,
          "page": 596,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ ﰉ",
          "textUthmaniBody": "فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ",
          "textImlaei": "فسنيسره للعسرى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 596,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ ﰊ",
          "textUthmaniBody": "وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
          "textImlaei": "وما يغني عنه ماله إذا تردى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        },
        {
          "ayah": 12,
          "page": 596,
          "lineStart": 1,
          "lineEnd": 2,
          "textUthmaniRaw": "إِنَّ عَلَيۡنَا لَلۡهُدَىٰ ﰋ",
          "textUthmaniBody": "إِنَّ عَلَيۡنَا لَلۡهُدَىٰ",
          "textImlaei": "إن علينا للهدى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0B"
        },
        {
          "ayah": 13,
          "page": 596,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ ﰌ",
          "textUthmaniBody": "وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ",
          "textImlaei": "وإن لنا للآخرة والأولى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0C"
        },
        {
          "ayah": 14,
          "page": 596,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ ﰍ",
          "textUthmaniBody": "فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ",
          "textImlaei": "فأنذرتكم نارا تلظى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0D"
        },
        {
          "ayah": 15,
          "page": 596,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى ﰎ",
          "textUthmaniBody": "لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى",
          "textImlaei": "لا يصلاها إلا الأشقى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0E"
        },
        {
          "ayah": 16,
          "page": 596,
          "lineStart": 3,
          "lineEnd": 3,
          "textUthmaniRaw": "ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ ﰏ",
          "textUthmaniBody": "ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ",
          "textImlaei": "الذي كذب وتولى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0F"
        },
        {
          "ayah": 17,
          "page": 596,
          "lineStart": 3,
          "lineEnd": 4,
          "textUthmaniRaw": "وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى ﰐ",
          "textUthmaniBody": "وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى",
          "textImlaei": "وسيجنبها الأتقى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC10"
        },
        {
          "ayah": 18,
          "page": 596,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ ﰑ",
          "textUthmaniBody": "ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ",
          "textImlaei": "الذي يؤتي ماله يتزكى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC11"
        },
        {
          "ayah": 19,
          "page": 596,
          "lineStart": 4,
          "lineEnd": 5,
          "textUthmaniRaw": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ ﰒ",
          "textUthmaniBody": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ",
          "textImlaei": "وما لأحد عنده من نعمة تجزى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC12"
        },
        {
          "ayah": 20,
          "page": 596,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ ﰓ",
          "textUthmaniBody": "إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ",
          "textImlaei": "إلا ابتغاء وجه ربه الأعلى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC13"
        },
        {
          "ayah": 21,
          "page": 596,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَلَسَوۡفَ يَرۡضَىٰ ﰔ",
          "textUthmaniBody": "وَلَسَوۡفَ يَرۡضَىٰ",
          "textImlaei": "ولسوف يرضى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC14"
        }
      ]
    }
  ]
}
