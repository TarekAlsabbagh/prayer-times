        {
          "ayah": 1,
          "page": 596,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "وَٱلضُّحَىٰ ﰀ",
          "textUthmaniBody": "وَٱلضُّحَىٰ",
          "textImlaei": "والضحى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 596,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "وَٱلَّيۡلِ إِذَا سَجَىٰ ﰁ",
          "textUthmaniBody": "وَٱلَّيۡلِ إِذَا سَجَىٰ",
          "textImlaei": "والليل إذا سجى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 596,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ ﰂ",
          "textUthmaniBody": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
          "textImlaei": "ما ودعك ربك وما قلى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 596,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ ﰃ",
          "textUthmaniBody": "وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ",
          "textImlaei": "وللآخرة خير لك من الأولى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 596,
          "lineStart": 9,
          "lineEnd": 10,
          "textUthmaniRaw": "وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ ﰄ",
          "textUthmaniBody": "وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ",
          "textImlaei": "ولسوف يعطيك ربك فترضى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 596,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ ﰅ",
          "textUthmaniBody": "أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ",
          "textImlaei": "ألم يجدك يتيما فآوى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 596,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ ﰆ",
          "textUthmaniBody": "وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ",
          "textImlaei": "ووجدك ضالا فهدى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 596,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ ﰇ",
          "textUthmaniBody": "وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ",
          "textImlaei": "ووجدك عائلا فأغنى",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        },
        {
          "ayah": 9,
          "page": 596,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ ﰈ",
          "textUthmaniBody": "فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ",
          "textImlaei": "فأما اليتيم فلا تقهر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC08"
        },
        {
          "ayah": 10,
          "page": 596,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ ﰉ",
          "textUthmaniBody": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ",
          "textImlaei": "وأما السائل فلا تنهر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC09"
        },
        {
          "ayah": 11,
          "page": 596,
          "lineStart": 12,
          "lineEnd": 12,
          "textUthmaniRaw": "وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ ﰊ",
          "textUthmaniBody": "وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ",
          "textImlaei": "وأما بنعمة ربك فحدث",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC0A"
        }
      ]
    }
