        },
        {
          "ayah": 4,
          "page": 597,
          "lineStart": 1,
          "lineEnd": 1,
          "textUthmaniRaw": "وَرَفَعۡنَا لَكَ ذِكۡرَكَ ﰃ",
          "textUthmaniBody": "وَرَفَعۡنَا لَكَ ذِكۡرَكَ",
