        },
        {
          "ayah": 6,
          "page": 597,
          "lineStart": 2,
          "lineEnd": 2,
          "textUthmaniRaw": "إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا ﰅ",
          "textUthmaniBody": "إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا",
          "textImlaei": "إن مع العسر يسرا",
