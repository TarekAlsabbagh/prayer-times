        },
        {
          "ayah": 2,
          "page": 597,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَطُورِ سِينِينَ ﰁ",
          "textUthmaniBody": "وَطُورِ سِينِينَ",
          "textImlaei": "وطور سينين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 597,
          "lineStart": 5,
          "lineEnd": 5,
          "textUthmaniRaw": "وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ ﰂ",
          "textUthmaniBody": "وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ",
          "textImlaei": "وهذا البلد الأمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 597,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمٖ ﰃ",
          "textUthmaniBody": "لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمٖ",
          "textImlaei": "لقد خلقنا الإنسان في أحسن تقويم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 597,
          "lineStart": 6,
          "lineEnd": 6,
          "textUthmaniRaw": "ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ ﰄ",
          "textUthmaniBody": "ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ",
          "textImlaei": "ثم رددناه أسفل سافلين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 597,
          "lineStart": 7,
          "lineEnd": 7,
          "textUthmaniRaw": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ ﰅ",
          "textUthmaniBody": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ",
          "textImlaei": "إلا الذين آمنوا وعملوا الصالحات فلهم أجر غير ممنون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 597,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ ﰆ",
          "textUthmaniBody": "فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ",
          "textImlaei": "فما يكذبك بعد بالدين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 597,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ ﰇ",
          "textUthmaniBody": "أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ",
          "textImlaei": "أليس الله بأحكم الحاكمين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        }
      ]
