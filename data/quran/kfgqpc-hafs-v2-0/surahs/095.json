          "textUthmaniRaw": "وَٱلتِّينِ وَٱلزَّيۡتُونِ ﰀ",
          "textUthmaniBody": "وَٱلتِّينِ وَٱلزَّيۡتُونِ",
          "textImlaei": "والتين والزيتون",
          "rawEndSeparatorCodePoint": "U+00A0",
