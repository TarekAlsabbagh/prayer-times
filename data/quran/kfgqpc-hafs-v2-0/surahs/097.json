        },
        {
          "ayah": 4,
          "page": 598,
          "lineStart": 7,
          "lineEnd": 8,
          "textUthmaniRaw": "تَنَزَّلُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذۡنِ رَبِّهِم مِّن كُلِّ أَمۡرٖ ﰃ",
          "textUthmaniBody": "تَنَزَّلُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذۡنِ رَبِّهِم مِّن كُلِّ أَمۡرٖ",
          "textImlaei": "تنزل الملائكة والروح فيها بإذن ربهم من كل أمر",
          "rawEndSeparatorCodePoint": "U+00A0",
