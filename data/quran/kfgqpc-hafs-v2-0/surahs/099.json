      "ayahs": [
        {
          "ayah": 1,
          "page": 599,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "إِذَا زُلۡزِلَتِ ٱلۡأَرۡضُ زِلۡزَالَهَا ﰀ",
          "textUthmaniBody": "إِذَا زُلۡزِلَتِ ٱلۡأَرۡضُ زِلۡزَالَهَا",
          "textImlaei": "إذا زلزلت الأرض زلزالها",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 599,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "وَأَخۡرَجَتِ ٱلۡأَرۡضُ أَثۡقَالَهَا ﰁ",
          "textUthmaniBody": "وَأَخۡرَجَتِ ٱلۡأَرۡضُ أَثۡقَالَهَا",
          "textImlaei": "وأخرجت الأرض أثقالها",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 599,
          "lineStart": 8,
          "lineEnd": 9,
          "textUthmaniRaw": "وَقَالَ ٱلۡإِنسَٰنُ مَا لَهَا ﰂ",
          "textUthmaniBody": "وَقَالَ ٱلۡإِنسَٰنُ مَا لَهَا",
          "textImlaei": "وقال الإنسان ما لها",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 599,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "يَوۡمَئِذٖ تُحَدِّثُ أَخۡبَارَهَا ﰃ",
          "textUthmaniBody": "يَوۡمَئِذٖ تُحَدِّثُ أَخۡبَارَهَا",
          "textImlaei": "يومئذ تحدث أخبارها",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 599,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "بِأَنَّ رَبَّكَ أَوۡحَىٰ لَهَا ﰄ",
          "textUthmaniBody": "بِأَنَّ رَبَّكَ أَوۡحَىٰ لَهَا",
          "textImlaei": "بأن ربك أوحى لها",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 599,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "يَوۡمَئِذٖ يَصۡدُرُ ٱلنَّاسُ أَشۡتَاتٗا لِّيُرَوۡاْ أَعۡمَٰلَهُمۡ ﰅ",
          "textUthmaniBody": "يَوۡمَئِذٖ يَصۡدُرُ ٱلنَّاسُ أَشۡتَاتٗا لِّيُرَوۡاْ أَعۡمَٰلَهُمۡ",
          "textImlaei": "يومئذ يصدر الناس أشتاتا ليروا أعمالهم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 599,
          "lineStart": 10,
          "lineEnd": 11,
          "textUthmaniRaw": "فَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٍ خَيۡرٗا يَرَهُۥ ﰆ",
          "textUthmaniBody": "فَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٍ خَيۡرٗا يَرَهُۥ",
          "textImlaei": "فمن يعمل مثقال ذرة خيرا يره",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 599,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "وَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٖ شَرّٗا يَرَهُۥ ﰇ",
          "textUthmaniBody": "وَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٖ شَرّٗا يَرَهُۥ",
          "textImlaei": "ومن يعمل مثقال ذرة شرا يره",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC07"
        }
      ]
    }
