          "textUthmaniRaw": "أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ ﰀ",
          "textUthmaniBody": "أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ",
          "textImlaei": "ألهاكم التكاثر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 600,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ ﰁ",
          "textUthmaniBody": "حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ",
          "textImlaei": "حتى زرتم المقابر",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 600,
          "lineStart": 13,
          "lineEnd": 13,
          "textUthmaniRaw": "كَلَّا سَوۡفَ تَعۡلَمُونَ ﰂ",
          "textUthmaniBody": "كَلَّا سَوۡفَ تَعۡلَمُونَ",
          "textImlaei": "كلا سوف تعلمون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 600,
          "lineStart": 13,
          "lineEnd": 14,
          "textUthmaniRaw": "ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ ﰃ",
          "textUthmaniBody": "ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ",
          "textImlaei": "ثم كلا سوف تعلمون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 600,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ ﰄ",
          "textUthmaniBody": "كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ",
          "textImlaei": "كلا لو تعلمون علم اليقين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 600,
          "lineStart": 14,
          "lineEnd": 14,
          "textUthmaniRaw": "لَتَرَوُنَّ ٱلۡجَحِيمَ ﰅ",
          "textUthmaniBody": "لَتَرَوُنَّ ٱلۡجَحِيمَ",
          "textImlaei": "لترون الجحيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 600,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ ﰆ",
          "textUthmaniBody": "ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ",
          "textImlaei": "ثم لترونها عين اليقين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        },
        {
          "ayah": 8,
          "page": 600,
          "lineStart": 15,
          "lineEnd": 15,
          "textUthmaniRaw": "ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ ﰇ",
          "textUthmaniBody": "ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ",
          "textImlaei": "ثم لتسألن يومئذ عن النعيم",
