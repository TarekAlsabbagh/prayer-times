        },
        {
          "ayah": 3,
          "page": 602,
          "lineStart": 4,
          "lineEnd": 4,
          "textUthmaniRaw": "فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ ﰂ",
          "textUthmaniBody": "فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ",
          "textImlaei": "فليعبدوا رب هذا البيت",
