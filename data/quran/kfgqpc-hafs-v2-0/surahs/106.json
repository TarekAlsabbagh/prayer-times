        },
        {
          "ayah": 4,
          "page": 602,
          "lineStart": 4,
          "lineEnd": 5,
          "textUthmaniRaw": "ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعٖ وَءَامَنَهُم مِّنۡ خَوۡفِۭ ﰃ",
          "textUthmaniBody": "ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعٖ وَءَامَنَهُم مِّنۡ خَوۡفِۭ",
