        {
          "ayah": 1,
          "page": 602,
          "lineStart": 8,
          "lineEnd": 8,
          "textUthmaniRaw": "أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ ﰀ",
          "textUthmaniBody": "أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ",
          "textImlaei": "أرأيت الذي يكذب بالدين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC00"
        },
        {
          "ayah": 2,
          "page": 602,
          "lineStart": 8,
          "lineEnd": 9,
          "textUthmaniRaw": "فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ ﰁ",
          "textUthmaniBody": "فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ",
          "textImlaei": "فذلك الذي يدع اليتيم",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC01"
        },
        {
          "ayah": 3,
          "page": 602,
          "lineStart": 9,
          "lineEnd": 9,
          "textUthmaniRaw": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ ﰂ",
          "textUthmaniBody": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ",
          "textImlaei": "ولا يحض على طعام المسكين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC02"
        },
        {
          "ayah": 4,
          "page": 602,
          "lineStart": 9,
          "lineEnd": 10,
          "textUthmaniRaw": "فَوَيۡلٞ لِّلۡمُصَلِّينَ ﰃ",
          "textUthmaniBody": "فَوَيۡلٞ لِّلۡمُصَلِّينَ",
          "textImlaei": "فويل للمصلين",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC03"
        },
        {
          "ayah": 5,
          "page": 602,
          "lineStart": 10,
          "lineEnd": 10,
          "textUthmaniRaw": "ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ ﰄ",
          "textUthmaniBody": "ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ",
          "textImlaei": "الذين هم عن صلاتهم ساهون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC04"
        },
        {
          "ayah": 6,
          "page": 602,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "ٱلَّذِينَ هُمۡ يُرَآءُونَ ﰅ",
          "textUthmaniBody": "ٱلَّذِينَ هُمۡ يُرَآءُونَ",
          "textImlaei": "الذين هم يراءون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC05"
        },
        {
          "ayah": 7,
          "page": 602,
          "lineStart": 11,
          "lineEnd": 11,
          "textUthmaniRaw": "وَيَمۡنَعُونَ ٱلۡمَاعُونَ ﰆ",
          "textUthmaniBody": "وَيَمۡنَعُونَ ٱلۡمَاعُونَ",
          "textImlaei": "ويمنعون الماعون",
          "rawEndSeparatorCodePoint": "U+00A0",
          "rawEndMarkerCodePoint": "U+FC06"
        }
      ]
