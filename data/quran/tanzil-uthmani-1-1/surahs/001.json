  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "ٱلرَّحْمَٰنِ ٱلرَّحِيمِ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "مَٰلِكِ يَوْمِ ٱلدِّينِ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ"
    }
  ]
}
