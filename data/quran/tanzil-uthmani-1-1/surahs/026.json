{
  "surah": 26,
  "nameAr": "الشعراء",
  "nameEn": "Ash-Shu'araa",
  "ayahCount": 227,
  "basmalaMode": "separate",
  "juz": [
    19
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "طسٓمٓ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "تِلْكَ ءَايَٰتُ ٱلْكِتَٰبِ ٱلْمُبِينِ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "لَعَلَّكَ بَٰخِعٌ نَّفْسَكَ أَلَّا يَكُونُوا۟ مُؤْمِنِينَ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "إِن نَّشَأْ نُنَزِّلْ عَلَيْهِم مِّنَ ٱلسَّمَآءِ ءَايَةً فَظَلَّتْ أَعْنَٰقُهُمْ لَهَا خَٰضِعِينَ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "وَمَا يَأْتِيهِم مِّن ذِكْرٍ مِّنَ ٱلرَّحْمَٰنِ مُحْدَثٍ إِلَّا كَانُوا۟ عَنْهُ مُعْرِضِينَ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "فَقَدْ كَذَّبُوا۟ فَسَيَأْتِيهِمْ أَنۢبَٰٓؤُا۟ مَا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "أَوَلَمْ يَرَوْا۟ إِلَى ٱلْأَرْضِ كَمْ أَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٍ كَرِيمٍ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "إِنَّ فِى ذَٰلِكَ لَـَٔايَةً وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "وَإِذْ نَادَىٰ رَبُّكَ مُوسَىٰٓ أَنِ ٱئْتِ ٱلْقَوْمَ ٱلظَّٰلِمِينَ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "قَوْمَ فِرْعَوْنَ أَلَا يَتَّقُونَ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "قَالَ رَبِّ إِنِّىٓ أَخَافُ أَن يُكَذِّبُونِ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "وَيَضِيقُ صَدْرِى وَلَا يَنطَلِقُ لِسَانِى فَأَرْسِلْ إِلَىٰ هَٰرُونَ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "وَلَهُمْ عَلَىَّ ذَنۢبٌ فَأَخَافُ أَن يَقْتُلُونِ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "قَالَ كَلَّا فَٱذْهَبَا بِـَٔايَٰتِنَآ إِنَّا مَعَكُم مُّسْتَمِعُونَ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "فَأْتِيَا فِرْعَوْنَ فَقُولَآ إِنَّا رَسُولُ رَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "أَنْ أَرْسِلْ مَعَنَا بَنِىٓ إِسْرَٰٓءِيلَ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "قَالَ أَلَمْ نُرَبِّكَ فِينَا وَلِيدًا وَلَبِثْتَ فِينَا مِنْ عُمُرِكَ سِنِينَ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "وَفَعَلْتَ فَعْلَتَكَ ٱلَّتِى فَعَلْتَ وَأَنتَ مِنَ ٱلْكَٰفِرِينَ"
    },
    {
      "ayah": 20,
      "textUthmaniBody": "قَالَ فَعَلْتُهَآ إِذًا وَأَنَا۠ مِنَ ٱلضَّآلِّينَ"
    },
    {
      "ayah": 21,
      "textUthmaniBody": "فَفَرَرْتُ مِنكُمْ لَمَّا خِفْتُكُمْ فَوَهَبَ لِى رَبِّى حُكْمًا وَجَعَلَنِى مِنَ ٱلْمُرْسَلِينَ"
    },
    {
      "ayah": 22,
      "textUthmaniBody": "وَتِلْكَ نِعْمَةٌ تَمُنُّهَا عَلَىَّ أَنْ عَبَّدتَّ بَنِىٓ إِسْرَٰٓءِيلَ"
    },
    {
      "ayah": 23,
      "textUthmaniBody": "قَالَ فِرْعَوْنُ وَمَا رَبُّ ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 24,
      "textUthmaniBody": "قَالَ رَبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ إِن كُنتُم مُّوقِنِينَ"
    },
    {
      "ayah": 25,
      "textUthmaniBody": "قَالَ لِمَنْ حَوْلَهُۥٓ أَلَا تَسْتَمِعُونَ"
    },
    {
      "ayah": 26,
      "textUthmaniBody": "قَالَ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ"
    },
    {
      "ayah": 27,
      "textUthmaniBody": "قَالَ إِنَّ رَسُولَكُمُ ٱلَّذِىٓ أُرْسِلَ إِلَيْكُمْ لَمَجْنُونٌ"
    },
    {
      "ayah": 28,
      "textUthmaniBody": "قَالَ رَبُّ ٱلْمَشْرِقِ وَٱلْمَغْرِبِ وَمَا بَيْنَهُمَآ إِن كُنتُمْ تَعْقِلُونَ"
    },
    {
      "ayah": 29,
      "textUthmaniBody": "قَالَ لَئِنِ ٱتَّخَذْتَ إِلَٰهًا غَيْرِى لَأَجْعَلَنَّكَ مِنَ ٱلْمَسْجُونِينَ"
    },
    {
      "ayah": 30,
      "textUthmaniBody": "قَالَ أَوَلَوْ جِئْتُكَ بِشَىْءٍ مُّبِينٍ"
    },
    {
      "ayah": 31,
      "textUthmaniBody": "قَالَ فَأْتِ بِهِۦٓ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ"
    },
    {
      "ayah": 32,
      "textUthmaniBody": "فَأَلْقَىٰ عَصَاهُ فَإِذَا هِىَ ثُعْبَانٌ مُّبِينٌ"
    },
    {
      "ayah": 33,
      "textUthmaniBody": "وَنَزَعَ يَدَهُۥ فَإِذَا هِىَ بَيْضَآءُ لِلنَّٰظِرِينَ"
    },
    {
      "ayah": 34,
      "textUthmaniBody": "قَالَ لِلْمَلَإِ حَوْلَهُۥٓ إِنَّ هَٰذَا لَسَٰحِرٌ عَلِيمٌ"
    },
    {
      "ayah": 35,
      "textUthmaniBody": "يُرِيدُ أَن يُخْرِجَكُم مِّنْ أَرْضِكُم بِسِحْرِهِۦ فَمَاذَا تَأْمُرُونَ"
    },
    {
      "ayah": 36,
      "textUthmaniBody": "قَالُوٓا۟ أَرْجِهْ وَأَخَاهُ وَٱبْعَثْ فِى ٱلْمَدَآئِنِ حَٰشِرِينَ"
    },
    {
      "ayah": 37,
      "textUthmaniBody": "يَأْتُوكَ بِكُلِّ سَحَّارٍ عَلِيمٍ"
    },
    {
      "ayah": 38,
      "textUthmaniBody": "فَجُمِعَ ٱلسَّحَرَةُ لِمِيقَٰتِ يَوْمٍ مَّعْلُومٍ"
    },
    {
      "ayah": 39,
      "textUthmaniBody": "وَقِيلَ لِلنَّاسِ هَلْ أَنتُم مُّجْتَمِعُونَ"
    },
    {
      "ayah": 40,
      "textUthmaniBody": "لَعَلَّنَا نَتَّبِعُ ٱلسَّحَرَةَ إِن كَانُوا۟ هُمُ ٱلْغَٰلِبِينَ"
    },
    {
      "ayah": 41,
      "textUthmaniBody": "فَلَمَّا جَآءَ ٱلسَّحَرَةُ قَالُوا۟ لِفِرْعَوْنَ أَئِنَّ لَنَا لَأَجْرًا إِن كُنَّا نَحْنُ ٱلْغَٰلِبِينَ"
    },
    {
      "ayah": 42,
      "textUthmaniBody": "قَالَ نَعَمْ وَإِنَّكُمْ إِذًا لَّمِنَ ٱلْمُقَرَّبِينَ"
    },
    {
      "ayah": 43,
      "textUthmaniBody": "قَالَ لَهُم مُّوسَىٰٓ أَلْقُوا۟ مَآ أَنتُم مُّلْقُونَ"
    },
    {
      "ayah": 44,
      "textUthmaniBody": "فَأَلْقَوْا۟ حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُوا۟ بِعِزَّةِ فِرْعَوْنَ إِنَّا لَنَحْنُ ٱلْغَٰلِبُونَ"
    },
    {
      "ayah": 45,
      "textUthmaniBody": "فَأَلْقَىٰ مُوسَىٰ عَصَاهُ فَإِذَا هِىَ تَلْقَفُ مَا يَأْفِكُونَ"
    },
    {
      "ayah": 46,
      "textUthmaniBody": "فَأُلْقِىَ ٱلسَّحَرَةُ سَٰجِدِينَ"
    },
    {
      "ayah": 47,
      "textUthmaniBody": "قَالُوٓا۟ ءَامَنَّا بِرَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 48,
      "textUthmaniBody": "رَبِّ مُوسَىٰ وَهَٰرُونَ"
    },
    {
      "ayah": 49,
      "textUthmaniBody": "قَالَ ءَامَنتُمْ لَهُۥ قَبْلَ أَنْ ءَاذَنَ لَكُمْ إِنَّهُۥ لَكَبِيرُكُمُ ٱلَّذِى عَلَّمَكُمُ ٱلسِّحْرَ فَلَسَوْفَ تَعْلَمُونَ لَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ خِلَٰفٍ وَلَأُصَلِّبَنَّكُمْ أَجْمَعِينَ"
    },
    {
      "ayah": 50,
      "textUthmaniBody": "قَالُوا۟ لَا ضَيْرَ إِنَّآ إِلَىٰ رَبِّنَا مُنقَلِبُونَ"
    },
    {
      "ayah": 51,
      "textUthmaniBody": "إِنَّا نَطْمَعُ أَن يَغْفِرَ لَنَا رَبُّنَا خَطَٰيَٰنَآ أَن كُنَّآ أَوَّلَ ٱلْمُؤْمِنِينَ"
    },
    {
      "ayah": 52,
      "textUthmaniBody": "وَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ أَنْ أَسْرِ بِعِبَادِىٓ إِنَّكُم مُّتَّبَعُونَ"
    },
    {
      "ayah": 53,
      "textUthmaniBody": "فَأَرْسَلَ فِرْعَوْنُ فِى ٱلْمَدَآئِنِ حَٰشِرِينَ"
    },
    {
      "ayah": 54,
      "textUthmaniBody": "إِنَّ هَٰٓؤُلَآءِ لَشِرْذِمَةٌ قَلِيلُونَ"
    },
    {
      "ayah": 55,
      "textUthmaniBody": "وَإِنَّهُمْ لَنَا لَغَآئِظُونَ"
    },
    {
      "ayah": 56,
      "textUthmaniBody": "وَإِنَّا لَجَمِيعٌ حَٰذِرُونَ"
    },
    {
      "ayah": 57,
      "textUthmaniBody": "فَأَخْرَجْنَٰهُم مِّن جَنَّٰتٍ وَعُيُونٍ"
    },
    {
      "ayah": 58,
      "textUthmaniBody": "وَكُنُوزٍ وَمَقَامٍ كَرِيمٍ"
    },
    {
      "ayah": 59,
      "textUthmaniBody": "كَذَٰلِكَ وَأَوْرَثْنَٰهَا بَنِىٓ إِسْرَٰٓءِيلَ"
    },
    {
      "ayah": 60,
      "textUthmaniBody": "فَأَتْبَعُوهُم مُّشْرِقِينَ"
    },
    {
      "ayah": 61,
      "textUthmaniBody": "فَلَمَّا تَرَٰٓءَا ٱلْجَمْعَانِ قَالَ أَصْحَٰبُ مُوسَىٰٓ إِنَّا لَمُدْرَكُونَ"
    },
    {
      "ayah": 62,
      "textUthmaniBody": "قَالَ كَلَّآ إِنَّ مَعِىَ رَبِّى سَيَهْدِينِ"
    },
    {
      "ayah": 63,
      "textUthmaniBody": "فَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ أَنِ ٱضْرِب بِّعَصَاكَ ٱلْبَحْرَ فَٱنفَلَقَ فَكَانَ كُلُّ فِرْقٍ كَٱلطَّوْدِ ٱلْعَظِيمِ"
    },
    {
      "ayah": 64,
      "textUthmaniBody": "وَأَزْلَفْنَا ثَمَّ ٱلْـَٔاخَرِينَ"
    },
    {
      "ayah": 65,
      "textUthmaniBody": "وَأَنجَيْنَا مُوسَىٰ وَمَن مَّعَهُۥٓ أَجْمَعِينَ"
    },
    {
      "ayah": 66,
      "textUthmaniBody": "ثُمَّ أَغْرَقْنَا ٱلْـَٔاخَرِينَ"
    },
    {
      "ayah": 67,
      "textUthmaniBody": "إِنَّ فِى ذَٰلِكَ لَـَٔايَةً وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ"
    },
    {
      "ayah": 68,
      "textUthmaniBody": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"
    },
    {
      "ayah": 69,
      "textUthmaniBody": "وَٱتْلُ عَلَيْهِمْ نَبَأَ إِبْرَٰهِيمَ"
    },
    {
      "ayah": 70,
      "textUthmaniBody": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَا تَعْبُدُونَ"
    },
    {
      "ayah": 71,
      "textUthmaniBody": "قَالُوا۟ نَعْبُدُ أَصْنَامًا فَنَظَلُّ لَهَا عَٰكِفِينَ"
    },
    {
      "ayah": 72,
      "textUthmaniBody": "قَالَ هَلْ يَسْمَعُونَكُمْ إِذْ تَدْعُونَ"
    },
    {
      "ayah": 73,
      "textUthmaniBody": "أَوْ يَنفَعُونَكُمْ أَوْ يَضُرُّونَ"
    },
    {
      "ayah": 74,
      "textUthmaniBody": "قَالُوا۟ بَلْ وَجَدْنَآ ءَابَآءَنَا كَذَٰلِكَ يَفْعَلُونَ"
    },
    {
      "ayah": 75,
      "textUthmaniBody": "قَالَ أَفَرَءَيْتُم مَّا كُنتُمْ تَعْبُدُونَ"
    },
    {
      "ayah": 76,
      "textUthmaniBody": "أَنتُمْ وَءَابَآؤُكُمُ ٱلْأَقْدَمُونَ"
    },
    {
      "ayah": 77,
      "textUthmaniBody": "فَإِنَّهُمْ عَدُوٌّ لِّىٓ إِلَّا رَبَّ ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 78,
      "textUthmaniBody": "ٱلَّذِى خَلَقَنِى فَهُوَ يَهْدِينِ"
    },
    {
      "ayah": 79,
      "textUthmaniBody": "وَٱلَّذِى هُوَ يُطْعِمُنِى وَيَسْقِينِ"
    },
    {
      "ayah": 80,
      "textUthmaniBody": "وَإِذَا مَرِضْتُ فَهُوَ يَشْفِينِ"
    },
    {
      "ayah": 81,
      "textUthmaniBody": "وَٱلَّذِى يُمِيتُنِى ثُمَّ يُحْيِينِ"
    },
    {
      "ayah": 82,
      "textUthmaniBody": "وَٱلَّذِىٓ أَطْمَعُ أَن يَغْفِرَ لِى خَطِيٓـَٔتِى يَوْمَ ٱلدِّينِ"
    },
    {
      "ayah": 83,
      "textUthmaniBody": "رَبِّ هَبْ لِى حُكْمًا وَأَلْحِقْنِى بِٱلصَّٰلِحِينَ"
    },
    {
      "ayah": 84,
      "textUthmaniBody": "وَٱجْعَل لِّى لِسَانَ صِدْقٍ فِى ٱلْـَٔاخِرِينَ"
    },
    {
      "ayah": 85,
      "textUthmaniBody": "وَٱجْعَلْنِى مِن وَرَثَةِ جَنَّةِ ٱلنَّعِيمِ"
    },
    {
      "ayah": 86,
      "textUthmaniBody": "وَٱغْفِرْ لِأَبِىٓ إِنَّهُۥ كَانَ مِنَ ٱلضَّآلِّينَ"
    },
    {
      "ayah": 87,
      "textUthmaniBody": "وَلَا تُخْزِنِى يَوْمَ يُبْعَثُونَ"
    },
    {
      "ayah": 88,
      "textUthmaniBody": "يَوْمَ لَا يَنفَعُ مَالٌ وَلَا بَنُونَ"
    },
    {
      "ayah": 89,
      "textUthmaniBody": "إِلَّا مَنْ أَتَى ٱللَّهَ بِقَلْبٍ سَلِيمٍ"
    },
    {
      "ayah": 90,
      "textUthmaniBody": "وَأُزْلِفَتِ ٱلْجَنَّةُ لِلْمُتَّقِينَ"
    },
    {
      "ayah": 91,
      "textUthmaniBody": "وَبُرِّزَتِ ٱلْجَحِيمُ لِلْغَاوِينَ"
    },
    {
      "ayah": 92,
      "textUthmaniBody": "وَقِيلَ لَهُمْ أَيْنَ مَا كُنتُمْ تَعْبُدُونَ"
    },
    {
      "ayah": 93,
      "textUthmaniBody": "مِن دُونِ ٱللَّهِ هَلْ يَنصُرُونَكُمْ أَوْ يَنتَصِرُونَ"
    },
    {
      "ayah": 94,
      "textUthmaniBody": "فَكُبْكِبُوا۟ فِيهَا هُمْ وَٱلْغَاوُۥنَ"
    },
    {
      "ayah": 95,
      "textUthmaniBody": "وَجُنُودُ إِبْلِيسَ أَجْمَعُونَ"
    },
    {
      "ayah": 96,
      "textUthmaniBody": "قَالُوا۟ وَهُمْ فِيهَا يَخْتَصِمُونَ"
    },
    {
      "ayah": 97,
      "textUthmaniBody": "تَٱللَّهِ إِن كُنَّا لَفِى ضَلَٰلٍ مُّبِينٍ"
    },
    {
      "ayah": 98,
      "textUthmaniBody": "إِذْ نُسَوِّيكُم بِرَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 99,
      "textUthmaniBody": "وَمَآ أَضَلَّنَآ إِلَّا ٱلْمُجْرِمُونَ"
    },
    {
      "ayah": 100,
      "textUthmaniBody": "فَمَا لَنَا مِن شَٰفِعِينَ"
    },
    {
      "ayah": 101,
      "textUthmaniBody": "وَلَا صَدِيقٍ حَمِيمٍ"
    },
    {
      "ayah": 102,
      "textUthmaniBody": "فَلَوْ أَنَّ لَنَا كَرَّةً فَنَكُونَ مِنَ ٱلْمُؤْمِنِينَ"
    },
    {
      "ayah": 103,
      "textUthmaniBody": "إِنَّ فِى ذَٰلِكَ لَـَٔايَةً وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ"
    },
    {
      "ayah": 104,
      "textUthmaniBody": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"
    },
    {
      "ayah": 105,
      "textUthmaniBody": "كَذَّبَتْ قَوْمُ نُوحٍ ٱلْمُرْسَلِينَ"
    },
    {
      "ayah": 106,
      "textUthmaniBody": "إِذْ قَالَ لَهُمْ أَخُوهُمْ نُوحٌ أَلَا تَتَّقُونَ"
    },
    {
      "ayah": 107,
      "textUthmaniBody": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌ"
    },
    {
      "ayah": 108,
      "textUthmaniBody": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
      "ayah": 109,
      "textUthmaniBody": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 110,
      "textUthmaniBody": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
      "ayah": 111,
      "textUthmaniBody": "قَالُوٓا۟ أَنُؤْمِنُ لَكَ وَٱتَّبَعَكَ ٱلْأَرْذَلُونَ"
    },
    {
      "ayah": 112,
      "textUthmaniBody": "قَالَ وَمَا عِلْمِى بِمَا كَانُوا۟ يَعْمَلُونَ"
    },
    {
      "ayah": 113,
      "textUthmaniBody": "إِنْ حِسَابُهُمْ إِلَّا عَلَىٰ رَبِّى لَوْ تَشْعُرُونَ"
    },
    {
      "ayah": 114,
      "textUthmaniBody": "وَمَآ أَنَا۠ بِطَارِدِ ٱلْمُؤْمِنِينَ"
    },
    {
      "ayah": 115,
      "textUthmaniBody": "إِنْ أَنَا۠ إِلَّا نَذِيرٌ مُّبِينٌ"
    },
    {
      "ayah": 116,
      "textUthmaniBody": "قَالُوا۟ لَئِن لَّمْ تَنتَهِ يَٰنُوحُ لَتَكُونَنَّ مِنَ ٱلْمَرْجُومِينَ"
    },
    {
      "ayah": 117,
      "textUthmaniBody": "قَالَ رَبِّ إِنَّ قَوْمِى كَذَّبُونِ"
    },
    {
      "ayah": 118,
      "textUthmaniBody": "فَٱفْتَحْ بَيْنِى وَبَيْنَهُمْ فَتْحًا وَنَجِّنِى وَمَن مَّعِىَ مِنَ ٱلْمُؤْمِنِينَ"
    },
    {
      "ayah": 119,
      "textUthmaniBody": "فَأَنجَيْنَٰهُ وَمَن مَّعَهُۥ فِى ٱلْفُلْكِ ٱلْمَشْحُونِ"
    },
    {
      "ayah": 120,
      "textUthmaniBody": "ثُمَّ أَغْرَقْنَا بَعْدُ ٱلْبَاقِينَ"
    },
    {
      "ayah": 121,
      "textUthmaniBody": "إِنَّ فِى ذَٰلِكَ لَـَٔايَةً وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ"
    },
    {
      "ayah": 122,
      "textUthmaniBody": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"
    },
    {
      "ayah": 123,
      "textUthmaniBody": "كَذَّبَتْ عَادٌ ٱلْمُرْسَلِينَ"
    },
    {
      "ayah": 124,
      "textUthmaniBody": "إِذْ قَالَ لَهُمْ أَخُوهُمْ هُودٌ أَلَا تَتَّقُونَ"
    },
    {
      "ayah": 125,
      "textUthmaniBody": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌ"
    },
    {
      "ayah": 126,
      "textUthmaniBody": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
      "ayah": 127,
      "textUthmaniBody": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 128,
      "textUthmaniBody": "أَتَبْنُونَ بِكُلِّ رِيعٍ ءَايَةً تَعْبَثُونَ"
    },
    {
      "ayah": 129,
      "textUthmaniBody": "وَتَتَّخِذُونَ مَصَانِعَ لَعَلَّكُمْ تَخْلُدُونَ"
    },
    {
      "ayah": 130,
      "textUthmaniBody": "وَإِذَا بَطَشْتُم بَطَشْتُمْ جَبَّارِينَ"
    },
    {
      "ayah": 131,
      "textUthmaniBody": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
      "ayah": 132,
      "textUthmaniBody": "وَٱتَّقُوا۟ ٱلَّذِىٓ أَمَدَّكُم بِمَا تَعْلَمُونَ"
    },
    {
      "ayah": 133,
      "textUthmaniBody": "أَمَدَّكُم بِأَنْعَٰمٍ وَبَنِينَ"
    },
    {
      "ayah": 134,
      "textUthmaniBody": "وَجَنَّٰتٍ وَعُيُونٍ"
    },
    {
      "ayah": 135,
      "textUthmaniBody": "إِنِّىٓ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظِيمٍ"
    },
    {
      "ayah": 136,
      "textUthmaniBody": "قَالُوا۟ سَوَآءٌ عَلَيْنَآ أَوَعَظْتَ أَمْ لَمْ تَكُن مِّنَ ٱلْوَٰعِظِينَ"
    },
    {
      "ayah": 137,
      "textUthmaniBody": "إِنْ هَٰذَآ إِلَّا خُلُقُ ٱلْأَوَّلِينَ"
    },
    {
      "ayah": 138,
      "textUthmaniBody": "وَمَا نَحْنُ بِمُعَذَّبِينَ"
    },
    {
      "ayah": 139,
      "textUthmaniBody": "فَكَذَّبُوهُ فَأَهْلَكْنَٰهُمْ إِنَّ فِى ذَٰلِكَ لَـَٔايَةً وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ"
    },
    {
      "ayah": 140,
      "textUthmaniBody": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"
    },
    {
      "ayah": 141,
      "textUthmaniBody": "كَذَّبَتْ ثَمُودُ ٱلْمُرْسَلِينَ"
    },
    {
      "ayah": 142,
      "textUthmaniBody": "إِذْ قَالَ لَهُمْ أَخُوهُمْ صَٰلِحٌ أَلَا تَتَّقُونَ"
    },
    {
      "ayah": 143,
      "textUthmaniBody": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌ"
    },
    {
      "ayah": 144,
      "textUthmaniBody": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
      "ayah": 145,
      "textUthmaniBody": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 146,
      "textUthmaniBody": "أَتُتْرَكُونَ فِى مَا هَٰهُنَآ ءَامِنِينَ"
    },
    {
      "ayah": 147,
      "textUthmaniBody": "فِى جَنَّٰتٍ وَعُيُونٍ"
    },
    {
      "ayah": 148,
      "textUthmaniBody": "وَزُرُوعٍ وَنَخْلٍ طَلْعُهَا هَضِيمٌ"
    },
    {
      "ayah": 149,
      "textUthmaniBody": "وَتَنْحِتُونَ مِنَ ٱلْجِبَالِ بُيُوتًا فَٰرِهِينَ"
    },
    {
      "ayah": 150,
      "textUthmaniBody": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
      "ayah": 151,
      "textUthmaniBody": "وَلَا تُطِيعُوٓا۟ أَمْرَ ٱلْمُسْرِفِينَ"
    },
    {
      "ayah": 152,
      "textUthmaniBody": "ٱلَّذِينَ يُفْسِدُونَ فِى ٱلْأَرْضِ وَلَا يُصْلِحُونَ"
    },
    {
      "ayah": 153,
      "textUthmaniBody": "قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ"
    },
    {
      "ayah": 154,
      "textUthmaniBody": "مَآ أَنتَ إِلَّا بَشَرٌ مِّثْلُنَا فَأْتِ بِـَٔايَةٍ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ"
    },
    {
      "ayah": 155,
      "textUthmaniBody": "قَالَ هَٰذِهِۦ نَاقَةٌ لَّهَا شِرْبٌ وَلَكُمْ شِرْبُ يَوْمٍ مَّعْلُومٍ"
    },
    {
      "ayah": 156,
      "textUthmaniBody": "وَلَا تَمَسُّوهَا بِسُوٓءٍ فَيَأْخُذَكُمْ عَذَابُ يَوْمٍ عَظِيمٍ"
    },
    {
      "ayah": 157,
      "textUthmaniBody": "فَعَقَرُوهَا فَأَصْبَحُوا۟ نَٰدِمِينَ"
    },
    {
      "ayah": 158,
      "textUthmaniBody": "فَأَخَذَهُمُ ٱلْعَذَابُ إِنَّ فِى ذَٰلِكَ لَـَٔايَةً وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ"
    },
    {
      "ayah": 159,
      "textUthmaniBody": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"
    },
    {
      "ayah": 160,
      "textUthmaniBody": "كَذَّبَتْ قَوْمُ لُوطٍ ٱلْمُرْسَلِينَ"
    },
    {
      "ayah": 161,
      "textUthmaniBody": "إِذْ قَالَ لَهُمْ أَخُوهُمْ لُوطٌ أَلَا تَتَّقُونَ"
    },
    {
      "ayah": 162,
      "textUthmaniBody": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌ"
    },
    {
      "ayah": 163,
      "textUthmaniBody": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
      "ayah": 164,
      "textUthmaniBody": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 165,
      "textUthmaniBody": "أَتَأْتُونَ ٱلذُّكْرَانَ مِنَ ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 166,
      "textUthmaniBody": "وَتَذَرُونَ مَا خَلَقَ لَكُمْ رَبُّكُم مِّنْ أَزْوَٰجِكُم بَلْ أَنتُمْ قَوْمٌ عَادُونَ"
    },
    {
      "ayah": 167,
      "textUthmaniBody": "قَالُوا۟ لَئِن لَّمْ تَنتَهِ يَٰلُوطُ لَتَكُونَنَّ مِنَ ٱلْمُخْرَجِينَ"
    },
    {
      "ayah": 168,
      "textUthmaniBody": "قَالَ إِنِّى لِعَمَلِكُم مِّنَ ٱلْقَالِينَ"
    },
    {
      "ayah": 169,
      "textUthmaniBody": "رَبِّ نَجِّنِى وَأَهْلِى مِمَّا يَعْمَلُونَ"
    },
    {
      "ayah": 170,
      "textUthmaniBody": "فَنَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ"
    },
    {
      "ayah": 171,
      "textUthmaniBody": "إِلَّا عَجُوزًا فِى ٱلْغَٰبِرِينَ"
    },
    {
      "ayah": 172,
      "textUthmaniBody": "ثُمَّ دَمَّرْنَا ٱلْـَٔاخَرِينَ"
    },
    {
      "ayah": 173,
      "textUthmaniBody": "وَأَمْطَرْنَا عَلَيْهِم مَّطَرًا فَسَآءَ مَطَرُ ٱلْمُنذَرِينَ"
    },
    {
      "ayah": 174,
      "textUthmaniBody": "إِنَّ فِى ذَٰلِكَ لَـَٔايَةً وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ"
    },
    {
      "ayah": 175,
      "textUthmaniBody": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"
    },
    {
      "ayah": 176,
      "textUthmaniBody": "كَذَّبَ أَصْحَٰبُ لْـَٔيْكَةِ ٱلْمُرْسَلِينَ"
    },
    {
      "ayah": 177,
      "textUthmaniBody": "إِذْ قَالَ لَهُمْ شُعَيْبٌ أَلَا تَتَّقُونَ"
    },
    {
      "ayah": 178,
      "textUthmaniBody": "إِنِّى لَكُمْ رَسُولٌ أَمِينٌ"
    },
    {
      "ayah": 179,
      "textUthmaniBody": "فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ"
    },
    {
      "ayah": 180,
      "textUthmaniBody": "وَمَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ إِنْ أَجْرِىَ إِلَّا عَلَىٰ رَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 181,
      "textUthmaniBody": "أَوْفُوا۟ ٱلْكَيْلَ وَلَا تَكُونُوا۟ مِنَ ٱلْمُخْسِرِينَ"
    },
    {
      "ayah": 182,
      "textUthmaniBody": "وَزِنُوا۟ بِٱلْقِسْطَاسِ ٱلْمُسْتَقِيمِ"
    },
    {
      "ayah": 183,
      "textUthmaniBody": "وَلَا تَبْخَسُوا۟ ٱلنَّاسَ أَشْيَآءَهُمْ وَلَا تَعْثَوْا۟ فِى ٱلْأَرْضِ مُفْسِدِينَ"
    },
    {
      "ayah": 184,
      "textUthmaniBody": "وَٱتَّقُوا۟ ٱلَّذِى خَلَقَكُمْ وَٱلْجِبِلَّةَ ٱلْأَوَّلِينَ"
    },
    {
      "ayah": 185,
      "textUthmaniBody": "قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ"
    },
    {
      "ayah": 186,
      "textUthmaniBody": "وَمَآ أَنتَ إِلَّا بَشَرٌ مِّثْلُنَا وَإِن نَّظُنُّكَ لَمِنَ ٱلْكَٰذِبِينَ"
    },
    {
      "ayah": 187,
      "textUthmaniBody": "فَأَسْقِطْ عَلَيْنَا كِسَفًا مِّنَ ٱلسَّمَآءِ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ"
    },
    {
      "ayah": 188,
      "textUthmaniBody": "قَالَ رَبِّىٓ أَعْلَمُ بِمَا تَعْمَلُونَ"
    },
    {
      "ayah": 189,
      "textUthmaniBody": "فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ ٱلظُّلَّةِ إِنَّهُۥ كَانَ عَذَابَ يَوْمٍ عَظِيمٍ"
    },
    {
      "ayah": 190,
      "textUthmaniBody": "إِنَّ فِى ذَٰلِكَ لَـَٔايَةً وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ"
    },
    {
      "ayah": 191,
      "textUthmaniBody": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ"
    },
    {
      "ayah": 192,
      "textUthmaniBody": "وَإِنَّهُۥ لَتَنزِيلُ رَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 193,
      "textUthmaniBody": "نَزَلَ بِهِ ٱلرُّوحُ ٱلْأَمِينُ"
    },
    {
      "ayah": 194,
      "textUthmaniBody": "عَلَىٰ قَلْبِكَ لِتَكُونَ مِنَ ٱلْمُنذِرِينَ"
    },
    {
      "ayah": 195,
      "textUthmaniBody": "بِلِسَانٍ عَرَبِىٍّ مُّبِينٍ"
    },
    {
      "ayah": 196,
      "textUthmaniBody": "وَإِنَّهُۥ لَفِى زُبُرِ ٱلْأَوَّلِينَ"
    },
    {
      "ayah": 197,
      "textUthmaniBody": "أَوَلَمْ يَكُن لَّهُمْ ءَايَةً أَن يَعْلَمَهُۥ عُلَمَٰٓؤُا۟ بَنِىٓ إِسْرَٰٓءِيلَ"
    },
    {
      "ayah": 198,
      "textUthmaniBody": "وَلَوْ نَزَّلْنَٰهُ عَلَىٰ بَعْضِ ٱلْأَعْجَمِينَ"
    },
    {
      "ayah": 199,
      "textUthmaniBody": "فَقَرَأَهُۥ عَلَيْهِم مَّا كَانُوا۟ بِهِۦ مُؤْمِنِينَ"
    },
    {
      "ayah": 200,
      "textUthmaniBody": "كَذَٰلِكَ سَلَكْنَٰهُ فِى قُلُوبِ ٱلْمُجْرِمِينَ"
    },
    {
      "ayah": 201,
      "textUthmaniBody": "لَا يُؤْمِنُونَ بِهِۦ حَتَّىٰ يَرَوُا۟ ٱلْعَذَابَ ٱلْأَلِيمَ"
    },
    {
      "ayah": 202,
      "textUthmaniBody": "فَيَأْتِيَهُم بَغْتَةً وَهُمْ لَا يَشْعُرُونَ"
    },
    {
      "ayah": 203,
      "textUthmaniBody": "فَيَقُولُوا۟ هَلْ نَحْنُ مُنظَرُونَ"
    },
    {
      "ayah": 204,
      "textUthmaniBody": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"
    },
    {
      "ayah": 205,
      "textUthmaniBody": "أَفَرَءَيْتَ إِن مَّتَّعْنَٰهُمْ سِنِينَ"
    },
    {
      "ayah": 206,
      "textUthmaniBody": "ثُمَّ جَآءَهُم مَّا كَانُوا۟ يُوعَدُونَ"
    },
    {
      "ayah": 207,
      "textUthmaniBody": "مَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يُمَتَّعُونَ"
    },
    {
      "ayah": 208,
      "textUthmaniBody": "وَمَآ أَهْلَكْنَا مِن قَرْيَةٍ إِلَّا لَهَا مُنذِرُونَ"
    },
    {
      "ayah": 209,
      "textUthmaniBody": "ذِكْرَىٰ وَمَا كُنَّا ظَٰلِمِينَ"
    },
    {
      "ayah": 210,
      "textUthmaniBody": "وَمَا تَنَزَّلَتْ بِهِ ٱلشَّيَٰطِينُ"
    },
    {
      "ayah": 211,
      "textUthmaniBody": "وَمَا يَنۢبَغِى لَهُمْ وَمَا يَسْتَطِيعُونَ"
    },
    {
      "ayah": 212,
      "textUthmaniBody": "إِنَّهُمْ عَنِ ٱلسَّمْعِ لَمَعْزُولُونَ"
    },
    {
      "ayah": 213,
      "textUthmaniBody": "فَلَا تَدْعُ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ فَتَكُونَ مِنَ ٱلْمُعَذَّبِينَ"
    },
    {
      "ayah": 214,
      "textUthmaniBody": "وَأَنذِرْ عَشِيرَتَكَ ٱلْأَقْرَبِينَ"
    },
    {
      "ayah": 215,
      "textUthmaniBody": "وَٱخْفِضْ جَنَاحَكَ لِمَنِ ٱتَّبَعَكَ مِنَ ٱلْمُؤْمِنِينَ"
    },
    {
      "ayah": 216,
      "textUthmaniBody": "فَإِنْ عَصَوْكَ فَقُلْ إِنِّى بَرِىٓءٌ مِّمَّا تَعْمَلُونَ"
    },
    {
      "ayah": 217,
      "textUthmaniBody": "وَتَوَكَّلْ عَلَى ٱلْعَزِيزِ ٱلرَّحِيمِ"
    },
    {
      "ayah": 218,
      "textUthmaniBody": "ٱلَّذِى يَرَىٰكَ حِينَ تَقُومُ"
    },
    {
      "ayah": 219,
      "textUthmaniBody": "وَتَقَلُّبَكَ فِى ٱلسَّٰجِدِينَ"
    },
    {
      "ayah": 220,
      "textUthmaniBody": "إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ"
    },
    {
      "ayah": 221,
      "textUthmaniBody": "هَلْ أُنَبِّئُكُمْ عَلَىٰ مَن تَنَزَّلُ ٱلشَّيَٰطِينُ"
    },
    {
      "ayah": 222,
      "textUthmaniBody": "تَنَزَّلُ عَلَىٰ كُلِّ أَفَّاكٍ أَثِيمٍ"
    },
    {
      "ayah": 223,
      "textUthmaniBody": "يُلْقُونَ ٱلسَّمْعَ وَأَكْثَرُهُمْ كَٰذِبُونَ"
    },
    {
      "ayah": 224,
      "textUthmaniBody": "وَٱلشُّعَرَآءُ يَتَّبِعُهُمُ ٱلْغَاوُۥنَ"
    },
    {
      "ayah": 225,
      "textUthmaniBody": "أَلَمْ تَرَ أَنَّهُمْ فِى كُلِّ وَادٍ يَهِيمُونَ"
    },
    {
      "ayah": 226,
      "textUthmaniBody": "وَأَنَّهُمْ يَقُولُونَ مَا لَا يَفْعَلُونَ"
    },
    {
      "ayah": 227,
      "textUthmaniBody": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَذَكَرُوا۟ ٱللَّهَ كَثِيرًا وَٱنتَصَرُوا۟ مِنۢ بَعْدِ مَا ظُلِمُوا۟ وَسَيَعْلَمُ ٱلَّذِينَ ظَلَمُوٓا۟ أَىَّ مُنقَلَبٍ يَنقَلِبُونَ"
    }
  ]
}
