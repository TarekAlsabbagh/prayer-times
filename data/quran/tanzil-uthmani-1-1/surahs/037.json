{
  "surah": 37,
  "nameAr": "الصافات",
  "nameEn": "As-Saaffaat",
  "ayahCount": 182,
  "basmalaMode": "separate",
  "juz": [
    23
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "وَٱلصَّٰٓفَّٰتِ صَفًّا"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "فَٱلزَّٰجِرَٰتِ زَجْرًا"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "فَٱلتَّٰلِيَٰتِ ذِكْرًا"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "إِنَّ إِلَٰهَكُمْ لَوَٰحِدٌ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَٰرِقِ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "وَحِفْظًا مِّن كُلِّ شَيْطَٰنٍ مَّارِدٍ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "دُحُورًا وَلَهُمْ عَذَابٌ وَاصِبٌ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌ ثَاقِبٌ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ إِنَّا خَلَقْنَٰهُم مِّن طِينٍ لَّازِبٍۭ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "بَلْ عَجِبْتَ وَيَسْخَرُونَ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "وَإِذَا رَأَوْا۟ ءَايَةً يَسْتَسْخِرُونَ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "وَقَالُوٓا۟ إِنْ هَٰذَآ إِلَّا سِحْرٌ مُّبِينٌ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ"
    },
    {
      "ayah": 20,
      "textUthmaniBody": "وَقَالُوا۟ يَٰوَيْلَنَا هَٰذَا يَوْمُ ٱلدِّينِ"
    },
    {
      "ayah": 21,
      "textUthmaniBody": "هَٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ"
    },
    {
      "ayah": 22,
      "textUthmaniBody": "ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ"
    },
    {
      "ayah": 23,
      "textUthmaniBody": "مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ"
    },
    {
      "ayah": 24,
      "textUthmaniBody": "وَقِفُوهُمْ إِنَّهُم مَّسْـُٔولُونَ"
    },
    {
      "ayah": 25,
      "textUthmaniBody": "مَا لَكُمْ لَا تَنَاصَرُونَ"
    },
    {
      "ayah": 26,
      "textUthmaniBody": "بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ"
    },
    {
      "ayah": 27,
      "textUthmaniBody": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ"
    },
    {
      "ayah": 28,
      "textUthmaniBody": "قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ"
    },
    {
      "ayah": 29,
      "textUthmaniBody": "قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ"
    },
    {
      "ayah": 30,
      "textUthmaniBody": "وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنٍۭ بَلْ كُنتُمْ قَوْمًا طَٰغِينَ"
    },
    {
      "ayah": 31,
      "textUthmaniBody": "فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ إِنَّا لَذَآئِقُونَ"
    },
    {
      "ayah": 32,
      "textUthmaniBody": "فَأَغْوَيْنَٰكُمْ إِنَّا كُنَّا غَٰوِينَ"
    },
    {
      "ayah": 33,
      "textUthmaniBody": "فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ"
    },
    {
      "ayah": 34,
      "textUthmaniBody": "إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"
    },
    {
      "ayah": 35,
      "textUthmaniBody": "إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ"
    },
    {
      "ayah": 36,
      "textUthmaniBody": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍۭ"
    },
    {
      "ayah": 37,
      "textUthmaniBody": "بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ"
    },
    {
      "ayah": 38,
      "textUthmaniBody": "إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ"
    },
    {
      "ayah": 39,
      "textUthmaniBody": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ"
    },
    {
      "ayah": 40,
      "textUthmaniBody": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"
    },
    {
      "ayah": 41,
      "textUthmaniBody": "أُو۟لَٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ"
    },
    {
      "ayah": 42,
      "textUthmaniBody": "فَوَٰكِهُ وَهُم مُّكْرَمُونَ"
    },
    {
      "ayah": 43,
      "textUthmaniBody": "فِى جَنَّٰتِ ٱلنَّعِيمِ"
    },
    {
      "ayah": 44,
      "textUthmaniBody": "عَلَىٰ سُرُرٍ مُّتَقَٰبِلِينَ"
    },
    {
      "ayah": 45,
      "textUthmaniBody": "يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ"
    },
    {
      "ayah": 46,
      "textUthmaniBody": "بَيْضَآءَ لَذَّةٍ لِّلشَّٰرِبِينَ"
    },
    {
      "ayah": 47,
      "textUthmaniBody": "لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ"
    },
    {
      "ayah": 48,
      "textUthmaniBody": "وَعِندَهُمْ قَٰصِرَٰتُ ٱلطَّرْفِ عِينٌ"
    },
    {
      "ayah": 49,
      "textUthmaniBody": "كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ"
    },
    {
      "ayah": 50,
      "textUthmaniBody": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ"
    },
    {
      "ayah": 51,
      "textUthmaniBody": "قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ"
    },
    {
      "ayah": 52,
      "textUthmaniBody": "يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ"
    },
    {
      "ayah": 53,
      "textUthmaniBody": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ"
    },
    {
      "ayah": 54,
      "textUthmaniBody": "قَالَ هَلْ أَنتُم مُّطَّلِعُونَ"
    },
    {
      "ayah": 55,
      "textUthmaniBody": "فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ"
    },
    {
      "ayah": 56,
      "textUthmaniBody": "قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ"
    },
    {
      "ayah": 57,
      "textUthmaniBody": "وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ"
    },
    {
      "ayah": 58,
      "textUthmaniBody": "أَفَمَا نَحْنُ بِمَيِّتِينَ"
    },
    {
      "ayah": 59,
      "textUthmaniBody": "إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ"
    },
    {
      "ayah": 60,
      "textUthmaniBody": "إِنَّ هَٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ"
    },
    {
      "ayah": 61,
      "textUthmaniBody": "لِمِثْلِ هَٰذَا فَلْيَعْمَلِ ٱلْعَٰمِلُونَ"
    },
    {
      "ayah": 62,
      "textUthmaniBody": "أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ"
    },
    {
      "ayah": 63,
      "textUthmaniBody": "إِنَّا جَعَلْنَٰهَا فِتْنَةً لِّلظَّٰلِمِينَ"
    },
    {
      "ayah": 64,
      "textUthmaniBody": "إِنَّهَا شَجَرَةٌ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ"
    },
    {
      "ayah": 65,
      "textUthmaniBody": "طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ"
    },
    {
      "ayah": 66,
      "textUthmaniBody": "فَإِنَّهُمْ لَـَٔاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ"
    },
    {
      "ayah": 67,
      "textUthmaniBody": "ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ"
    },
    {
      "ayah": 68,
      "textUthmaniBody": "ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ"
    },
    {
      "ayah": 69,
      "textUthmaniBody": "إِنَّهُمْ أَلْفَوْا۟ ءَابَآءَهُمْ ضَآلِّينَ"
    },
    {
      "ayah": 70,
      "textUthmaniBody": "فَهُمْ عَلَىٰٓ ءَاثَٰرِهِمْ يُهْرَعُونَ"
    },
    {
      "ayah": 71,
      "textUthmaniBody": "وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ"
    },
    {
      "ayah": 72,
      "textUthmaniBody": "وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ"
    },
    {
      "ayah": 73,
      "textUthmaniBody": "فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُنذَرِينَ"
    },
    {
      "ayah": 74,
      "textUthmaniBody": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"
    },
    {
      "ayah": 75,
      "textUthmaniBody": "وَلَقَدْ نَادَىٰنَا نُوحٌ فَلَنِعْمَ ٱلْمُجِيبُونَ"
    },
    {
      "ayah": 76,
      "textUthmaniBody": "وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ"
    },
    {
      "ayah": 77,
      "textUthmaniBody": "وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ ٱلْبَاقِينَ"
    },
    {
      "ayah": 78,
      "textUthmaniBody": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"
    },
    {
      "ayah": 79,
      "textUthmaniBody": "سَلَٰمٌ عَلَىٰ نُوحٍ فِى ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 80,
      "textUthmaniBody": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"
    },
    {
      "ayah": 81,
      "textUthmaniBody": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"
    },
    {
      "ayah": 82,
      "textUthmaniBody": "ثُمَّ أَغْرَقْنَا ٱلْـَٔاخَرِينَ"
    },
    {
      "ayah": 83,
      "textUthmaniBody": "وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ"
    },
    {
      "ayah": 84,
      "textUthmaniBody": "إِذْ جَآءَ رَبَّهُۥ بِقَلْبٍ سَلِيمٍ"
    },
    {
      "ayah": 85,
      "textUthmaniBody": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَ"
    },
    {
      "ayah": 86,
      "textUthmaniBody": "أَئِفْكًا ءَالِهَةً دُونَ ٱللَّهِ تُرِيدُونَ"
    },
    {
      "ayah": 87,
      "textUthmaniBody": "فَمَا ظَنُّكُم بِرَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 88,
      "textUthmaniBody": "فَنَظَرَ نَظْرَةً فِى ٱلنُّجُومِ"
    },
    {
      "ayah": 89,
      "textUthmaniBody": "فَقَالَ إِنِّى سَقِيمٌ"
    },
    {
      "ayah": 90,
      "textUthmaniBody": "فَتَوَلَّوْا۟ عَنْهُ مُدْبِرِينَ"
    },
    {
      "ayah": 91,
      "textUthmaniBody": "فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ"
    },
    {
      "ayah": 92,
      "textUthmaniBody": "مَا لَكُمْ لَا تَنطِقُونَ"
    },
    {
      "ayah": 93,
      "textUthmaniBody": "فَرَاغَ عَلَيْهِمْ ضَرْبًۢا بِٱلْيَمِينِ"
    },
    {
      "ayah": 94,
      "textUthmaniBody": "فَأَقْبَلُوٓا۟ إِلَيْهِ يَزِفُّونَ"
    },
    {
      "ayah": 95,
      "textUthmaniBody": "قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ"
    },
    {
      "ayah": 96,
      "textUthmaniBody": "وَٱللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ"
    },
    {
      "ayah": 97,
      "textUthmaniBody": "قَالُوا۟ ٱبْنُوا۟ لَهُۥ بُنْيَٰنًا فَأَلْقُوهُ فِى ٱلْجَحِيمِ"
    },
    {
      "ayah": 98,
      "textUthmaniBody": "فَأَرَادُوا۟ بِهِۦ كَيْدًا فَجَعَلْنَٰهُمُ ٱلْأَسْفَلِينَ"
    },
    {
      "ayah": 99,
      "textUthmaniBody": "وَقَالَ إِنِّى ذَاهِبٌ إِلَىٰ رَبِّى سَيَهْدِينِ"
    },
    {
      "ayah": 100,
      "textUthmaniBody": "رَبِّ هَبْ لِى مِنَ ٱلصَّٰلِحِينَ"
    },
    {
      "ayah": 101,
      "textUthmaniBody": "فَبَشَّرْنَٰهُ بِغُلَٰمٍ حَلِيمٍ"
    },
    {
      "ayah": 102,
      "textUthmaniBody": "فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعْىَ قَالَ يَٰبُنَىَّ إِنِّىٓ أَرَىٰ فِى ٱلْمَنَامِ أَنِّىٓ أَذْبَحُكَ فَٱنظُرْ مَاذَا تَرَىٰ قَالَ يَٰٓأَبَتِ ٱفْعَلْ مَا تُؤْمَرُ سَتَجِدُنِىٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰبِرِينَ"
    },
    {
      "ayah": 103,
      "textUthmaniBody": "فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ"
    },
    {
      "ayah": 104,
      "textUthmaniBody": "وَنَٰدَيْنَٰهُ أَن يَٰٓإِبْرَٰهِيمُ"
    },
    {
      "ayah": 105,
      "textUthmaniBody": "قَدْ صَدَّقْتَ ٱلرُّءْيَآ إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"
    },
    {
      "ayah": 106,
      "textUthmaniBody": "إِنَّ هَٰذَا لَهُوَ ٱلْبَلَٰٓؤُا۟ ٱلْمُبِينُ"
    },
    {
      "ayah": 107,
      "textUthmaniBody": "وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمٍ"
    },
    {
      "ayah": 108,
      "textUthmaniBody": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"
    },
    {
      "ayah": 109,
      "textUthmaniBody": "سَلَٰمٌ عَلَىٰٓ إِبْرَٰهِيمَ"
    },
    {
      "ayah": 110,
      "textUthmaniBody": "كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"
    },
    {
      "ayah": 111,
      "textUthmaniBody": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"
    },
    {
      "ayah": 112,
      "textUthmaniBody": "وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيًّا مِّنَ ٱلصَّٰلِحِينَ"
    },
    {
      "ayah": 113,
      "textUthmaniBody": "وَبَٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ إِسْحَٰقَ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌ وَظَالِمٌ لِّنَفْسِهِۦ مُبِينٌ"
    },
    {
      "ayah": 114,
      "textUthmaniBody": "وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ"
    },
    {
      "ayah": 115,
      "textUthmaniBody": "وَنَجَّيْنَٰهُمَا وَقَوْمَهُمَا مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ"
    },
    {
      "ayah": 116,
      "textUthmaniBody": "وَنَصَرْنَٰهُمْ فَكَانُوا۟ هُمُ ٱلْغَٰلِبِينَ"
    },
    {
      "ayah": 117,
      "textUthmaniBody": "وَءَاتَيْنَٰهُمَا ٱلْكِتَٰبَ ٱلْمُسْتَبِينَ"
    },
    {
      "ayah": 118,
      "textUthmaniBody": "وَهَدَيْنَٰهُمَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ"
    },
    {
      "ayah": 119,
      "textUthmaniBody": "وَتَرَكْنَا عَلَيْهِمَا فِى ٱلْـَٔاخِرِينَ"
    },
    {
      "ayah": 120,
      "textUthmaniBody": "سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ"
    },
    {
      "ayah": 121,
      "textUthmaniBody": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"
    },
    {
      "ayah": 122,
      "textUthmaniBody": "إِنَّهُمَا مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"
    },
    {
      "ayah": 123,
      "textUthmaniBody": "وَإِنَّ إِلْيَاسَ لَمِنَ ٱلْمُرْسَلِينَ"
    },
    {
      "ayah": 124,
      "textUthmaniBody": "إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ"
    },
    {
      "ayah": 125,
      "textUthmaniBody": "أَتَدْعُونَ بَعْلًا وَتَذَرُونَ أَحْسَنَ ٱلْخَٰلِقِينَ"
    },
    {
      "ayah": 126,
      "textUthmaniBody": "ٱللَّهَ رَبَّكُمْ وَرَبَّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ"
    },
    {
      "ayah": 127,
      "textUthmaniBody": "فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ"
    },
    {
      "ayah": 128,
      "textUthmaniBody": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"
    },
    {
      "ayah": 129,
      "textUthmaniBody": "وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ"
    },
    {
      "ayah": 130,
      "textUthmaniBody": "سَلَٰمٌ عَلَىٰٓ إِلْ يَاسِينَ"
    },
    {
      "ayah": 131,
      "textUthmaniBody": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"
    },
    {
      "ayah": 132,
      "textUthmaniBody": "إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ"
    },
    {
      "ayah": 133,
      "textUthmaniBody": "وَإِنَّ لُوطًا لَّمِنَ ٱلْمُرْسَلِينَ"
    },
    {
      "ayah": 134,
      "textUthmaniBody": "إِذْ نَجَّيْنَٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ"
    },
    {
      "ayah": 135,
      "textUthmaniBody": "إِلَّا عَجُوزًا فِى ٱلْغَٰبِرِينَ"
    },
    {
      "ayah": 136,
      "textUthmaniBody": "ثُمَّ دَمَّرْنَا ٱلْـَٔاخَرِينَ"
    },
    {
      "ayah": 137,
      "textUthmaniBody": "وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ"
    },
    {
      "ayah": 138,
      "textUthmaniBody": "وَبِٱلَّيْلِ أَفَلَا تَعْقِلُونَ"
    },
    {
      "ayah": 139,
      "textUthmaniBody": "وَإِنَّ يُونُسَ لَمِنَ ٱلْمُرْسَلِينَ"
    },
    {
      "ayah": 140,
      "textUthmaniBody": "إِذْ أَبَقَ إِلَى ٱلْفُلْكِ ٱلْمَشْحُونِ"
    },
    {
      "ayah": 141,
      "textUthmaniBody": "فَسَاهَمَ فَكَانَ مِنَ ٱلْمُدْحَضِينَ"
    },
    {
      "ayah": 142,
      "textUthmaniBody": "فَٱلْتَقَمَهُ ٱلْحُوتُ وَهُوَ مُلِيمٌ"
    },
    {
      "ayah": 143,
      "textUthmaniBody": "فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ ٱلْمُسَبِّحِينَ"
    },
    {
      "ayah": 144,
      "textUthmaniBody": "لَلَبِثَ فِى بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَ"
    },
    {
      "ayah": 145,
      "textUthmaniBody": "فَنَبَذْنَٰهُ بِٱلْعَرَآءِ وَهُوَ سَقِيمٌ"
    },
    {
      "ayah": 146,
      "textUthmaniBody": "وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةً مِّن يَقْطِينٍ"
    },
    {
      "ayah": 147,
      "textUthmaniBody": "وَأَرْسَلْنَٰهُ إِلَىٰ مِا۟ئَةِ أَلْفٍ أَوْ يَزِيدُونَ"
    },
    {
      "ayah": 148,
      "textUthmaniBody": "فَـَٔامَنُوا۟ فَمَتَّعْنَٰهُمْ إِلَىٰ حِينٍ"
    },
    {
      "ayah": 149,
      "textUthmaniBody": "فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ"
    },
    {
      "ayah": 150,
      "textUthmaniBody": "أَمْ خَلَقْنَا ٱلْمَلَٰٓئِكَةَ إِنَٰثًا وَهُمْ شَٰهِدُونَ"
    },
    {
      "ayah": 151,
      "textUthmaniBody": "أَلَآ إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ"
    },
    {
      "ayah": 152,
      "textUthmaniBody": "وَلَدَ ٱللَّهُ وَإِنَّهُمْ لَكَٰذِبُونَ"
    },
    {
      "ayah": 153,
      "textUthmaniBody": "أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ"
    },
    {
      "ayah": 154,
      "textUthmaniBody": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ"
    },
    {
      "ayah": 155,
      "textUthmaniBody": "أَفَلَا تَذَكَّرُونَ"
    },
    {
      "ayah": 156,
      "textUthmaniBody": "أَمْ لَكُمْ سُلْطَٰنٌ مُّبِينٌ"
    },
    {
      "ayah": 157,
      "textUthmaniBody": "فَأْتُوا۟ بِكِتَٰبِكُمْ إِن كُنتُمْ صَٰدِقِينَ"
    },
    {
      "ayah": 158,
      "textUthmaniBody": "وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًا وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ"
    },
    {
      "ayah": 159,
      "textUthmaniBody": "سُبْحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ"
    },
    {
      "ayah": 160,
      "textUthmaniBody": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"
    },
    {
      "ayah": 161,
      "textUthmaniBody": "فَإِنَّكُمْ وَمَا تَعْبُدُونَ"
    },
    {
      "ayah": 162,
      "textUthmaniBody": "مَآ أَنتُمْ عَلَيْهِ بِفَٰتِنِينَ"
    },
    {
      "ayah": 163,
      "textUthmaniBody": "إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ"
    },
    {
      "ayah": 164,
      "textUthmaniBody": "وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌ مَّعْلُومٌ"
    },
    {
      "ayah": 165,
      "textUthmaniBody": "وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ"
    },
    {
      "ayah": 166,
      "textUthmaniBody": "وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ"
    },
    {
      "ayah": 167,
      "textUthmaniBody": "وَإِن كَانُوا۟ لَيَقُولُونَ"
    },
    {
      "ayah": 168,
      "textUthmaniBody": "لَوْ أَنَّ عِندَنَا ذِكْرًا مِّنَ ٱلْأَوَّلِينَ"
    },
    {
      "ayah": 169,
      "textUthmaniBody": "لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ"
    },
    {
      "ayah": 170,
      "textUthmaniBody": "فَكَفَرُوا۟ بِهِۦ فَسَوْفَ يَعْلَمُونَ"
    },
    {
      "ayah": 171,
      "textUthmaniBody": "وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ"
    },
    {
      "ayah": 172,
      "textUthmaniBody": "إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ"
    },
    {
      "ayah": 173,
      "textUthmaniBody": "وَإِنَّ جُندَنَا لَهُمُ ٱلْغَٰلِبُونَ"
    },
    {
      "ayah": 174,
      "textUthmaniBody": "فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"
    },
    {
      "ayah": 175,
      "textUthmaniBody": "وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ"
    },
    {
      "ayah": 176,
      "textUthmaniBody": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"
    },
    {
      "ayah": 177,
      "textUthmaniBody": "فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ"
    },
    {
      "ayah": 178,
      "textUthmaniBody": "وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ"
    },
    {
      "ayah": 179,
      "textUthmaniBody": "وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ"
    },
    {
      "ayah": 180,
      "textUthmaniBody": "سُبْحَٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ"
    },
    {
      "ayah": 181,
      "textUthmaniBody": "وَسَلَٰمٌ عَلَى ٱلْمُرْسَلِينَ"
    },
    {
      "ayah": 182,
      "textUthmaniBody": "وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ"
    }
  ]
}
