{
  "surah": 55,
  "nameAr": "الرحمن",
  "nameEn": "Ar-Rahmaan",
  "ayahCount": 78,
  "basmalaMode": "separate",
  "juz": [
    27
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "ٱلرَّحْمَٰنُ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "عَلَّمَ ٱلْقُرْءَانَ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "خَلَقَ ٱلْإِنسَٰنَ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "عَلَّمَهُ ٱلْبَيَانَ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "فِيهَا فَٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍ كَٱلْفَخَّارِ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ"
    },
    {
      "ayah": 20,
      "textUthmaniBody": "بَيْنَهُمَا بَرْزَخٌ لَّا يَبْغِيَانِ"
    },
    {
      "ayah": 21,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 22,
      "textUthmaniBody": "يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ"
    },
    {
      "ayah": 23,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 24,
      "textUthmaniBody": "وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَٰمِ"
    },
    {
      "ayah": 25,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 26,
      "textUthmaniBody": "كُلُّ مَنْ عَلَيْهَا فَانٍ"
    },
    {
      "ayah": 27,
      "textUthmaniBody": "وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَٰلِ وَٱلْإِكْرَامِ"
    },
    {
      "ayah": 28,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 29,
      "textUthmaniBody": "يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍ"
    },
    {
      "ayah": 30,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 31,
      "textUthmaniBody": "سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ"
    },
    {
      "ayah": 32,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 33,
      "textUthmaniBody": "يَٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ لَا تَنفُذُونَ إِلَّا بِسُلْطَٰنٍ"
    },
    {
      "ayah": 34,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 35,
      "textUthmaniBody": "يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ"
    },
    {
      "ayah": 36,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 37,
      "textUthmaniBody": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةً كَٱلدِّهَانِ"
    },
    {
      "ayah": 38,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 39,
      "textUthmaniBody": "فَيَوْمَئِذٍ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌ وَلَا جَآنٌّ"
    },
    {
      "ayah": 40,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 41,
      "textUthmaniBody": "يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ"
    },
    {
      "ayah": 42,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 43,
      "textUthmaniBody": "هَٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ"
    },
    {
      "ayah": 44,
      "textUthmaniBody": "يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍ"
    },
    {
      "ayah": 45,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 46,
      "textUthmaniBody": "وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ"
    },
    {
      "ayah": 47,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 48,
      "textUthmaniBody": "ذَوَاتَآ أَفْنَانٍ"
    },
    {
      "ayah": 49,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 50,
      "textUthmaniBody": "فِيهِمَا عَيْنَانِ تَجْرِيَانِ"
    },
    {
      "ayah": 51,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 52,
      "textUthmaniBody": "فِيهِمَا مِن كُلِّ فَٰكِهَةٍ زَوْجَانِ"
    },
    {
      "ayah": 53,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 54,
      "textUthmaniBody": "مُتَّكِـِٔينَ عَلَىٰ فُرُشٍۭ بَطَآئِنُهَا مِنْ إِسْتَبْرَقٍ وَجَنَى ٱلْجَنَّتَيْنِ دَانٍ"
    },
    {
      "ayah": 55,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 56,
      "textUthmaniBody": "فِيهِنَّ قَٰصِرَٰتُ ٱلطَّرْفِ لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ"
    },
    {
      "ayah": 57,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 58,
      "textUthmaniBody": "كَأَنَّهُنَّ ٱلْيَاقُوتُ وَٱلْمَرْجَانُ"
    },
    {
      "ayah": 59,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 60,
      "textUthmaniBody": "هَلْ جَزَآءُ ٱلْإِحْسَٰنِ إِلَّا ٱلْإِحْسَٰنُ"
    },
    {
      "ayah": 61,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 62,
      "textUthmaniBody": "وَمِن دُونِهِمَا جَنَّتَانِ"
    },
    {
      "ayah": 63,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 64,
      "textUthmaniBody": "مُدْهَآمَّتَانِ"
    },
    {
      "ayah": 65,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 66,
      "textUthmaniBody": "فِيهِمَا عَيْنَانِ نَضَّاخَتَانِ"
    },
    {
      "ayah": 67,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 68,
      "textUthmaniBody": "فِيهِمَا فَٰكِهَةٌ وَنَخْلٌ وَرُمَّانٌ"
    },
    {
      "ayah": 69,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 70,
      "textUthmaniBody": "فِيهِنَّ خَيْرَٰتٌ حِسَانٌ"
    },
    {
      "ayah": 71,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 72,
      "textUthmaniBody": "حُورٌ مَّقْصُورَٰتٌ فِى ٱلْخِيَامِ"
    },
    {
      "ayah": 73,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 74,
      "textUthmaniBody": "لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ"
    },
    {
      "ayah": 75,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 76,
      "textUthmaniBody": "مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍ وَعَبْقَرِىٍّ حِسَانٍ"
    },
    {
      "ayah": 77,
      "textUthmaniBody": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "ayah": 78,
      "textUthmaniBody": "تَبَٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَٰلِ وَٱلْإِكْرَامِ"
    }
  ]
}
