{
  "surah": 56,
  "nameAr": "الواقعة",
  "nameEn": "Al-Waaqia",
  "ayahCount": 96,
  "basmalaMode": "separate",
  "juz": [
    27
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "إِذَا وَقَعَتِ ٱلْوَاقِعَةُ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "خَافِضَةٌ رَّافِعَةٌ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "وَبُسَّتِ ٱلْجِبَالُ بَسًّا"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "فَكَانَتْ هَبَآءً مُّنۢبَثًّا"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "وَكُنتُمْ أَزْوَٰجًا ثَلَٰثَةً"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "فِى جَنَّٰتِ ٱلنَّعِيمِ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "وَقَلِيلٌ مِّنَ ٱلْـَٔاخِرِينَ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "عَلَىٰ سُرُرٍ مَّوْضُونَةٍ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ"
    },
    {
      "ayah": 20,
      "textUthmaniBody": "وَفَٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ"
    },
    {
      "ayah": 21,
      "textUthmaniBody": "وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ"
    },
    {
      "ayah": 22,
      "textUthmaniBody": "وَحُورٌ عِينٌ"
    },
    {
      "ayah": 23,
      "textUthmaniBody": "كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ"
    },
    {
      "ayah": 24,
      "textUthmaniBody": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ"
    },
    {
      "ayah": 25,
      "textUthmaniBody": "لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا"
    },
    {
      "ayah": 26,
      "textUthmaniBody": "إِلَّا قِيلًا سَلَٰمًا سَلَٰمًا"
    },
    {
      "ayah": 27,
      "textUthmaniBody": "وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ"
    },
    {
      "ayah": 28,
      "textUthmaniBody": "فِى سِدْرٍ مَّخْضُودٍ"
    },
    {
      "ayah": 29,
      "textUthmaniBody": "وَطَلْحٍ مَّنضُودٍ"
    },
    {
      "ayah": 30,
      "textUthmaniBody": "وَظِلٍّ مَّمْدُودٍ"
    },
    {
      "ayah": 31,
      "textUthmaniBody": "وَمَآءٍ مَّسْكُوبٍ"
    },
    {
      "ayah": 32,
      "textUthmaniBody": "وَفَٰكِهَةٍ كَثِيرَةٍ"
    },
    {
      "ayah": 33,
      "textUthmaniBody": "لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ"
    },
    {
      "ayah": 34,
      "textUthmaniBody": "وَفُرُشٍ مَّرْفُوعَةٍ"
    },
    {
      "ayah": 35,
      "textUthmaniBody": "إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءً"
    },
    {
      "ayah": 36,
      "textUthmaniBody": "فَجَعَلْنَٰهُنَّ أَبْكَارًا"
    },
    {
      "ayah": 37,
      "textUthmaniBody": "عُرُبًا أَتْرَابًا"
    },
    {
      "ayah": 38,
      "textUthmaniBody": "لِّأَصْحَٰبِ ٱلْيَمِينِ"
    },
    {
      "ayah": 39,
      "textUthmaniBody": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ"
    },
    {
      "ayah": 40,
      "textUthmaniBody": "وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ"
    },
    {
      "ayah": 41,
      "textUthmaniBody": "وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ"
    },
    {
      "ayah": 42,
      "textUthmaniBody": "فِى سَمُومٍ وَحَمِيمٍ"
    },
    {
      "ayah": 43,
      "textUthmaniBody": "وَظِلٍّ مِّن يَحْمُومٍ"
    },
    {
      "ayah": 44,
      "textUthmaniBody": "لَّا بَارِدٍ وَلَا كَرِيمٍ"
    },
    {
      "ayah": 45,
      "textUthmaniBody": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ"
    },
    {
      "ayah": 46,
      "textUthmaniBody": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ"
    },
    {
      "ayah": 47,
      "textUthmaniBody": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ"
    },
    {
      "ayah": 48,
      "textUthmaniBody": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ"
    },
    {
      "ayah": 49,
      "textUthmaniBody": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْـَٔاخِرِينَ"
    },
    {
      "ayah": 50,
      "textUthmaniBody": "لَمَجْمُوعُونَ إِلَىٰ مِيقَٰتِ يَوْمٍ مَّعْلُومٍ"
    },
    {
      "ayah": 51,
      "textUthmaniBody": "ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ"
    },
    {
      "ayah": 52,
      "textUthmaniBody": "لَـَٔاكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ"
    },
    {
      "ayah": 53,
      "textUthmaniBody": "فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ"
    },
    {
      "ayah": 54,
      "textUthmaniBody": "فَشَٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ"
    },
    {
      "ayah": 55,
      "textUthmaniBody": "فَشَٰرِبُونَ شُرْبَ ٱلْهِيمِ"
    },
    {
      "ayah": 56,
      "textUthmaniBody": "هَٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ"
    },
    {
      "ayah": 57,
      "textUthmaniBody": "نَحْنُ خَلَقْنَٰكُمْ فَلَوْلَا تُصَدِّقُونَ"
    },
    {
      "ayah": 58,
      "textUthmaniBody": "أَفَرَءَيْتُم مَّا تُمْنُونَ"
    },
    {
      "ayah": 59,
      "textUthmaniBody": "ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَٰلِقُونَ"
    },
    {
      "ayah": 60,
      "textUthmaniBody": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ"
    },
    {
      "ayah": 61,
      "textUthmaniBody": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ"
    },
    {
      "ayah": 62,
      "textUthmaniBody": "وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ"
    },
    {
      "ayah": 63,
      "textUthmaniBody": "أَفَرَءَيْتُم مَّا تَحْرُثُونَ"
    },
    {
      "ayah": 64,
      "textUthmaniBody": "ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ"
    },
    {
      "ayah": 65,
      "textUthmaniBody": "لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰمًا فَظَلْتُمْ تَفَكَّهُونَ"
    },
    {
      "ayah": 66,
      "textUthmaniBody": "إِنَّا لَمُغْرَمُونَ"
    },
    {
      "ayah": 67,
      "textUthmaniBody": "بَلْ نَحْنُ مَحْرُومُونَ"
    },
    {
      "ayah": 68,
      "textUthmaniBody": "أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ"
    },
    {
      "ayah": 69,
      "textUthmaniBody": "ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ"
    },
    {
      "ayah": 70,
      "textUthmaniBody": "لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ"
    },
    {
      "ayah": 71,
      "textUthmaniBody": "أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ"
    },
    {
      "ayah": 72,
      "textUthmaniBody": "ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ"
    },
    {
      "ayah": 73,
      "textUthmaniBody": "نَحْنُ جَعَلْنَٰهَا تَذْكِرَةً وَمَتَٰعًا لِّلْمُقْوِينَ"
    },
    {
      "ayah": 74,
      "textUthmaniBody": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"
    },
    {
      "ayah": 75,
      "textUthmaniBody": "فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ"
    },
    {
      "ayah": 76,
      "textUthmaniBody": "وَإِنَّهُۥ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ"
    },
    {
      "ayah": 77,
      "textUthmaniBody": "إِنَّهُۥ لَقُرْءَانٌ كَرِيمٌ"
    },
    {
      "ayah": 78,
      "textUthmaniBody": "فِى كِتَٰبٍ مَّكْنُونٍ"
    },
    {
      "ayah": 79,
      "textUthmaniBody": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ"
    },
    {
      "ayah": 80,
      "textUthmaniBody": "تَنزِيلٌ مِّن رَّبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 81,
      "textUthmaniBody": "أَفَبِهَٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ"
    },
    {
      "ayah": 82,
      "textUthmaniBody": "وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ"
    },
    {
      "ayah": 83,
      "textUthmaniBody": "فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ"
    },
    {
      "ayah": 84,
      "textUthmaniBody": "وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ"
    },
    {
      "ayah": 85,
      "textUthmaniBody": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ"
    },
    {
      "ayah": 86,
      "textUthmaniBody": "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ"
    },
    {
      "ayah": 87,
      "textUthmaniBody": "تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَ"
    },
    {
      "ayah": 88,
      "textUthmaniBody": "فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ"
    },
    {
      "ayah": 89,
      "textUthmaniBody": "فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ"
    },
    {
      "ayah": 90,
      "textUthmaniBody": "وَأَمَّآ إِن كَانَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ"
    },
    {
      "ayah": 91,
      "textUthmaniBody": "فَسَلَٰمٌ لَّكَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ"
    },
    {
      "ayah": 92,
      "textUthmaniBody": "وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ"
    },
    {
      "ayah": 93,
      "textUthmaniBody": "فَنُزُلٌ مِّنْ حَمِيمٍ"
    },
    {
      "ayah": 94,
      "textUthmaniBody": "وَتَصْلِيَةُ جَحِيمٍ"
    },
    {
      "ayah": 95,
      "textUthmaniBody": "إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ"
    },
    {
      "ayah": 96,
      "textUthmaniBody": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ"
    }
  ]
}
