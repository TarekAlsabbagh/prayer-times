  "surah": 75,
  "nameAr": "Ø§ÙÙÙØ§ÙØ©",
  "nameEn": "Al-Qiyaama",
  "ayahCount": 40,
  "basmalaMode": "separate",
  "juz": [
    29
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "فَإِذَا بَرِقَ ٱلْبَصَرُ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "وَخَسَفَ ٱلْقَمَرُ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "كَلَّا لَا وَزَرَ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ"
    },
    {
      "ayah": 20,
      "textUthmaniBody": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ"
    },
    {
      "ayah": 21,
      "textUthmaniBody": "وَتَذَرُونَ ٱلْـَٔاخِرَةَ"
    },
    {
      "ayah": 22,
      "textUthmaniBody": "وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ"
    },
    {
      "ayah": 23,
      "textUthmaniBody": "إِلَىٰ رَبِّهَا نَاظِرَةٌ"
    },
    {
      "ayah": 24,
      "textUthmaniBody": "وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ"
    },
    {
      "ayah": 25,
      "textUthmaniBody": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ"
    },
    {
      "ayah": 26,
      "textUthmaniBody": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ"
    },
    {
      "ayah": 27,
      "textUthmaniBody": "وَقِيلَ مَنْ رَاقٍ"
    },
    {
      "ayah": 28,
      "textUthmaniBody": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ"
    },
    {
      "ayah": 29,
      "textUthmaniBody": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ"
    },
    {
      "ayah": 30,
      "textUthmaniBody": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ"
    },
    {
      "ayah": 31,
      "textUthmaniBody": "فَلَا صَدَّقَ وَلَا صَلَّىٰ"
    },
    {
      "ayah": 32,
      "textUthmaniBody": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ"
    },
    {
      "ayah": 33,
      "textUthmaniBody": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ"
    },
    {
      "ayah": 34,
      "textUthmaniBody": "أَوْلَىٰ لَكَ فَأَوْلَىٰ"
    },
    {
      "ayah": 35,
      "textUthmaniBody": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ"
    },
    {
      "ayah": 36,
      "textUthmaniBody": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَن يُتْرَكَ سُدًى"
    },
    {
      "ayah": 37,
      "textUthmaniBody": "أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ"
    },
    {
      "ayah": 38,
      "textUthmaniBody": "ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ"
    },
    {
      "ayah": 39,
      "textUthmaniBody": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"
    },
    {
      "ayah": 40,
      "textUthmaniBody": "أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ"
    }
  ]
}
