{
  "surah": 77,
  "nameAr": "Ø§ÙÙØ±Ø³ÙØ§Øª",
  "nameEn": "Al-Mursalaat",
  "ayahCount": 50,
  "basmalaMode": "separate",
  "juz": [
    29
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "وَٱلْمُرْسَلَٰتِ عُرْفًا"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "فَٱلْعَٰصِفَٰتِ عَصْفًا"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "وَٱلنَّٰشِرَٰتِ نَشْرًا"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "فَٱلْفَٰرِقَٰتِ فَرْقًا"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "فَٱلْمُلْقِيَٰتِ ذِكْرًا"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "عُذْرًا أَوْ نُذْرًا"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "لِأَىِّ يَوْمٍ أُجِّلَتْ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "لِيَوْمِ ٱلْفَصْلِ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"
    },
    {
      "ayah": 20,
      "textUthmaniBody": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ"
    },
    {
      "ayah": 21,
      "textUthmaniBody": "فَجَعَلْنَٰهُ فِى قَرَارٍ مَّكِينٍ"
    },
    {
      "ayah": 22,
      "textUthmaniBody": "إِلَىٰ قَدَرٍ مَّعْلُومٍ"
    },
    {
      "ayah": 23,
      "textUthmaniBody": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ"
    },
    {
      "ayah": 24,
      "textUthmaniBody": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"
    },
    {
      "ayah": 25,
      "textUthmaniBody": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا"
    },
    {
      "ayah": 26,
      "textUthmaniBody": "أَحْيَآءً وَأَمْوَٰتًا"
    },
    {
      "ayah": 27,
      "textUthmaniBody": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍ وَأَسْقَيْنَٰكُم مَّآءً فُرَاتًا"
    },
    {
      "ayah": 28,
      "textUthmaniBody": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"
    },
    {
      "ayah": 29,
      "textUthmaniBody": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ"
    },
    {
      "ayah": 30,
      "textUthmaniBody": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَٰثِ شُعَبٍ"
    },
    {
      "ayah": 31,
      "textUthmaniBody": "لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ"
    },
    {
      "ayah": 32,
      "textUthmaniBody": "إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ"
    },
    {
      "ayah": 33,
      "textUthmaniBody": "كَأَنَّهُۥ جِمَٰلَتٌ صُفْرٌ"
    },
    {
      "ayah": 34,
      "textUthmaniBody": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"
    },
    {
      "ayah": 35,
      "textUthmaniBody": "هَٰذَا يَوْمُ لَا يَنطِقُونَ"
    },
    {
      "ayah": 36,
      "textUthmaniBody": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ"
    },
    {
      "ayah": 37,
      "textUthmaniBody": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"
    },
    {
      "ayah": 38,
      "textUthmaniBody": "هَٰذَا يَوْمُ ٱلْفَصْلِ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ"
    },
    {
      "ayah": 39,
      "textUthmaniBody": "فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ"
    },
    {
      "ayah": 40,
      "textUthmaniBody": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"
    },
    {
      "ayah": 41,
      "textUthmaniBody": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍ وَعُيُونٍ"
    },
    {
      "ayah": 42,
      "textUthmaniBody": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ"
    },
    {
      "ayah": 43,
      "textUthmaniBody": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ"
    },
    {
      "ayah": 44,
      "textUthmaniBody": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ"
    },
    {
      "ayah": 45,
      "textUthmaniBody": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"
    },
    {
      "ayah": 46,
      "textUthmaniBody": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ"
    },
    {
      "ayah": 47,
      "textUthmaniBody": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"
    },
    {
      "ayah": 48,
      "textUthmaniBody": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ"
    },
    {
      "ayah": 49,
      "textUthmaniBody": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"
    },
    {
      "ayah": 50,
      "textUthmaniBody": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ"
    }
  ]
}
