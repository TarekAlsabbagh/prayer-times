{
  "surah": 78,
  "nameAr": "النبإ",
  "nameEn": "An-Naba",
  "ayahCount": 40,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "عَمَّ يَتَسَآءَلُونَ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "كَلَّا سَيَعْلَمُونَ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "ثُمَّ كَلَّا سَيَعْلَمُونَ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًا"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "وَٱلْجِبَالَ أَوْتَادًا"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "وَخَلَقْنَٰكُمْ أَزْوَٰجًا"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "وَجَعَلْنَا سِرَاجًا وَهَّاجًا"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "وَجَنَّٰتٍ أَلْفَافًا"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًا"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا"
    },
    {
      "ayah": 20,
      "textUthmaniBody": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا"
    },
    {
      "ayah": 21,
      "textUthmaniBody": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا"
    },
    {
      "ayah": 22,
      "textUthmaniBody": "لِّلطَّٰغِينَ مَـَٔابًا"
    },
    {
      "ayah": 23,
      "textUthmaniBody": "لَّٰبِثِينَ فِيهَآ أَحْقَابًا"
    },
    {
      "ayah": 24,
      "textUthmaniBody": "لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا"
    },
    {
      "ayah": 25,
      "textUthmaniBody": "إِلَّا حَمِيمًا وَغَسَّاقًا"
    },
    {
      "ayah": 26,
      "textUthmaniBody": "جَزَآءً وِفَاقًا"
    },
    {
      "ayah": 27,
      "textUthmaniBody": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا"
    },
    {
      "ayah": 28,
      "textUthmaniBody": "وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًا"
    },
    {
      "ayah": 29,
      "textUthmaniBody": "وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًا"
    },
    {
      "ayah": 30,
      "textUthmaniBody": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا"
    },
    {
      "ayah": 31,
      "textUthmaniBody": "إِنَّ لِلْمُتَّقِينَ مَفَازًا"
    },
    {
      "ayah": 32,
      "textUthmaniBody": "حَدَآئِقَ وَأَعْنَٰبًا"
    },
    {
      "ayah": 33,
      "textUthmaniBody": "وَكَوَاعِبَ أَتْرَابًا"
    },
    {
      "ayah": 34,
      "textUthmaniBody": "وَكَأْسًا دِهَاقًا"
    },
    {
      "ayah": 35,
      "textUthmaniBody": "لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا"
    },
    {
      "ayah": 36,
      "textUthmaniBody": "جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا"
    },
    {
      "ayah": 37,
      "textUthmaniBody": "رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ لَا يَمْلِكُونَ مِنْهُ خِطَابًا"
    },
    {
      "ayah": 38,
      "textUthmaniBody": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّا لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًا"
    },
    {
      "ayah": 39,
      "textUthmaniBody": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا"
    },
    {
      "ayah": 40,
      "textUthmaniBody": "إِنَّآ أَنذَرْنَٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا"
    }
  ]
}
