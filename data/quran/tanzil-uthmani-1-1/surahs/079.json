{
  "surah": 79,
  "nameAr": "النازعات",
  "nameEn": "An-Naazi'aat",
  "ayahCount": 46,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "وَٱلنَّٰزِعَٰتِ غَرْقًا"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "وَٱلنَّٰشِطَٰتِ نَشْطًا"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "وَٱلسَّٰبِحَٰتِ سَبْحًا"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "فَٱلسَّٰبِقَٰتِ سَبْقًا"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "فَٱلْمُدَبِّرَٰتِ أَمْرًا"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "تَتْبَعُهَا ٱلرَّادِفَةُ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "أَبْصَٰرُهَا خَٰشِعَةٌ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "أَءِذَا كُنَّا عِظَٰمًا نَّخِرَةً"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "فَإِذَا هُم بِٱلسَّاهِرَةِ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ"
    },
    {
      "ayah": 20,
      "textUthmaniBody": "فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ"
    },
    {
      "ayah": 21,
      "textUthmaniBody": "فَكَذَّبَ وَعَصَىٰ"
    },
    {
      "ayah": 22,
      "textUthmaniBody": "ثُمَّ أَدْبَرَ يَسْعَىٰ"
    },
    {
      "ayah": 23,
      "textUthmaniBody": "فَحَشَرَ فَنَادَىٰ"
    },
    {
      "ayah": 24,
      "textUthmaniBody": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ"
    },
    {
      "ayah": 25,
      "textUthmaniBody": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ"
    },
    {
      "ayah": 26,
      "textUthmaniBody": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ"
    },
    {
      "ayah": 27,
      "textUthmaniBody": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ بَنَىٰهَا"
    },
    {
      "ayah": 28,
      "textUthmaniBody": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا"
    },
    {
      "ayah": 29,
      "textUthmaniBody": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا"
    },
    {
      "ayah": 30,
      "textUthmaniBody": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ"
    },
    {
      "ayah": 31,
      "textUthmaniBody": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا"
    },
    {
      "ayah": 32,
      "textUthmaniBody": "وَٱلْجِبَالَ أَرْسَىٰهَا"
    },
    {
      "ayah": 33,
      "textUthmaniBody": "مَتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ"
    },
    {
      "ayah": 34,
      "textUthmaniBody": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ"
    },
    {
      "ayah": 35,
      "textUthmaniBody": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ"
    },
    {
      "ayah": 36,
      "textUthmaniBody": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ"
    },
    {
      "ayah": 37,
      "textUthmaniBody": "فَأَمَّا مَن طَغَىٰ"
    },
    {
      "ayah": 38,
      "textUthmaniBody": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"
    },
    {
      "ayah": 39,
      "textUthmaniBody": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ"
    },
    {
      "ayah": 40,
      "textUthmaniBody": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ"
    },
    {
      "ayah": 41,
      "textUthmaniBody": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ"
    },
    {
      "ayah": 42,
      "textUthmaniBody": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا"
    },
    {
      "ayah": 43,
      "textUthmaniBody": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ"
    },
    {
      "ayah": 44,
      "textUthmaniBody": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ"
    },
    {
      "ayah": 45,
      "textUthmaniBody": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا"
    },
    {
      "ayah": 46,
      "textUthmaniBody": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا"
    }
  ]
}
