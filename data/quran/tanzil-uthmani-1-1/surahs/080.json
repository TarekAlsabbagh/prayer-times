{
  "surah": 80,
  "nameAr": "عبس",
  "nameEn": "Abasa",
  "ayahCount": 42,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "عَبَسَ وَتَوَلَّىٰٓ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "أَن جَآءَهُ ٱلْأَعْمَىٰ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "أَمَّا مَنِ ٱسْتَغْنَىٰ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "فَأَنتَ لَهُۥ تَصَدَّىٰ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "وَهُوَ يَخْشَىٰ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "فَأَنتَ عَنْهُ تَلَهَّىٰ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "كَلَّآ إِنَّهَا تَذْكِرَةٌ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "فَمَن شَآءَ ذَكَرَهُۥ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "فِى صُحُفٍ مُّكَرَّمَةٍ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "بِأَيْدِى سَفَرَةٍ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "كِرَامٍۭ بَرَرَةٍ"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"
    },
    {
      "ayah": 20,
      "textUthmaniBody": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ"
    },
    {
      "ayah": 21,
      "textUthmaniBody": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ"
    },
    {
      "ayah": 22,
      "textUthmaniBody": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ"
    },
    {
      "ayah": 23,
      "textUthmaniBody": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ"
    },
    {
      "ayah": 24,
      "textUthmaniBody": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ"
    },
    {
      "ayah": 25,
      "textUthmaniBody": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا"
    },
    {
      "ayah": 26,
      "textUthmaniBody": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا"
    },
    {
      "ayah": 27,
      "textUthmaniBody": "فَأَنۢبَتْنَا فِيهَا حَبًّا"
    },
    {
      "ayah": 28,
      "textUthmaniBody": "وَعِنَبًا وَقَضْبًا"
    },
    {
      "ayah": 29,
      "textUthmaniBody": "وَزَيْتُونًا وَنَخْلًا"
    },
    {
      "ayah": 30,
      "textUthmaniBody": "وَحَدَآئِقَ غُلْبًا"
    },
    {
      "ayah": 31,
      "textUthmaniBody": "وَفَٰكِهَةً وَأَبًّا"
    },
    {
      "ayah": 32,
      "textUthmaniBody": "مَّتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ"
    },
    {
      "ayah": 33,
      "textUthmaniBody": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ"
    },
    {
      "ayah": 34,
      "textUthmaniBody": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ"
    },
    {
      "ayah": 35,
      "textUthmaniBody": "وَأُمِّهِۦ وَأَبِيهِ"
    },
    {
      "ayah": 36,
      "textUthmaniBody": "وَصَٰحِبَتِهِۦ وَبَنِيهِ"
    },
    {
      "ayah": 37,
      "textUthmaniBody": "لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ"
    },
    {
      "ayah": 38,
      "textUthmaniBody": "وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ"
    },
    {
      "ayah": 39,
      "textUthmaniBody": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ"
    },
    {
      "ayah": 40,
      "textUthmaniBody": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ"
    },
    {
      "ayah": 41,
      "textUthmaniBody": "تَرْهَقُهَا قَتَرَةٌ"
    },
    {
      "ayah": 42,
      "textUthmaniBody": "أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ"
    }
  ]
}
