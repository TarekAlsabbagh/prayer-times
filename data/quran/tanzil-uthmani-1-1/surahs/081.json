  "surah": 81,
  "nameAr": "Ø§ÙØªÙÙÙØ±",
  "nameEn": "At-Takwir",
  "ayahCount": 29,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "إِذَا ٱلشَّمْسُ كُوِّرَتْ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "بِأَىِّ ذَنۢبٍ قُتِلَتْ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "ٱلْجَوَارِ ٱلْكُنَّسِ"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "وَٱلَّيْلِ إِذَا عَسْعَسَ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ"
    },
    {
      "ayah": 20,
      "textUthmaniBody": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ"
    },
    {
      "ayah": 21,
      "textUthmaniBody": "مُّطَاعٍ ثَمَّ أَمِينٍ"
    },
    {
      "ayah": 22,
      "textUthmaniBody": "وَمَا صَاحِبُكُم بِمَجْنُونٍ"
    },
    {
      "ayah": 23,
      "textUthmaniBody": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ"
    },
    {
      "ayah": 24,
      "textUthmaniBody": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ"
    },
    {
      "ayah": 25,
      "textUthmaniBody": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍ رَّجِيمٍ"
    },
    {
      "ayah": 26,
      "textUthmaniBody": "فَأَيْنَ تَذْهَبُونَ"
    },
    {
      "ayah": 27,
      "textUthmaniBody": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَٰلَمِينَ"
    },
    {
      "ayah": 28,
      "textUthmaniBody": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ"
    },
    {
      "ayah": 29,
      "textUthmaniBody": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ"
    }
  ]
}
