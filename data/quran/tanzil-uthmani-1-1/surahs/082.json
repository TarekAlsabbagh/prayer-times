  "nameAr": "Ø§ÙØ¥ÙÙØ·Ø§Ø±",
  "nameEn": "Al-Infitaar",
  "ayahCount": 19,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "كِرَامًا كَٰتِبِينَ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "يَعْلَمُونَ مَا تَفْعَلُونَ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ"
    }
  ]
}
