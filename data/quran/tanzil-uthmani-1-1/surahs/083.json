{
  "surah": 83,
  "nameAr": "Ø§ÙÙØ·ÙÙÙÙ",
  "nameEn": "Al-Mutaffifin",
  "ayahCount": 36,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "وَيْلٌ لِّلْمُطَفِّفِينَ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "لِيَوْمٍ عَظِيمٍ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "وَمَآ أَدْرَىٰكَ مَا سِجِّينٌ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "كِتَٰبٌ مَّرْقُومٌ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "كَلَّا بَلْ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍ لَّمَحْجُوبُونَ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ"
    },
    {
      "ayah": 20,
      "textUthmaniBody": "كِتَٰبٌ مَّرْقُومٌ"
    },
    {
      "ayah": 21,
      "textUthmaniBody": "يَشْهَدُهُ ٱلْمُقَرَّبُونَ"
    },
    {
      "ayah": 22,
      "textUthmaniBody": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ"
    },
    {
      "ayah": 23,
      "textUthmaniBody": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ"
    },
    {
      "ayah": 24,
      "textUthmaniBody": "تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ"
    },
    {
      "ayah": 25,
      "textUthmaniBody": "يُسْقَوْنَ مِن رَّحِيقٍ مَّخْتُومٍ"
    },
    {
      "ayah": 26,
      "textUthmaniBody": "خِتَٰمُهُۥ مِسْكٌ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ"
    },
    {
      "ayah": 27,
      "textUthmaniBody": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ"
    },
    {
      "ayah": 28,
      "textUthmaniBody": "عَيْنًا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ"
    },
    {
      "ayah": 29,
      "textUthmaniBody": "إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ"
    },
    {
      "ayah": 30,
      "textUthmaniBody": "وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ"
    },
    {
      "ayah": 31,
      "textUthmaniBody": "وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ"
    },
    {
      "ayah": 32,
      "textUthmaniBody": "وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ"
    },
    {
      "ayah": 33,
      "textUthmaniBody": "وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَٰفِظِينَ"
    },
    {
      "ayah": 34,
      "textUthmaniBody": "فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ"
    },
    {
      "ayah": 35,
      "textUthmaniBody": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ"
    },
    {
      "ayah": 36,
      "textUthmaniBody": "هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ"
    }
  ]
}
