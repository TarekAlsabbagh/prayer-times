  "nameAr": "Ø§ÙØ¨Ø±ÙØ¬",
  "nameEn": "Al-Burooj",
  "ayahCount": 22,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "وَٱلْيَوْمِ ٱلْمَوْعُودِ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "وَشَاهِدٍ وَمَشْهُودٍ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "إِذْ هُمْ عَلَيْهَا قُعُودٌ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "فَعَّالٌ لِّمَا يُرِيدُ"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "فِرْعَوْنَ وَثَمُودَ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍ"
    },
    {
      "ayah": 20,
      "textUthmaniBody": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ"
    },
    {
      "ayah": 21,
      "textUthmaniBody": "بَلْ هُوَ قُرْءَانٌ مَّجِيدٌ"
    },
    {
      "ayah": 22,
      "textUthmaniBody": "فِى لَوْحٍ مَّحْفُوظٍۭ"
    }
  ]
}
