{
  "surah": 86,
  "nameAr": "الطارق",
  "nameEn": "At-Taariq",
  "ayahCount": 17,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "وَٱلسَّمَآءِ وَٱلطَّارِقِ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "ٱلنَّجْمُ ٱلثَّاقِبُ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "خُلِقَ مِن مَّآءٍ دَافِقٍ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "إِنَّهُۥ لَقَوْلٌ فَصْلٌ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "وَمَا هُوَ بِٱلْهَزْلِ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "إِنَّهُمْ يَكِيدُونَ كَيْدًا"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "وَأَكِيدُ كَيْدًا"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا"
    }
  ]
}
