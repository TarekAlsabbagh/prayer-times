  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "ٱلَّذِى خَلَقَ فَسَوَّىٰ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "إِلَّا مَا شَآءَ ٱللَّهُ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "سَيَذَّكَّرُ مَن يَخْشَىٰ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ"
    }
  ]
}
