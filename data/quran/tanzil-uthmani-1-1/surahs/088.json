{
  "surah": 88,
  "nameAr": "الغاشية",
  "nameEn": "Al-Ghaashiya",
  "ayahCount": 26,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "وُجُوهٌ يَوْمَئِذٍ خَٰشِعَةٌ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "عَامِلَةٌ نَّاصِبَةٌ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "تَصْلَىٰ نَارًا حَامِيَةً"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "لِّسَعْيِهَا رَاضِيَةٌ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "فِى جَنَّةٍ عَالِيَةٍ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةً"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "فِيهَا عَيْنٌ جَارِيَةٌ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "وَأَكْوَابٌ مَّوْضُوعَةٌ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "وَنَمَارِقُ مَصْفُوفَةٌ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "وَزَرَابِىُّ مَبْثُوثَةٌ"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ"
    },
    {
      "ayah": 20,
      "textUthmaniBody": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ"
    },
    {
      "ayah": 21,
      "textUthmaniBody": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ"
    },
    {
      "ayah": 22,
      "textUthmaniBody": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ"
    },
    {
      "ayah": 23,
      "textUthmaniBody": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ"
    },
    {
      "ayah": 24,
      "textUthmaniBody": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ"
    },
    {
      "ayah": 25,
      "textUthmaniBody": "إِنَّ إِلَيْنَآ إِيَابَهُمْ"
    },
    {
      "ayah": 26,
      "textUthmaniBody": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم"
    }
  ]
}
