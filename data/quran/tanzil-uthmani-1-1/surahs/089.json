  "surah": 89,
  "nameAr": "Ø§ÙÙØ¬Ø±",
  "nameEn": "Al-Fajr",
  "ayahCount": 30,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "وَٱلْفَجْرِ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "وَلَيَالٍ عَشْرٍ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "وَٱلشَّفْعِ وَٱلْوَتْرِ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "وَٱلَّيْلِ إِذَا يَسْرِ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "إِرَمَ ذَاتِ ٱلْعِمَادِ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "كَلَّا بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا"
    },
    {
      "ayah": 20,
      "textUthmaniBody": "وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا"
    },
    {
      "ayah": 21,
      "textUthmaniBody": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا"
    },
    {
      "ayah": 22,
      "textUthmaniBody": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا"
    },
    {
      "ayah": 23,
      "textUthmaniBody": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ"
    },
    {
      "ayah": 24,
      "textUthmaniBody": "يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى"
    },
    {
      "ayah": 25,
      "textUthmaniBody": "فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ"
    },
    {
      "ayah": 26,
      "textUthmaniBody": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ"
    },
    {
      "ayah": 27,
      "textUthmaniBody": "يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ"
    },
    {
      "ayah": 28,
      "textUthmaniBody": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً"
    },
    {
      "ayah": 29,
      "textUthmaniBody": "فَٱدْخُلِى فِى عِبَٰدِى"
    },
    {
      "ayah": 30,
      "textUthmaniBody": "وَٱدْخُلِى جَنَّتِى"
    }
  ]
}
