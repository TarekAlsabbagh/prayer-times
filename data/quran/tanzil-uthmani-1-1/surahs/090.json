{
  "surah": 90,
  "nameAr": "البلد",
  "nameEn": "Al-Balad",
  "ayahCount": 20,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "وَوَالِدٍ وَمَا وَلَدَ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "وَلِسَانًا وَشَفَتَيْنِ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "فَكُّ رَقَبَةٍ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "أَوْ إِطْعَٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "يَتِيمًا ذَا مَقْرَبَةٍ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ"
    },
    {
      "ayah": 20,
      "textUthmaniBody": "عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ"
    }
  ]
}
