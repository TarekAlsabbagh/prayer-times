{
  "surah": 91,
  "nameAr": "الشمس",
  "nameEn": "Ash-Shams",
  "ayahCount": 15,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "وَٱلشَّمْسِ وَضُحَىٰهَا"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "وَنَفْسٍ وَمَا سَوَّىٰهَا"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "وَقَدْ خَابَ مَن دَسَّىٰهَا"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "وَلَا يَخَافُ عُقْبَٰهَا"
    }
  ]
}
