{
  "surah": 92,
  "nameAr": "Ø§ÙÙÙÙ",
  "nameEn": "Al-Lail",
  "ayahCount": 21,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "وَٱلَّيْلِ إِذَا يَغْشَىٰ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "وَصَدَّقَ بِٱلْحُسْنَىٰ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "وَكَذَّبَ بِٱلْحُسْنَىٰ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "إِنَّ عَلَيْنَا لَلْهُدَىٰ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ"
    },
    {
      "ayah": 20,
      "textUthmaniBody": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ"
    },
    {
      "ayah": 21,
      "textUthmaniBody": "وَلَسَوْفَ يَرْضَىٰ"
    }
  ]
}
