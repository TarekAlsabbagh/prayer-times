{
  "surah": 93,
  "nameAr": "الضحى",
  "nameEn": "Ad-Dhuhaa",
  "ayahCount": 11,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "وَٱلضُّحَىٰ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "وَٱلَّيْلِ إِذَا سَجَىٰ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "وَوَجَدَكَ ضَآلًّا فَهَدَىٰ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"
    }
  ]
}
