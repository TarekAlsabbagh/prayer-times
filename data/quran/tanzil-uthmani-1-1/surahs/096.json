{
  "surah": 96,
  "nameAr": "العلق",
  "nameEn": "Al-Alaq",
  "ayahCount": 19,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ"
    },
    {
      "ayah": 10,
      "textUthmaniBody": "عَبْدًا إِذَا صَلَّىٰٓ"
    },
    {
      "ayah": 11,
      "textUthmaniBody": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ"
    },
    {
      "ayah": 12,
      "textUthmaniBody": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ"
    },
    {
      "ayah": 13,
      "textUthmaniBody": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ"
    },
    {
      "ayah": 14,
      "textUthmaniBody": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ"
    },
    {
      "ayah": 15,
      "textUthmaniBody": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ"
    },
    {
      "ayah": 16,
      "textUthmaniBody": "نَاصِيَةٍ كَٰذِبَةٍ خَاطِئَةٍ"
    },
    {
      "ayah": 17,
      "textUthmaniBody": "فَلْيَدْعُ نَادِيَهُۥ"
    },
    {
      "ayah": 18,
      "textUthmaniBody": "سَنَدْعُ ٱلزَّبَانِيَةَ"
    },
    {
      "ayah": 19,
      "textUthmaniBody": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب"
    }
  ]
}
