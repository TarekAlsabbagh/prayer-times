  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةِ ٱلْقَدْرِ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "لَيْلَةُ ٱلْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "تَنَزَّلُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "سَلَٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ"
    }
  ]
