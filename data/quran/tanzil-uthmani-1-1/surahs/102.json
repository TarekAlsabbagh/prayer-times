  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "أَلْهَىٰكُمُ ٱلتَّكَاثُرُ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "كَلَّا سَوْفَ تَعْلَمُونَ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "لَتَرَوُنَّ ٱلْجَحِيمَ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ"
    }
  ]
