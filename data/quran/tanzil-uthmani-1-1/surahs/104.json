{
  "surah": 104,
  "nameAr": "الهمزة",
  "nameEn": "Al-Humaza",
  "ayahCount": 9,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "كَلَّا لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ"
    },
    {
      "ayah": 8,
      "textUthmaniBody": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ"
    },
    {
      "ayah": 9,
      "textUthmaniBody": "فِى عَمَدٍ مُّمَدَّدَةٍۭ"
    }
  ]
}
