  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "لِإِيلَٰفِ قُرَيْشٍ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ"
    }
  ]
