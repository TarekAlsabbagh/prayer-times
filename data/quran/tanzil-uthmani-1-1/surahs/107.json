{
  "surah": 107,
  "nameAr": "الماعون",
  "nameEn": "Al-Maa'un",
  "ayahCount": 7,
  "basmalaMode": "separate",
  "juz": [
    30
  ],
  "source": "Tanzil Uthmani 1.1",
  "ayahs": [
    {
      "ayah": 1,
      "textUthmaniBody": "أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ"
    },
    {
      "ayah": 2,
      "textUthmaniBody": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ"
    },
    {
      "ayah": 3,
      "textUthmaniBody": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ"
    },
    {
      "ayah": 4,
      "textUthmaniBody": "فَوَيْلٌ لِّلْمُصَلِّينَ"
    },
    {
      "ayah": 5,
      "textUthmaniBody": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ"
    },
    {
      "ayah": 6,
      "textUthmaniBody": "ٱلَّذِينَ هُمْ يُرَآءُونَ"
    },
    {
      "ayah": 7,
      "textUthmaniBody": "وَيَمْنَعُونَ ٱلْمَاعُونَ"
    }
  ]
}
