// ─── Slugs we MUST NOT include ───────────────────────────────────────────
// 1. Duplicates of existing curated entries (handled via alias enrichment)
// 2. needs_review entries (deferred to ASIA-1D-BD-MISSING-AR-MAJORS-* waves)
const DROP_SLUGS = new Set([
    'barishal',     // pop=202k PPLA — DUPLICATE of curated `barisal` (1.76km away)
                    //                 → enrich `barisal` aliases instead (separate phase)
    'chandpur',     // pop=203k PPLA2 — in needs_review (missing real AR);
                    //                  defer to ASIA-1D-BD-MISSING-AR-MAJORS-1A
    'magura',       // pop=0 PPLA2 — needs_review; defer
    'jessore',      // pop=244k PPL — needs_review (Jashore 2018 rename); defer
    'cox-s-bazar', 'coxs-bazar',  // pop=254k PPL — needs_review; defer
]);

// ─── Anomaly overrides (Stage 3 false-rejections + low-tier promotions) ─
// Each maps to the fix above; documented here for visibility.
const ANOMALY_NOTES = {
    'rangpur':    'Stage 3 rejected via religious-keyword "/\\bmosque\\b/i" matching alias "Mosque Rangpur". This is a substring leak. Permanent fix: add PPLC/PPLA exemption to religious blocklist in validate_candidates.mjs (RECOMMENDED), or use this script-level override.',
    'nilphamari': 'Stage 3 tier=low because pop=0 + PPLA2 not in alwaysIncludeFeatureCodes. PPLA2 is district admin center — promote.',
    'gaibandha':  'Same as nilphamari.',
};

// ─── Validators ────────────────────────────────────────────────────────────
function preflight() {
    const errors = [];
    const seenSlugs = new Set();
    const seenAr = new Map();
    for (const f of FIXES) {
        if (DROP_SLUGS.has(f.slug)) errors.push('FIXES targets DROP_SLUG: ' + f.slug);
        if (seenSlugs.has(f.slug))  errors.push('Duplicate slug: ' + f.slug);
        seenSlugs.add(f.slug);

        if (!isCleanArabic(f.newAr)) {
            errors.push(f.slug + ' → newAr="' + f.newAr + '" failed clean-Arabic check');
        }
        if (seenAr.has(f.newAr)) {
            errors.push('DUP-AR: "' + f.newAr + '" used by ' + seenAr.get(f.newAr) + ' AND ' + f.slug);
        }
        seenAr.set(f.newAr, f.slug);

        // Cross-check against existing 6 BD curated Arabic names
        const curated = JSON.parse(fs.readFileSync(
            'C:/Users/Tarek/Downloads/TIME PRAYER/db/places/curated-places.json', 'utf8'));
        const existingArSet = new Set(
            curated.filter(x => x.countryCode === 'bd')
                   .map(e => e && e.names && e.names.ar).filter(Boolean));
        if (existingArSet.has(f.newAr)) {
            errors.push(f.slug + ' → "' + f.newAr + '" collides with existing BD curated entry');
        }
    }
    return errors;
}

// ─── Main (DRAFT — not executable until user approval) ───────────────────
function main() {
    const errors = preflight();
    if (errors.length) {
        console.error('[bd-a DRAFT] pre-flight FAILED — must resolve before execution:');
        for (const e of errors) console.error('  - ' + e);
        process.exit(1);
    }
    console.log('[bd-a DRAFT] pre-flight OK — ' + FIXES.length + ' fixes validated');
    console.log('[bd-a DRAFT] DROP_SLUGS:', [...DROP_SLUGS].join(', '));
    console.log('[bd-a DRAFT] Anomaly overrides:', Object.keys(ANOMALY_NOTES).length);
    console.log('');
    console.log('═══ DRAFT script — STOPPED before mutating candidates ═══');
    console.log('Per ASIA-1D-BD-A-PLAN spec (2026-05-19):');
    console.log('  - No candidate mutation');
    console.log('  - No Stage 4 merge (apply_curated_candidates.mjs bd not invoked)');
    console.log('  - No curated-places.json change');
    console.log('  - This file ends in .DRAFT — rename to drop suffix when approved');
    process.exit(0);
}

main();
