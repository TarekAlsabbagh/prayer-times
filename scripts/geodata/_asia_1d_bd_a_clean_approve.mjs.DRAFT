      note: 'pop=1.03M PPL Chittagong Div; AR Wikipedia kūmīlā; Cumilla 2018 rename → alias' },

    { slug: 'bagerhat',    newAr: 'باغرهات',       source: 'PROMOTE',
      addAliasesEn: [], keepAliasesAr: ['باغر هات'],
      note: 'pop=266k PPLA2 Khulna Div; promote from aliases.ar[2]' },

    { slug: 'mymensingh',  newAr: 'ميمنسينغ',      source: 'PROMOTE',
      addAliasesEn: [],
      note: 'pop=225k PPLA Mymensingh Div (admin1=H); promote from aliases.ar[1]' },

    { slug: 'bogra',       newAr: 'بوغرا',         source: 'MANUAL',
      addAliasesEn: ['Bogura'],   // 2018 official rename
      note: 'pop=210k PPL Rajshahi Div; standard AR (Persian گ→Arabic غ); Bogura 2018 rename' },

    { slug: 'jamalpur',    newAr: 'جمالبور',       source: 'KEEP',
      addAliasesEn: [],
      note: 'pop=168k PPLA2 Mymensingh Div; primary already clean Arabic' },

    { slug: 'habiganj',    newAr: 'حبيغنج',        source: 'PROMOTE',
      addAliasesEn: [],
      note: 'pop=89k PPL Sylhet Div; promote from aliases.ar[0] (Bengali গ→غ)' },

    { slug: 'feni',        newAr: 'فيني',          source: 'PROMOTE',
      addAliasesEn: [],
      note: 'pop=84k PPL Chittagong Div; promote from aliases.ar[0]' },

    { slug: 'netrakona',   newAr: 'نيتراكونا',     source: 'MANUAL',
      addAliasesEn: [],
      note: 'pop=79k PPLA2 Mymensingh Div; standard AR (replace Persian ک/ی)' },

    { slug: 'lalmonirhat', newAr: 'لالمونيرهات',   source: 'PROMOTE',
      addAliasesEn: [], keepAliasesAr: ['لال منير هات'],
      note: 'pop=65k PPLA2 Rangpur Div; promote from aliases.ar[2]; keep spaced variant' },

    // ────── 3 anomaly-resolved cities ──────
    { slug: 'rangpur',     newAr: 'رنغبور',        source: 'MANUAL',
      addAliasesEn: [], keepAliasesAr: ['رانجبور'],
